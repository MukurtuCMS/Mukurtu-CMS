<?php
/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_export update hook was removed in 4.0.1. 40027 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_export_update_last_removed(): int {
  return 40027;
}

/**
 * Add missing columns to the default CSV export settings.
 */
function mukurtu_export_update_40401(): ?string {
  // Keep the docblock above to one line: Drupal renders it verbatim as this
  // update's description on update.php and in `drush updatedb:status`.
  //
  // The four shipped presets had drifted apart: some bundles lacked a column
  // that the same bundle had in the other presets, or that every sibling
  // bundle had. 4.0.4 ships the columns in config/install, which fixes new
  // sites. This adds them to the presets an existing site already has.
  //
  // Only the shipped presets are touched, by id, and only bundles they
  // already list. A column is appended rather than slotted into position, so
  // an admin's column order is left alone, and a column that is already
  // there (under any label) is left alone too.
  $missing = [
    'default_local_metadata_only' => [
      'node__dictionary_word' => ['default_langcode' => 'Default translation'],
      'media__external_embed' => ['field_found_in' => 'Found In'],
      'media__image' => ['default_langcode' => 'Default translation'],
      'media__soundcloud' => ['default_langcode' => 'Default translation'],
    ],
    'default_local_with_media' => [
      'node__dictionary_word' => ['default_langcode' => 'Default translation'],
      'media__image' => ['default_langcode' => 'Default translation'],
      'media__soundcloud' => ['default_langcode' => 'Default translation'],
    ],
    'default_external_metadata_only' => [
      'node__article' => ['field_multipage_page_of' => 'Multipage parent'],
      'node__dictionary_word' => ['default_langcode' => 'Default translation'],
      'media__image' => ['default_langcode' => 'Default translation'],
      'media__soundcloud' => ['default_langcode' => 'Default translation'],
    ],
    'default_external_with_media' => [
      'node__dictionary_word' => ['default_langcode' => 'Default translation'],
      'media__image' => ['default_langcode' => 'Default translation'],
      'media__soundcloud' => ['default_langcode' => 'Default translation'],
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('csv_exporter');
  $updated = 0;

  foreach ($missing as $id => $bundles) {
    /** @var \Drupal\mukurtu_export\Entity\CsvExporter|null $exporter */
    $exporter = $storage->load($id);
    if (!$exporter) {
      // The preset was deleted, or never existed on this site.
      continue;
    }

    $map = $exporter->get('entity_fields_export_list') ?? [];
    $changed = FALSE;
    foreach ($bundles as $bundle => $columns) {
      if (!isset($map[$bundle])) {
        // The site removed this bundle from the preset; don't bring it back.
        continue;
      }
      foreach ($columns as $field_name => $label) {
        if (!array_key_exists($field_name, $map[$bundle])) {
          $map[$bundle][$field_name] = $label;
          $changed = TRUE;
        }
      }
    }

    if ($changed) {
      $exporter->set('entity_fields_export_list', $map);
      $exporter->save();
      $updated++;
    }
  }

  if (!$updated) {
    return NULL;
  }

  return (string) t('Added missing columns to @count default CSV export setting(s).', [
    '@count' => $updated,
  ]);
}

/**
 * Add the Language code column to the default CSV export settings.
 */
function mukurtu_export_update_40402(): ?string {
  // Keep the docblock above to one line: Drupal renders it verbatim as this
  // update's description on update.php and in `drush updatedb:status`.
  //
  // mukurtu_core_update_40211() adds field_language_code to the language
  // vocabulary (#2328). config/install ships the column, which fixes new
  // sites. As in mukurtu_export_update_40401(), only the shipped presets are
  // touched, only when they still list language terms, and the column is
  // appended so an admin's column order is left alone.
  $ids = [
    'default_local_metadata_only',
    'default_local_with_media',
    'default_external_metadata_only',
    'default_external_with_media',
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('csv_exporter');
  $updated = 0;

  foreach ($storage->loadMultiple($ids) as $exporter) {
    $map = $exporter->get('entity_fields_export_list') ?? [];
    if (!isset($map['taxonomy_term__language']) || array_key_exists('field_language_code', $map['taxonomy_term__language'])) {
      continue;
    }
    $map['taxonomy_term__language']['field_language_code'] = 'Language code';
    $exporter->set('entity_fields_export_list', $map);
    $exporter->save();
    $updated++;
  }

  if (!$updated) {
    return NULL;
  }

  return (string) t('Added the Language code column to @count default CSV export setting(s).', [
    '@count' => $updated,
  ]);
}
