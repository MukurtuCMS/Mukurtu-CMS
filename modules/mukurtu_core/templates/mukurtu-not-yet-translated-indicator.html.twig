{#
/**
 * @file
 * Default theme implementation for the "not yet translated" indicator.
 *
 * Shown when the current content language has no translation for the
 * entity being rendered, so its default-language version is shown instead.
 *
 * Available variables:
 * - language_name: The human-readable name of the language actually being
 *   shown (the entity's own language, not the visitor's active one).
 * - langcode: The interface language the indicator's own text is in.
 * - direction: That language's text direction, 'ltr' or 'rtl'.
 */
#}
<span class="translation-status-badge translation-status-badge--not-translated"{% if langcode %} lang="{{ langcode }}" dir="{{ direction }}"{% endif %}>
  <svg class="translation-status-badge__icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
  {{ 'Not yet translated (@language)'|t({'@language': language_name}) }}
</span>
