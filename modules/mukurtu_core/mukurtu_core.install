<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_core module.
 */

use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\mukurtu_core\Hook\UpdatePathRequirements;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function mukurtu_core_install() {
  // Create the content type field on all pre-existing node types.
  FieldStorageConfig::create([
    'field_name' => 'field_content_type',
    'entity_type' => 'node',
    'type' => 'string',
    'cardinality' => 1,
    'translatable' => FALSE,
  ])->save();

  foreach (node_type_get_names() as $bundle => $label) {
    mukurtu_core_create_content_type_field('node', $bundle);
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_core update hook was removed in 4.0.1. 40123 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_core_update_last_removed(): int {
  return 40123;
}

/**
 * Implements hook_update_requirements().
 *
 * Warns a site that never finished the 4.0.0 updates that it cannot go straight
 * to 4.0.1, because the updates it still needs no longer exist to run.
 *
 * Core already detects this on its own.
 * SystemRequirementsHooks::checkRequirements() compares every module's
 * installed schema version against its hook_update_last_removed() and reports
 * an error per module that is behind. What this adds is a single message that
 * names the release to install first, which core's generic "update to an
 * intermediate version first" cannot.
 *
 * Neither this nor core's version actually blocks an automated update. Drush
 * raises a requirements error as a confirmable prompt, so `drush updb -y`
 * prints it and proceeds, exiting 0 with "No pending updates". Only an explicit
 * `--no` aborts. Treat this as a loud warning; the thing that keeps the problem
 * visible afterwards is the runtime check, which core does not do at all. See
 * docs/update-hooks.md for the verified behaviour.
 *
 * Stays procedural rather than moving to the #[Hook] class alongside the
 * runtime check. hook_update_requirements() is not on core's attribute deny
 * list, so an attribute would be legal, but update-phase code runs while the
 * container may not reflect the code on disk, and a .install file is the one
 * place guaranteed to be loaded by the update system itself.
 *
 * @see \Drupal\mukurtu_core\Hook\UpdatePathRequirements
 * @see \Drupal\system\Hook\SystemRequirementsHooks::checkRequirements()
 */
function mukurtu_core_update_requirements(): array {
  $behind = UpdatePathRequirements::modulesBehind(
    \Drupal::moduleHandler(),
    \Drupal::service('update.update_hook_registry'),
  );

  if (empty($behind)) {
    return [];
  }

  return [
    'mukurtu_core_update_path' => [
      'title' => t('Mukurtu update path'),
      'value' => t('Update to Mukurtu 4.0.0 first'),
      'description' => t('This site still has database updates to run from before Mukurtu 4.0.0. Mukurtu 4.0.1 removed those updates, so they can no longer run, and updating directly would leave parts of the site using out-of-date configuration. To update safely: install Mukurtu 4.0.0, run all database updates, then install Mukurtu 4.0.1. Modules waiting on 4.0.0 updates: @modules.', [
        '@modules' => UpdatePathRequirements::formatModuleList($behind),
      ]),
      'severity' => RequirementSeverity::Error,
    ],
  ];
}

/**
 * Revoke the Full HTML text format from logged-in users (#2160).
 */
function mukurtu_core_update_40201(): ?string {
  // Keep the docblock above to one line. Drupal renders it verbatim as this
  // update's description on update.php and in `drush updatedb:status`, so
  // implementation rationale there becomes a wall of text an operator has to
  // read past. It belongs here instead.
  //
  // Full HTML adds object, embed and video tags over Basic HTML, which already
  // permits iframes and media embeds. It is meant to be an editorial format, so
  // mukurtu_core_update_40118() revoked it from the authenticated role in
  // 4.0.0.
  //
  // That hook missed a whole class of site. Its docblock reasoned that "the
  // shipped authenticated role has never granted it", which was true of
  // config/install/user.role.authenticated.yml and untrue of mukurtu_install(),
  // which granted it programmatically. Worse, 40118 could only ever help sites
  // already below 40118 that then updated: mukurtu_core reached 40122 by
  // 4.0.0-beta37, and a fresh install is seeded at the highest available number
  // without running anything, so any site installed from a late beta skipped it
  // and kept the grant.
  //
  // 4.0.1 stopped mukurtu_install() granting it, which fixes new installs. This
  // is the other half: the sites that were already wrong.
  //
  // Revoked unconditionally rather than guarded on some notion of "was this
  // deliberate". There is no signal to guard on: a site that meant to grant
  // Full HTML looks identical to one that got it from the bug, because 4.0.1
  // seeded every site's schema at 40123 and the installed version no longer
  // says anything about which betas were run. For a permission that widens what
  // ordinary logged-in users can put in a page, failing closed and telling the
  // operator how to restore it is the safer default, and is what 4.0.0 did with
  // the devel permissions.
  $role = Role::load('authenticated');
  if (!$role || !$role->hasPermission('use text format full_html')) {
    return NULL;
  }

  $role->revokePermission('use text format full_html');
  $role->save();

  return (string) t('Full HTML was revoked from the authenticated role. Logged-in users now use Basic HTML, which still allows iframes and media embeds. If this site granted Full HTML to all logged-in users deliberately, you can re-grant it on the Permissions page.');
}
