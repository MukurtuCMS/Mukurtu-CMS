<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_core module.
 */

use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\mukurtu_core\Hook\UpdatePathRequirements;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function mukurtu_core_install() {
  // Create the content type field on all pre-existing node types.
  FieldStorageConfig::create([
    'field_name' => 'field_content_type',
    'entity_type' => 'node',
    'type' => 'string',
    'cardinality' => 1,
    'translatable' => FALSE,
  ])->save();

  foreach (node_type_get_names() as $bundle => $label) {
    mukurtu_core_create_content_type_field('node', $bundle);
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_core update hook was removed in 4.0.1. 40123 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_core_update_last_removed(): int {
  return 40123;
}

/**
 * Implements hook_update_requirements().
 *
 * Warns a site that never finished the 4.0.0 updates that it cannot go straight
 * to 4.0.1, because the updates it still needs no longer exist to run.
 *
 * Core already detects this on its own.
 * SystemRequirementsHooks::checkRequirements() compares every module's
 * installed schema version against its hook_update_last_removed() and reports
 * an error per module that is behind. What this adds is a single message that
 * names the release to install first, which core's generic "update to an
 * intermediate version first" cannot.
 *
 * Neither this nor core's version actually blocks an automated update. Drush
 * raises a requirements error as a confirmable prompt, so `drush updb -y`
 * prints it and proceeds, exiting 0 with "No pending updates". Only an explicit
 * `--no` aborts. Treat this as a loud warning; the thing that keeps the problem
 * visible afterwards is the runtime check, which core does not do at all. See
 * docs/update-hooks.md for the verified behaviour.
 *
 * Stays procedural rather than moving to the #[Hook] class alongside the
 * runtime check. hook_update_requirements() is not on core's attribute deny
 * list, so an attribute would be legal, but update-phase code runs while the
 * container may not reflect the code on disk, and a .install file is the one
 * place guaranteed to be loaded by the update system itself.
 *
 * @see \Drupal\mukurtu_core\Hook\UpdatePathRequirements
 * @see \Drupal\system\Hook\SystemRequirementsHooks::checkRequirements()
 */
function mukurtu_core_update_requirements(): array {
  $behind = UpdatePathRequirements::modulesBehind(
    \Drupal::moduleHandler(),
    \Drupal::service('update.update_hook_registry'),
  );

  if (empty($behind)) {
    return [];
  }

  return [
    'mukurtu_core_update_path' => [
      'title' => t('Mukurtu update path'),
      'value' => t('Update to Mukurtu 4.0.0 first'),
      'description' => t('This site still has database updates to run from before Mukurtu 4.0.0. Mukurtu 4.0.1 removed those updates, so they can no longer run, and updating directly would leave parts of the site using out-of-date configuration. To update safely: install Mukurtu 4.0.0, run all database updates, then install Mukurtu 4.0.1. Modules waiting on 4.0.0 updates: @modules.', [
        '@modules' => UpdatePathRequirements::formatModuleList($behind),
      ]),
      'severity' => RequirementSeverity::Error,
    ],
  ];
}

/**
 * Switch the Gin admin theme accent to a WCAG AA compliant teal.
 *
 * Gin's "teal" accent preset renders links at #10857f on white, a 4.48:1
 * contrast ratio - just under the 4.5:1 required by WCAG 2.1 AA (1.4.3).
 * This is member-facing on admin-route pages such as /my-content. Sites
 * still on the default preset are moved to a slightly darker custom teal
 * (#0e7873, 5.3:1); sites with their own accent choice are left alone.
 */
function mukurtu_core_update_40124(): void {
  $settings = \Drupal::configFactory()->getEditable('gin.settings');
  if ($settings->get('preset_accent_color') === 'teal' && empty($settings->get('accent_color'))) {
    $settings
      ->set('preset_accent_color', 'custom')
      ->set('accent_color', '#0e7873')
      ->save();
  }
}

/**
 * Revoke the Full HTML text format from logged-in users (#2160).
 */
function mukurtu_core_update_40201(): ?string {
  // Keep the docblock above to one line. Drupal renders it verbatim as this
  // update's description on update.php and in `drush updatedb:status`, so
  // implementation rationale there becomes a wall of text an operator has to
  // read past. It belongs here instead.
  //
  // Full HTML adds object, embed and video tags over Basic HTML, which already
  // permits iframes and media embeds. It is meant to be an editorial format, so
  // mukurtu_core_update_40118() revoked it from the authenticated role in
  // 4.0.0.
  //
  // That hook missed a whole class of site. Its docblock reasoned that "the
  // shipped authenticated role has never granted it", which was true of
  // config/install/user.role.authenticated.yml and untrue of mukurtu_install(),
  // which granted it programmatically. Worse, 40118 could only ever help sites
  // already below 40118 that then updated: mukurtu_core reached 40122 by
  // 4.0.0-beta37, and a fresh install is seeded at the highest available number
  // without running anything, so any site installed from a late beta skipped it
  // and kept the grant.
  //
  // 4.0.1 stopped mukurtu_install() granting it, which fixes new installs. This
  // is the other half: the sites that were already wrong.
  //
  // Revoked unconditionally rather than guarded on some notion of "was this
  // deliberate". There is no signal to guard on: a site that meant to grant
  // Full HTML looks identical to one that got it from the bug, because 4.0.1
  // seeded every site's schema at 40123 and the installed version no longer
  // says anything about which betas were run. For a permission that widens what
  // ordinary logged-in users can put in a page, failing closed and telling the
  // operator how to restore it is the safer default, and is what 4.0.0 did with
  // the devel permissions.
  $role = Role::load('authenticated');
  if (!$role || !$role->hasPermission('use text format full_html')) {
    return NULL;
  }

  $role->revokePermission('use text format full_html');
  $role->save();

  return (string) t('Full HTML was revoked from the authenticated role. Logged-in users now use Basic HTML, which still allows iframes and media embeds. If this site granted Full HTML to all logged-in users deliberately, you can re-grant it on the Permissions page.');
}

/**
 * Fix the Visitors module's chart report links doing nothing.
 */
function mukurtu_core_update_40202(): ?string {
  // mukurtu_core_update_40088() installed charts, charts_chartjs and
  // visitors_geoip so the Visitors module's chart displays would work, but
  // 4.0.1's blanket update-hook strip deleted it along with every other hook.
  // A site that had already run 40088 is unaffected (ModuleInstaller::install()
  // is a no-op for an already-enabled module), but a site that updated
  // straight through the strip without ever reaching 40088 is left with
  // visitors enabled and no charting backend at all, so its "chart" report
  // links quietly do nothing. This re-does that half of 40088's work.
  //
  // Guarded on visitors itself: a site that deliberately uninstalled it
  // shouldn't have charting infrastructure or a Klaro service re-added on
  // its behalf.
  $module_handler = \Drupal::moduleHandler();
  if (!$module_handler->moduleExists('visitors')) {
    return NULL;
  }

  $messages = [];

  $to_install = array_filter(
    ['charts', 'charts_chartjs', 'visitors_geoip'],
    fn (string $module): bool => !$module_handler->moduleExists($module),
  );

  if ($to_install) {
    \Drupal::service('module_installer')->install($to_install);
    \Drupal::configFactory()->getEditable('charts.settings')
      ->set('charts_default_settings.library', 'chartjs')
      ->save();
    $messages[] = (string) t('Installed: @modules.', ['@modules' => implode(', ', $to_install)]);
  }

  // Separately: Klaro (block_unknown: true) treats charts_chartjs's
  // CDN-loaded Chart.js scripts as an unrecognized third-party resource and
  // rewrites them into inert placeholders via hook_js_alter(). Registering a
  // required klaro_app (config/install/klaro.klaro_app.charts_chartjs.yml)
  // is not enough on its own: hook_js_alter() still substitutes a placeholder
  // for any matched app, required or not, and Klaro's client-side JS never
  // gets a chance to auto-load it, because the Views AJAX response that
  // inserts these scripts (visitors' "chart" report link) never re-triggers
  // Drupal.attachBehaviors() for the new placeholders the way a normal page
  // load would. The klaro_app entity is still created below (useful bookkeeping
  // if Chart.js is ever used somewhere Klaro does process normally), but what
  // actually fixes the report page is klaro.settings:disable_urls, which
  // hook_js_alter() checks before doing any rewriting at all
  // (KlaroHelper::onDisabledUri(), matched against the current request URI -
  // which for this AJAX endpoint is /visitors/_report/..., not
  // /visitors/location, so the pattern has to match on a "/visitors" prefix
  // rather than that one specific page). Guarded on klaro being enabled:
  // getStorage('klaro_app') throws if the entity type doesn't exist, and
  // klaro.settings wouldn't mean anything without the module either.
  if ($module_handler->moduleExists('klaro')) {
    $klaro_app_storage = \Drupal::entityTypeManager()->getStorage('klaro_app');
    if (!$klaro_app_storage->load('charts_chartjs')) {
      $config_path = \Drupal::service('extension.list.profile')->getPath('mukurtu') . '/config/install/klaro.klaro_app.charts_chartjs.yml';
      $values = \Drupal\Core\Serialization\Yaml::decode(file_get_contents($config_path));
      $klaro_app_storage->create($values)->save();
      $messages[] = (string) t('Registered Chart.js as a required Klaro service.');
    }

    $klaro_settings = \Drupal::configFactory()->getEditable('klaro.settings');
    $disable_urls = $klaro_settings->get('disable_urls') ?? [];
    if (!in_array('^\/visitors', $disable_urls, TRUE)) {
      $disable_urls[] = '^\/visitors';
      $klaro_settings->set('disable_urls', $disable_urls)->save();
      $messages[] = (string) t('Stopped Klaro from blocking scripts on Visitors report pages.');
    }
  }

  return $messages ? implode(' ', $messages) : NULL;
}

/**
 * Downloads the DB-IP fallback geolocation database for existing sites.
 */
function mukurtu_core_update_40203(): ?string {
  // GeoIpFallbackHooks also covers this via hook_modules_installed() (a
  // brand new site enabling visitors_geoip for the first time) and
  // hook_cron() (an ongoing monthly refresh). Neither reaches an existing
  // site being updated to this version: visitors_geoip is already
  // installed, so hook_modules_installed() does not fire again for it, and
  // an update run (drush updb -y, or update.php) does not itself trigger
  // cron. This is the update-path equivalent of both -- the same gap
  // mukurtu_core_update_40202() above exists to close for the chart
  // backend, just for the geolocation database instead.
  if (!\Drupal::moduleHandler()->moduleExists('visitors_geoip')) {
    return NULL;
  }

  if (\Drupal::service('mukurtu_core.dbip_download')->download()) {
    return (string) t('Downloaded the DB-IP fallback geolocation database. The Locations report\'s map and Region/City tables now show real visitor locations without needing a MaxMind license key.');
  }

  return (string) t('Could not download the DB-IP fallback geolocation database (see the site log for details). Run `drush mukurtu:geoip:download-dbip` to retry once this environment has outbound internet access; the Locations report continues working without it, just without a populated map.');
}
