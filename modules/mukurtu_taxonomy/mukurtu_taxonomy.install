<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_taxonomy module.
 */

/**
 * Ensure the message_digest cleanup runs before this hook installs a module.
 *
 * Installing flat_taxonomy triggers a module-list rebuild that validates
 * every module still listed in core.extension exists on disk. On sites
 * where mukurtu_notifications_update_40018() (which removes the
 * message_digest/message_digest_ui entries) hasn't run yet, that rebuild
 * fails with "The module message_digest does not exist."
 */
function mukurtu_taxonomy_update_dependencies(): array {
  return [
    'mukurtu_taxonomy' => [
      '40001' => ['mukurtu_notifications' => '40018'],
    ],
  ];
}

/**
 * Enable flat_taxonomy and mark all stock Mukurtu vocabularies as flat.
 */
function mukurtu_taxonomy_update_40001(): void {
  // Ensure the flat_taxonomy module is enabled.
  \Drupal::service('module_installer')->install(['flat_taxonomy']);

  $vids = [
    'category',
    'community_type',
    'contributor',
    'creator',
    'format',
    'interpersonal_relationship',
    'keywords',
    'language',
    'location',
    'media_tag',
    'people',
    'publisher',
    'subject',
    'type',
    'word_type',
  ];

  $vocabulary_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');

  foreach ($vids as $vid) {
    $vocabulary = $vocabulary_storage->load($vid);
    if (!$vocabulary) {
      continue;
    }
    $vocabulary->setThirdPartySetting('flat_taxonomy', 'flat', 1);
    $vocabulary->save();

    // Strip any existing parent relationships on terms in this vocabulary so
    // live data matches the enforced flat structure.
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $tids = $term_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->execute();

    foreach ($term_storage->loadMultiple($tids) as $term) {
      if (!empty($term->parent->target_id)) {
        $term->parent = 0;
        $term->save();
      }
    }
  }
}

/**
 * Mark place_type vocabulary as flat and strip any existing parent relationships.
 *
 * WARNING: No rollback. Parent term IDs are discarded and cannot be recovered
 * from this hook. Back up the taxonomy_term__parent table before running on
 * production if preserving the existing hierarchy matters.
 */
function mukurtu_taxonomy_update_40002(): void {
  $vocabulary_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  $vocabulary = $vocabulary_storage->load('place_type');
  if (!$vocabulary) {
    return;
  }
  $vocabulary->setThirdPartySetting('flat_taxonomy', 'flat', 1);
  $vocabulary->save();

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = $term_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'place_type')
    ->execute();

  foreach ($term_storage->loadMultiple($tids) as $term) {
    if (!empty($term->parent->target_id)) {
      $term->parent = 0;
      $term->save();
    }
  }
}


/**
 * Adds the language-fallback default_langcode filter and rendering_language
 * setting to the taxonomy_term view, per docs/content-language-policy.md.
 * Additive only.
 */
function mukurtu_taxonomy_update_40019(): void {
  $config_taxonomy_term = \Drupal::configFactory()->getEditable('views.view.taxonomy_term');
  if (!$config_taxonomy_term->isNew()) {
    $filters_taxonomy_term_default = $config_taxonomy_term->get('display.default.display_options.filters') ?? [];
    if (!isset($filters_taxonomy_term_default['default_langcode'])) {
      $filters_taxonomy_term_default['default_langcode'] = [
        'id' => 'default_langcode',
        'table' => 'node_field_data',
        'field' => 'default_langcode',
        'relationship' => 'none',
        'group_type' => 'group',
        'admin_label' => '',
        'entity_type' => 'node',
        'entity_field' => 'default_langcode',
        'plugin_id' => 'boolean',
        'operator' => '=',
        'value' => '1',
        'group' => 1,
        'exposed' => FALSE,
        'expose' => [
          'operator_id' => '',
          'label' => '',
          'description' => '',
          'use_operator' => FALSE,
          'operator' => '',
          'operator_limit_selection' => FALSE,
          'operator_list' => [],
          'identifier' => '',
          'required' => FALSE,
          'remember' => FALSE,
          'multiple' => FALSE,
          'remember_roles' => ['authenticated' => 'authenticated'],
        ],
        'is_grouped' => FALSE,
        'group_info' => [
          'label' => '',
          'description' => '',
          'identifier' => '',
          'optional' => TRUE,
          'widget' => 'select',
          'multiple' => FALSE,
          'remember' => FALSE,
          'default_group' => 'All',
          'default_group_multiple' => [],
          'group_items' => [],
        ],
      ];
      $config_taxonomy_term->set('display.default.display_options.filters', $filters_taxonomy_term_default);
      $config_taxonomy_term->save();
    }
    if (!$config_taxonomy_term->get('display.feed_1.display_options.rendering_language')) {
      $config_taxonomy_term->set('display.feed_1.display_options.rendering_language', '***LANGUAGE_language_content***');
      $config_taxonomy_term->save();
    }
    if (!$config_taxonomy_term->get('display.page_1.display_options.rendering_language')) {
      $config_taxonomy_term->set('display.page_1.display_options.rendering_language', '***LANGUAGE_language_content***');
      $config_taxonomy_term->save();
    }
  }
}

/**
 * Adds the language_with_fallback filter to mukurtu_taxonomy_references,
 * per docs/content-language-policy.md. Additive only.
 */
function mukurtu_taxonomy_update_40020(): void {
  $config_mukurtu_taxonomy_references = \Drupal::configFactory()->getEditable('views.view.mukurtu_taxonomy_references');
  if (!$config_mukurtu_taxonomy_references->isNew()) {
    $filters_mukurtu_taxonomy_references = $config_mukurtu_taxonomy_references->get('display.default.display_options.filters') ?? [];
    $changed_mukurtu_taxonomy_references = FALSE;
    if (!isset($filters_mukurtu_taxonomy_references['language_with_fallback'])) {
      $filters_mukurtu_taxonomy_references['language_with_fallback'] = [
        'id' => 'language_with_fallback',
        'table' => 'search_api_index_mukurtu_browse_auto_index',
        'field' => 'language_with_fallback',
        'relationship' => 'none',
        'group_type' => 'group',
        'admin_label' => '',
        'plugin_id' => 'search_api_string',
        'operator' => '=',
        'value' => ['min' => '', 'max' => '', 'value' => '***LANGUAGE_language_content***'],
        'group' => 1,
        'exposed' => FALSE,
        'expose' => [
          'operator_id' => '',
          'label' => '',
          'description' => '',
          'use_operator' => FALSE,
          'operator' => '',
          'operator_limit_selection' => FALSE,
          'operator_list' => [],
          'identifier' => '',
          'required' => FALSE,
          'remember' => FALSE,
          'multiple' => FALSE,
          'remember_roles' => ['authenticated' => 'authenticated'],
          'min_placeholder' => '',
          'max_placeholder' => '',
          'placeholder' => '',
        ],
        'is_grouped' => FALSE,
        'group_info' => [
          'label' => '',
          'description' => '',
          'identifier' => '',
          'optional' => TRUE,
          'widget' => 'select',
          'multiple' => FALSE,
          'remember' => FALSE,
          'default_group' => 'All',
          'default_group_multiple' => [],
          'group_items' => [],
        ],
      ];
      $changed_mukurtu_taxonomy_references = TRUE;
    }
    if ($changed_mukurtu_taxonomy_references) {
      $config_mukurtu_taxonomy_references->set('display.default.display_options.filters', $filters_mukurtu_taxonomy_references);
      $config_mukurtu_taxonomy_references->save();
    }
  }
}

/**
 * Remove the non-functional taxonomy term page facets.
 *
 * The taxonomy term page renders its referenced-content list from core's
 * taxonomy_term (taxonomy_index) view, not from Search API, so these facets
 * loaded but never filtered anything. The controller and template no longer
 * render them; this deletes the orphaned config on existing sites. Covers both
 * the database and Solr variants. Idempotent.
 */
function mukurtu_taxonomy_update_40021(): void {
  $facet_ids = [
    'facets.facet.taxonomy_reference_category',
    'facets.facet.taxonomy_reference_keywords',
    'facets.facet.taxonomy_reference_community',
    'facets.facet.taxonomy_reference_category_solr',
    'facets.facet.taxonomy_reference_keywords_solr',
    'facets.facet.taxonomy_reference_community_solr',
  ];

  $config_factory = \Drupal::configFactory();
  foreach ($facet_ids as $facet_id) {
    $config = $config_factory->getEditable($facet_id);
    if (!$config->isNew()) {
      $config->delete();
    }
  }
}
