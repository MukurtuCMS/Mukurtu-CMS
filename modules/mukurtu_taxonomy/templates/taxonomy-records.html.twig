{% set has_panel = nested_terms or sibling_terms %}
{% if has_panel %}
  {{ attach_library('mukurtu_taxonomy/term-panel') }}
{% endif %}
<div class="taxonomy-term-page">
  <div class="taxonomy-term-layout{{ has_panel ? ' taxonomy-term-layout--panel' }}">
  {# First in the page so it stays above the content on a small screen. #}
  {% if has_panel %}
    <aside class="taxonomy-term-panel" aria-labelledby="taxonomy-term-panel-heading">
      {% if nested_terms %}
        <h2 id="taxonomy-term-panel-heading" class="taxonomy-term-panel__heading">{{ 'Narrower terms'|t }}</h2>
        <ul class="taxonomy-term-panel__list">
          {% for nested_term in nested_terms %}
            <li>{{ link(nested_term.name, nested_term.url) }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if sibling_terms %}
        <h2 id="{{ nested_terms ? 'taxonomy-term-siblings-heading' : 'taxonomy-term-panel-heading' }}" class="taxonomy-term-panel__heading">{{ sibling_terms.heading }}</h2>
        <ul class="taxonomy-term-panel__list">
          {% for sibling_term in sibling_terms.terms %}
            <li>{{ link(sibling_term.name, sibling_term.url) }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </aside>
  {% endif %}

  <div class="taxonomy-term-main">
  {% if term_description %}
    <div class="taxonomy-term-description">{{ term_description }}</div>
  {% endif %}

  {% if records|length == 1%}
  <div data-horizontal-tabs class="taxonomy-records">
    {% set singlerecord = records|first %}
    {{ singlerecord.content }}
  </div>
  {% elseif records|length > 1 %}
  <div data-horizontal-tabs class="taxonomy-records horizontal-tabs clearfix">
    <ul data-horizontal-tabs-list class="horizontal-tabs-list visually-hidden"></ul>
    <div{{ attributes.setAttribute('data-horizontal-tabs-panes', TRUE) }}>
    {% for record in records %}
      <details id="{{ record.tabid }}"{{ record.id == active ? ' open' }}>
        {% if record.id == active %}
        <input style="display:none;" class="horizontal-tabs-active-tab" value="{{ record.tabid }}" type="text">
        {% endif %}
        <summary>
          <div class="details-title">
            <span>{{ record.communities }}</span>
          </div>
        </summary>
        <div class="tab-content-wrapper">
          <div class="tab-content-wrapper__content">
            {{ record.content }}
          </div>
        </div>
      </details>
    {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if referenced_content is not empty %}
    <h2 class="taxonomy-term-main__heading">{{ 'Content'|t }}</h2>
    <div class="referenced-content grid" aria-label="{{ 'Referenced content'|t }}">
      {{ referenced_content }}
    </div>
  {% endif %}
  </div>
  </div>
</div>
