{#
/**
 * @file
 * The public page for a vocabulary.
 *
 * Available variables:
 * - description: The vocabulary's description.
 * - items: Term items, on a short, mostly flat vocabulary. Each has a name, url
 *   and below.
 * - groups: Cards of terms. Each has a heading, url, id and items. The url is
 *   set when the heading is a term.
 * - letters: Links to the first card for each letter. Each has a letter and id.
 * - tools: Whether the filter and letter links show.
 *
 * @see \Drupal\mukurtu_taxonomy\Controller\VocabularyPageController
 */
#}
{% import _self as vocabulary %}

{% macro terms(items) %}
  {% import _self as vocabulary %}
  {# Safari drops list semantics when bullets are removed, unless role is set. #}
  <ul class="vocabulary-page__list" role="list">
    {% for item in items %}
      <li data-vocabulary-term>
        <a href="{{ item.url }}" data-vocabulary-term-name>{{ item.name }}</a>
        {% if item.below %}
          {{ vocabulary.terms(item.below) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

<div class="vocabulary-page taxonomy-term-page"{% if tools %} data-vocabulary-page{% endif %}>
  {% if description %}
    <p class="vocabulary-page__description">{{ description }}</p>
  {% endif %}

  {% if tools %}
    {# The script shows this, as the filter can't work without it. #}
    <div class="vocabulary-page__filter" data-vocabulary-filter hidden>
      <label for="vocabulary-filter">{{ 'Filter terms'|t }}</label>
      <input id="vocabulary-filter" class="form-text form-element" type="search" autocomplete="off">
    </div>
    <p class="vocabulary-page__status" role="status" data-vocabulary-status></p>
    <nav class="vocabulary-page__letters" aria-label="{{ 'Jump to a letter'|t }}" data-vocabulary-letters>
      {% for link in letters %}
        <a href="#{{ link.id }}">{{ link.letter }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  {% if groups %}
    <div class="vocabulary-page__cards">
      {% for group in groups %}
        <section class="vocabulary-page__card" aria-labelledby="{{ group.id }}" data-vocabulary-group>
          <h2 id="{{ group.id }}">
            {%- if group.url -%}
              <a href="{{ group.url }}" data-vocabulary-card-term>{{ group.heading }}</a>
            {%- else -%}
              {{ group.heading }}
            {%- endif -%}
          </h2>
          {% if group.items %}
            {{ vocabulary.terms(group.items) }}
          {% endif %}
        </section>
      {% endfor %}
    </div>
  {% elseif items %}
    <div class="vocabulary-page__columns">
      {{ vocabulary.terms(items) }}
    </div>
  {% else %}
    <p>{{ 'This vocabulary has no terms yet.'|t }}</p>
  {% endif %}
</div>
