<?php

/**
 * @file
 * Provide Mukurtu Taxonomies.
 */

use Drupal\Core\Url;
use Drupal\Core\Link;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_theme().
 */
function mukurtu_taxonomy_theme($existing, $type, $theme, $path) {
  return [
    'mukurtu_vocabulary_add_list' => [
      'template' => 'mukurtu-vocabulary-add-list',
      'variables' => ['content' => NULL],
    ],
    'taxonomy_records' => [
      'template' => 'taxonomy-records',
      'variables' => [
        'active' => NULL,
        'records' => NULL,
        'referenced_content' => NULL,
        'term_description' => '',
        'nested_terms' => [],
        'sibling_terms' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_entity_access().
 */
function mukurtu_taxonomy_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($entity->getEntityTypeId() === 'taxonomy_vocabulary') {
    $vocabs = [
      'category',
      'community_type',
      'contributor',
      'creator',
      'format',
      'interpersonal_relationship',
      'keywords',
      'language',
      'location',
      'media_tag',
      'people',
      'place_type',
      'publisher',
      'role',
      'subject',
      'type',
      'word_type',
    ];
    if ($operation === 'delete' && in_array($entity->id(), $vocabs)) {
      // Don't allow the any of our Mukurtu taxonomy vocabs to be deleted.
      return AccessResult::forbidden();
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_term_form.
 *
 * On a flat stock Mukurtu vocabulary, hides the entire "Relations" fieldset
 * (parent term + weight). flat_taxonomy already hides only the parent field;
 * hiding the whole block keeps the UI clean and consistent across all stock
 * vocabs.
 *
 * On a vocabulary that allows nested terms, makes the parent a single choice,
 * since a term can have only one parent (#2519).
 */
function mukurtu_taxonomy_form_taxonomy_term_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  static $mukurtu_vocabs = [
    'category',
    'community_type',
    'contributor',
    'creator',
    'format',
    'interpersonal_relationship',
    'keywords',
    'language',
    'location',
    'media_tag',
    'people',
    'place_type',
    'publisher',
    'role',
    'subject',
    'type',
    'word_type',
  ];

  if (!isset($form['relations'])) {
    return;
  }

  $vocabulary = Vocabulary::load($form_state->getFormObject()->getEntity()->bundle());
  if (!$vocabulary) {
    return;
  }

  if (\Drupal::service('mukurtu_taxonomy.nested_terms')->isFlat($vocabulary)) {
    if (in_array($vocabulary->id(), $mukurtu_vocabs, TRUE)) {
      $form['relations']['#access'] = FALSE;
    }
    return;
  }

  if (isset($form['relations']['parent'])) {
    $parents = (array) ($form['relations']['parent']['#default_value'] ?? []);
    $form['relations']['parent']['#multiple'] = FALSE;
    $form['relations']['parent']['#title'] = t('Parent term');
    $form['relations']['parent']['#default_value'] = reset($parents) ?: 0;
    $form['relations']['parent']['#element_validate'][] = 'mukurtu_taxonomy_term_parent_validate';
  }
}

/**
 * Element validate callback for the single parent select on the term form.
 *
 * TermForm::buildEntity() expects a list of parents, so wrap the one choice.
 */
function mukurtu_taxonomy_term_parent_validate(array &$element, \Drupal\Core\Form\FormStateInterface $form_state) {
  $form_state->setValueForElement($element, [$element['#value']]);
}

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_vocabulary_form.
 *
 * Lets administrators allow nested terms per vocabulary with flat_taxonomy's
 * checkbox, but replaces that module's entity builder, which flattened every
 * term on every save with no confirmation and no way back (#2519).
 */
function mukurtu_taxonomy_form_taxonomy_vocabulary_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $form['#process'][] = 'mukurtu_taxonomy_flat_taxonomy_process';
}

/**
 * Form #process callback: takes over the flat_taxonomy checkbox.
 *
 * Attached via #process on the root form element (not #after_build, and
 * not directly in the alter above) so it runs before the 'flat' child
 * element is processed, and so it works regardless of whether
 * flat_taxonomy's own hook_form_taxonomy_vocabulary_form_alter() runs before
 * or after this one, since all modules' form alters complete before any
 * #process runs.
 *
 * The taxonomy_vocabulary_form base form ID also covers the vocabulary's term
 * overview, delete, and reset forms, where flat_taxonomy adds its checkbox too.
 * There the checkbox does nothing, so it's hidden, and the form's own submit
 * handlers are left alone.
 */
function mukurtu_taxonomy_flat_taxonomy_process($element, \Drupal\Core\Form\FormStateInterface $form_state, &$complete_form) {
  if (!isset($element['flat'])) {
    return $element;
  }

  if (!$form_state->getFormObject() instanceof \Drupal\taxonomy\VocabularyForm) {
    $element['flat']['#access'] = FALSE;
    return $element;
  }

  $element['flat']['#description'] = t("If checked, terms in this vocabulary can't be nested. If the vocabulary has nested terms, you'll be asked to confirm before they're moved to the top level.");

  // New vocabularies are flat until an administrator opts in.
  if ($form_state->getFormObject()->getEntity()->isNew()) {
    $element['flat']['#default_value'] = TRUE;
  }

  $element['#entity_builders'] = array_values(array_filter(
    $element['#entity_builders'] ?? [],
    fn ($builder) => $builder !== 'flat_taxonomy_form_taxonomy_vocabulary_form_builder',
  ));
  $element['#entity_builders'][] = 'mukurtu_taxonomy_vocabulary_flat_builder';

  if (isset($element['actions']['submit'])) {
    $element['actions']['submit']['#submit'][] = 'mukurtu_taxonomy_vocabulary_flat_submit';
  }

  return $element;
}

/**
 * Entity builder: sets whether the vocabulary is flat.
 *
 * Making a vocabulary that has nested terms flat waits for confirmation, and
 * allowing nested terms again offers to restore a saved structure. Both are
 * flagged here and redirected to in mukurtu_taxonomy_vocabulary_flat_submit().
 * Entity builders run during validation and again on submit, so this must
 * give the same result each time.
 */
function mukurtu_taxonomy_vocabulary_flat_builder(string $entity_type, \Drupal\taxonomy\VocabularyInterface $vocabulary, array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  /** @var \Drupal\mukurtu_taxonomy\NestedTerms $nested_terms */
  $nested_terms = \Drupal::service('mukurtu_taxonomy.nested_terms');
  $make_flat = (bool) $form_state->getValue('flat');

  $was_flat = FALSE;
  if (!$vocabulary->isNew()) {
    $original = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary')->loadUnchanged($vocabulary->id());
    $was_flat = $original && $nested_terms->isFlat($original);
  }

  $form_state->set('mukurtu_taxonomy_flat_redirect', NULL);

  if ($make_flat && !$was_flat && !$vocabulary->isNew() && $nested_terms->countNestedTerms($vocabulary->id())) {
    $vocabulary->unsetThirdPartySetting('flat_taxonomy', 'flat');
    $form_state->set('mukurtu_taxonomy_flat_redirect', 'mukurtu_taxonomy.flatten_vocabulary');
  }
  elseif ($make_flat) {
    $vocabulary->setThirdPartySetting('flat_taxonomy', 'flat', 1);
  }
  else {
    $vocabulary->unsetThirdPartySetting('flat_taxonomy', 'flat');
    if ($was_flat && $nested_terms->hasSnapshot($vocabulary->id())) {
      $form_state->set('mukurtu_taxonomy_flat_redirect', 'mukurtu_taxonomy.restore_nesting');
    }
  }
}

/**
 * Submit handler: sends the administrator to confirm flattening or restoring.
 *
 * Runs after VocabularyForm::save(), which sets its own redirect.
 */
function mukurtu_taxonomy_vocabulary_flat_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $route = $form_state->get('mukurtu_taxonomy_flat_redirect');
  if (!$route) {
    return;
  }
  $vocabulary = $form_state->getFormObject()->getEntity();

  // Core's "Updated vocabulary" message would read as if the terms were
  // already moved, before the administrator has confirmed it.
  if ($route === 'mukurtu_taxonomy.flatten_vocabulary') {
    $messenger = \Drupal::messenger();
    $updated = (string) t('Updated vocabulary %name.', ['%name' => $vocabulary->label()]);
    $statuses = $messenger->deleteByType($messenger::TYPE_STATUS) ?? [];
    foreach ($statuses as $status) {
      if ((string) $status !== $updated) {
        $messenger->addStatus($status);
      }
    }
  }

  // A ?destination= query would otherwise win over this redirect.
  \Drupal::request()->query->remove('destination');
  $form_state->setRedirect($route, ['taxonomy_vocabulary' => $vocabulary->id()]);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for taxonomy_vocabulary.
 */
function mukurtu_taxonomy_taxonomy_vocabulary_delete(\Drupal\taxonomy\VocabularyInterface $vocabulary) {
  \Drupal::service('mukurtu_taxonomy.nested_terms')->deleteSnapshot($vocabulary->id());

  // Core deletes only a vocabulary's top-level terms, expecting their
  // children to go with them, but mukurtu_taxonomy_taxonomy_term_predelete()
  // moved those children up. The vocabulary is gone now, so deleting what's
  // left at the top level takes everything below it too.
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', $vocabulary->id())
    ->condition('parent.target_id', 0)
    ->execute();
  if ($tids) {
    $storage->delete($storage->loadMultiple($tids));
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for taxonomy_term.
 *
 * Moves a deleted term's children up to its parent, or to the top level,
 * where core would delete them with it (#2520).
 */
function mukurtu_taxonomy_taxonomy_term_predelete(\Drupal\taxonomy\TermInterface $term) {
  // While a vocabulary is deleted, its terms go with it.
  if (!Vocabulary::load($term->bundle())) {
    return;
  }
  \Drupal::service('mukurtu_taxonomy.nested_terms')->moveChildren((int) $term->id(), (int) $term->get('parent')->target_id);
}

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_term_confirm_form.
 *
 * Says where a term's children move to on its delete form, replacing core's
 * description, which says they're deleted.
 *
 * @see mukurtu_taxonomy_taxonomy_term_predelete()
 */
function mukurtu_taxonomy_form_taxonomy_term_confirm_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\taxonomy\Form\TermDeleteForm) {
    return;
  }
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $form_object->getEntity();

  // Deleting one translation leaves the term and its children in place.
  if (!$term->isDefaultTranslation()) {
    return;
  }

  $count = count(\Drupal::service('mukurtu_taxonomy.nested_terms')->getChildIds((int) $term->id()));
  if (!$count) {
    $form['description']['#markup'] = t('This action cannot be undone.');
    return;
  }

  $entity_repository = \Drupal::service('entity.repository');
  $parent = $term->get('parent')->entity;
  $args = ['%term' => $entity_repository->getTranslationFromContext($term)->label()];
  if ($parent) {
    $args['%parent'] = $entity_repository->getTranslationFromContext($parent)->label();
    $form['description']['#markup'] = \Drupal::translation()->formatPlural($count,
      '1 term nested under %term will move under %parent. This action cannot be undone.',
      '@count terms nested under %term will move under %parent. This action cannot be undone.',
      $args
    );
  }
  else {
    $form['description']['#markup'] = \Drupal::translation()->formatPlural($count,
      '1 term nested under %term will move to the top level. This action cannot be undone.',
      '@count terms nested under %term will move to the top level. This action cannot be undone.',
      $args
    );
  }
}

/**
 * Implements hook_entity_base_field_info_alter().
 *
 * A term can have only one parent (#2519).
 */
function mukurtu_taxonomy_entity_base_field_info_alter(&$fields, EntityTypeInterface $entity_type) {
  if ($entity_type->id() === 'taxonomy_term' && isset($fields['parent'])) {
    $fields['parent']->addConstraint('MukurtuSingleParent');
  }
}

/**
 * Implements hook_form_form_id_alter().
 */
function mukurtu_taxonomy_form_taxonomy_term_category_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Change Category title field label.
  $form['name']['widget'][0]['value']['#title'] = t('Category name');
  $form['name']['widget'][0]['value']['#description'] = t('Provide the category name. Categories are high-level descriptive terms that help users browse and discover digital heritage items.');

  // Add helper text to description field using a markup element.
if (isset($form['description'])) {
  // Insert help text as a separate element
  $form['description']['#suffix'] = '<div class="description"><small>The description is not normally shown to end users. It may be used for internal documentation to clarify or define the content that should be included in the category, or to provide additional details about the category.</small></div>';
}
  // Add helper text to thumbnail image field.
  if (isset($form['field_thumbnail_image'])) {
    $form['field_thumbnail_image']['widget']['#description'] = t('The thumbnail image is used in the "browse by category" page and landing page block. A thumbnail could be a photograph, graphic, or other image that represents the content or concept of the category. If a thumbnail image is not provided, a placeholder graphic will be displayed instead.<br>Note: thumbnail images require a cultural protocol (like all other media assets). If you cannot upload images here, ensure that you are enrolled in a relevant cultural protocol with permission to upload media.');
  }

  // Add helper text to path field.
  if (isset($form['path'])) {
    $form['path']['widget'][0]['#description'] = t('Leave blank to auto-generate a URL path based on the category name. Optionally, enter a custom path.');
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_term_category_delete_form.
 *
 * Prevents deletion of a category term that is referenced by digital
 * heritage items, since field_category is a required field on those items.
 */
function mukurtu_taxonomy_form_taxonomy_term_category_delete_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $form['#validate'][] = 'mukurtu_taxonomy_category_term_delete_validate';
}

/**
 * Validation handler: blocks category term deletion when DH items reference it.
 */
function mukurtu_taxonomy_category_term_delete_validate(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $form_state->getFormObject()->getEntity();

  $count = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->getQuery()
    ->condition('type', 'digital_heritage')
    ->condition('field_category', $term->id())
    ->accessCheck(FALSE)
    ->count()
    ->execute();

  if ($count > 0) {
    $form_state->setError($form, \Drupal::translation()->formatPlural(
      $count,
      'The category %name cannot be deleted because it is used by 1 digital heritage item.',
      'The category %name cannot be deleted because it is used by @count digital heritage items.',
      ['%name' => $term->label(), '@count' => $count]
    ));
  }
}

/**
 * Implements hook_form_form_id_alter().
 *
 * Change the description of the 'Terms to merge' form element for the
 * taxonomy_merge_terms form:
 * (admin/structure/taxonomy/manage/{taxonomy_vocabulary}/merge).
 */

function mukurtu_taxonomy_form_taxonomy_merge_terms_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $form['#markup'] = t('To merge multiple terms into a new target term, select all terms to merge here. The new target term will be created on the next page.<br/>To merge one or more terms into another existing target term, select them here. The target term will be selected on the next page, do not select it now.');

  $form['terms']['#description'] = t('');

  // term_merge 2.0.1 replaced its checkbox list with a comma-separated
  // autocomplete, so terms could no longer be browsed. Tagify restores a
  // browsable list (all terms, A to Z, on click) with multiple selection.
  // See https://github.com/MukurtuCMS/Mukurtu-CMS/issues/2438
  $vocabulary = $form_state->getBuildInfo()['args'][0] ?? NULL;
  if ($vocabulary instanceof \Drupal\taxonomy\VocabularyInterface && \Drupal::moduleHandler()->moduleExists('tagify')) {
    $vid = $vocabulary->id();
    unset($form['terms']['#tags'], $form['terms']['#maxlength']);
    $form['terms'] = [
      '#type' => 'entity_autocomplete_tagify',
      '#selection_handler' => 'default:taxonomy_term',
      '#selection_settings' => [
        'target_bundles' => [$vid => $vid],
        'sort' => ['field' => 'name', 'direction' => 'ASC'],
        // Large enough to list a whole vocabulary. Not 0 (no limit): with no
        // limit and nothing typed, core's TermSelection returns the
        // vocabulary tree in weight order and ignores the sort above.
        'match_limit' => 10000,
      ],
      '#cardinality' => -1,
      '#max_items' => 0,
      // 0 = show the suggestions dropdown on click, before anything is typed.
      '#suggestions_dropdown' => 0,
      '#identifier' => 'mukurtu-term-merge',
      '#attributes' => ['class' => ['mukurtu-term-merge']],
      '#element_validate' => ['mukurtu_taxonomy_term_merge_terms_validate'],
      '#mukurtu_vocabulary' => $vid,
    ] + $form['terms'];
    // An empty description leaves the Tagify textbox described by an empty
    // element.
    unset($form['terms']['#description']);
    // Tagify hides the original input, so the browser's required check would
    // point at, and focus, an invisible element. Rely on server-side
    // validation instead.
    $form['#attributes']['novalidate'] = 'novalidate';
  }

  $form['actions']['submit']['#value'] = t('Next');
}

/**
 * Element validate callback for the Tagify 'Terms to merge' element.
 *
 * Converts Tagify's JSON value into the [['target_id' => tid]] shape that
 * \Drupal\term_merge\Form\MergeTerms::getSelectedTermIds() reads. Terms from
 * other vocabularies are dropped; if none remain, term_merge's own validation
 * reports that no term was selected.
 */
function mukurtu_taxonomy_term_merge_terms_validate(array &$element, \Drupal\Core\Form\FormStateInterface $form_state) {
  $selected = json_decode((string) ($element['#value'] ?? ''), TRUE);
  $tids = is_array($selected) ? array_filter(array_map('intval', array_column($selected, 'entity_id'))) : [];

  $items = [];
  if ($tids) {
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadMultiple($tids);
    foreach ($terms as $term) {
      if ($term->bundle() === $element['#mukurtu_vocabulary']) {
        $items[] = ['target_id' => (int) $term->id()];
      }
    }
  }

  $form_state->setValueForElement($element, $items);
}

function mukurtu_taxonomy_form_taxonomy_merge_terms_target_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $form ['#title'] = t('Select target term');

  $form['description']['#markup'] = t('To merge the selected terms into a new target term, enter it in the "New term" field.<br/>To merge the selected term(s) into an existing target term, select it from the "Existing term" list.');

  $form['actions']['submit']['#value'] = t('Merge terms');
}

/**
 * Prepares variables for list of available vocabulary templates.
 *
 * Default template: mukurtu-vocabulary-add-list.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - content: An array of content types.
 */
function template_preprocess_mukurtu_vocabulary_add_list(array &$variables) {
  $variables['types'] = [];

  if (!empty($variables['content'])) {
    foreach ($variables['content'] as $type) {
      $variables['types'][$type->id()] = [
        'type' => $type->id(),
        'add_link' => Link::fromTextAndUrl($type->label(), Url::fromRoute('mukurtu_taxonomy.manage_taxonomy_vocabulary', ['taxonomy_vocabulary' => $type->id()]))->toString(),
        'description' => [
          '#markup' => $type->getDescription(),
        ],
      ];
    }
  }
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 *
 * Sets target_bundles on taxonomy term reference fields from Mukurtu taxonomy
 * settings so that selection handlers and widgets see the correct bundles.
 */
function mukurtu_taxonomy_entity_bundle_field_info_alter(&$fields, EntityTypeInterface $entity_type, $bundle) {
  // Map bundle names to their fields and config keys. Person and Place are
  // node bundles that define these fields via bundleFieldDefinitions().
  $field_config_map = [
    'person' => [
      'field_other_names' => 'person_records_enabled_vocabularies',
    ],
    'place' => [
      'field_other_place_names' => 'place_records_enabled_vocabularies',
    ],
  ];

  if ($entity_type->id() !== 'node' || !isset($field_config_map[$bundle])) {
    return;
  }

  $config = \Drupal::config('mukurtu_taxonomy.settings');
  foreach ($field_config_map[$bundle] as $field_name => $config_key) {
    if (!isset($fields[$field_name])) {
      continue;
    }

    $enabled_vocabs = $config->get($config_key);
    if (!is_array($enabled_vocabs) || empty($enabled_vocabs)) {
      continue;
    }

    $target_bundles = array_combine($enabled_vocabs, $enabled_vocabs);
    $settings = $fields[$field_name]->getSettings();
    $settings['handler_settings']['target_bundles'] = $target_bundles;
    $fields[$field_name]->setSettings($settings);
  }
}


/**
 * Implements hook_options_list_alter().
 *
 * Removes core's depth dashes from term checkboxes and radios, which show
 * nesting as groups instead (#2523). Select lists keep the dashes, since
 * their options can't nest.
 *
 * @see \Drupal\mukurtu_taxonomy\NestedTermOptions
 */
function mukurtu_taxonomy_options_list_alter(array &$options, array $context) {
  $definition = $context['fieldDefinition'] ?? NULL;
  if (!$definition || $definition->getSetting('target_type') !== 'taxonomy_term' || !($context['widget'] ?? NULL) instanceof \Drupal\Core\Field\Plugin\Field\FieldWidget\OptionsButtonsWidget) {
    return;
  }
  $vids = array_keys($definition->getSetting('handler_settings')['target_bundles'] ?? []);
  $options = \Drupal\mukurtu_taxonomy\NestedTermOptions::removeDashes($options, \Drupal\mukurtu_taxonomy\NestedTermOptions::getTree($vids));
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 *
 * Groups nested terms in term checkboxes and radios (#2523).
 *
 * @see \Drupal\mukurtu_taxonomy\NestedTermOptions::processElement()
 */
function mukurtu_taxonomy_field_widget_single_element_options_buttons_form_alter(array &$element, \Drupal\Core\Form\FormStateInterface $form_state, array $context) {
  $definition = $context['items']->getFieldDefinition();
  if ($definition->getSetting('target_type') !== 'taxonomy_term' || empty($element['#type'])) {
    return;
  }
  $vids = array_keys($definition->getSetting('handler_settings')['target_bundles'] ?? []);
  $element['#mukurtu_term_tree'] = \Drupal\mukurtu_taxonomy\NestedTermOptions::getTree($vids);
  // Setting #process replaces the element type's own callbacks, which make
  // the checkboxes and radios, so keep those and run after them.
  $element['#process'] = array_merge(
    $element['#process'] ?? \Drupal::service('element_info')->getInfoProperty($element['#type'], '#process', []),
    [[\Drupal\mukurtu_taxonomy\NestedTermOptions::class, 'processElement']],
  );
}
