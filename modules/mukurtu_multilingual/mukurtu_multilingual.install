<?php

/**
 * @file
 * Install, update and uninstall functions for the Mukurtu Multilingual module.
 */

use Drupal\Core\Field\Entity\BaseFieldOverride;
use Drupal\field\Entity\FieldConfig;
use Drupal\language\Entity\ContentLanguageSettings;
use Drupal\search_api\Entity\Index;
use Drupal\search_api\Item\Field as SearchApiField;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function mukurtu_multilingual_install() {
  // Assign translation permissions to mukurtu_manager role.
  $role = Role::load('mukurtu_manager');
  if ($role) {
    $permissions = [
      'translate interface',
      'translate configuration',
      'translate editable entities',
      'administer content translation',
      'administer languages',
    ];
    foreach ($permissions as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }

  // Assign translate editable entities permission to authenticated role.
  $authenticated_role = Role::load('authenticated');
  if ($authenticated_role) {
    $authenticated_role->grantPermission('translate editable entities');
    $authenticated_role->save();
  }

  // Clear the cache.discovery bin where field definitions are cached.
  \Drupal::service('cache.discovery')->deleteAll();

  _mukurtu_multilingual_apply_language_negotiation_defaults();

  // Make all comment fields on node bundles untranslatable.
  $node_types = \Drupal::entityTypeManager()->getStorage('node_type')->loadMultiple();
  foreach ($node_types as $node_type) {
    $bundle = $node_type->id();
    $field_config = FieldConfig::loadByName('node', $bundle, 'comment');
    if ($field_config) {
      $field_config->setTranslatable(FALSE);
      $field_config->save();
    }
  }

  _mukurtu_multilingual_apply_translation_overrides();
}

/**
 * Adjusts language negotiation settings.
 *
 * This enables content language detection apart from interface language
 * detection. It also prioritizes a users' Administration pages language
 * setting, so that interface text follows their preference rather than the
 * content language. Idempotent: safe to call on a site that has already
 * converged on these settings, or whose settings have drifted.
 */
function _mukurtu_multilingual_apply_language_negotiation_defaults(): void {
  $config = \Drupal::configFactory()->getEditable('language.types');
  $config->set('configurable', ['language_interface', 'language_content'])
    ->set('negotiation.language_content.enabled', [
      'language-url' => -8,
      'language-interface' => 9,
      'language-selected' => 12,
    ])
    ->set('negotiation.language_interface.enabled', [
      'language-user-admin' => -10,
      'language-url' => -8,
      'language-user' => -4,
      'language-selected' => 12,
    ]);
  $config->save();
}

/**
 * Applies translation overrides for config already owned by other modules.
 *
 * A handful of base field overrides and one content language settings
 * object are shipped (with different values) by the content-type module
 * that owns the bundle, so this module can't ship its own
 * config/install/*.yml for them: Drupal's ConfigInstaller refuses to
 * install a module whose config/install ships a config name that already
 * exists in active storage, which blocks the entire module install, not
 * just that one file. Apply the intended overrides imperatively instead,
 * after the owning module's config already exists.
 *
 * Title and promote are administrative/computed fields on these bundles
 * (the real translatable content lives in bundle-specific fields), so they
 * should not fork per translation the way the owning module's own default
 * assumes on a non-multilingual site.
 */
function _mukurtu_multilingual_apply_translation_overrides(): void {
  $untranslatable_fields = [
    ['node', 'dictionary_word', 'title'],
    ['node', 'landing_page', 'promote'],
    ['node', 'person', 'title'],
    ['node', 'place', 'title'],
    ['node', 'word_list', 'promote'],
  ];
  foreach ($untranslatable_fields as [$entity_type_id, $bundle, $field_name]) {
    $override = BaseFieldOverride::loadByName($entity_type_id, $bundle, $field_name);
    if ($override && $override->isTranslatable()) {
      $override->setTranslatable(FALSE)->save();
    }
  }

  // Landing pages need content translation enabled like every other node
  // bundle; the owning module's default ships language_alterable: false
  // with no content_translation settings at all.
  /** @var \Drupal\content_translation\ContentTranslationManagerInterface $content_translation_manager */
  $content_translation_manager = \Drupal::service('content_translation.manager');
  $content_translation_manager->setEnabled('node', 'landing_page', TRUE);
  $content_translation_manager->setBundleTranslationSettings('node', 'landing_page', [
    'untranslatable_fields_hide' => '0',
  ]);
  $landing_page_settings = ContentLanguageSettings::loadByEntityTypeBundle('node', 'landing_page');
  if ($landing_page_settings && !$landing_page_settings->isLanguageAlterable()) {
    $landing_page_settings->setLanguageAlterable(TRUE)->save();
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_multilingual update hook was removed in 4.0.1. 40009 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core does not enforce that on
 * its own, so mukurtu_core_update_requirements() blocks them explicitly.
 */
function mukurtu_multilingual_update_last_removed(): int {
  return 40009;
}
