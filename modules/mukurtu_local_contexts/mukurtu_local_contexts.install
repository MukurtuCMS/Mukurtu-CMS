        'type' => 'varchar',
        'length' => 36,
        'not null' => TRUE,
        'description' => 'Label ID',
      ],
      'locale' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Language code',
      ],
      'language' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'description' => 'Type',
      ],
      'name' => [
        'type' => 'text',
