        'not null' => TRUE,
        'description' => 'The project title',
      ],
      'privacy' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'The project privacy setting',
      ],
      'updated' => [
        'description' => 'The Unix timestamp when the project was last fetched from the hub.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'status' => [
        'description' => 'The last known sync status: active, unauthorized, forbidden, not_found, or error.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'active',
      ],
      'status_message' => [
        'description' => 'The last error/detail message returned by the hub, if any.',
