        'type' => 'varchar',
        'length' => 36,
        'not null' => TRUE,
        'description' => 'Project ID',
      ],
      'type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Type',
      ],
      // Display tells if it's a label or notice.
      'display' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Display',
        'default' => 'notice',
      ],
      'name' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'Name',
      ],
      'img_url' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'Image URL',
      ],
      'svg_url' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'SVG URL',
      ],
      'locale' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Language code',
      ],
      'language' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'description' => 'Language',
      ],
      'default_text' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'Text',
      ],
      'updated' => [
        'description' => 'The Unix timestamp when the notice was last fetched from the hub.',
