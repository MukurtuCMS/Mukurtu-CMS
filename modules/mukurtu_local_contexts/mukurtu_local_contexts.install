  $schema['mukurtu_local_contexts_notice_translations'] = [
    'description' => 'Local Contexts Notice Translations',
    'fields' => [
      'project_id' => [
        'type' => 'varchar',
        'length' => 36,
        'not null' => TRUE,
        'description' => 'Project ID',
      ],
      'type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Type',
      ],
      'locale' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Language code',
      ],
      'language' => [
        'type' => 'varchar',
        'length' => 128,
