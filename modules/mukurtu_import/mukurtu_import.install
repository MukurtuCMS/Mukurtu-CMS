<?php

/**
 * @file
 * Update functions for the Mukurtu Import module.
 */

/**
 * Implements hook_schema().
 */
function mukurtu_import_schema(): array {
  $schema['mukurtu_import_log'] = [
    'description' => 'Persistent record of each file processed by the Mukurtu import wizard.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'import_id' => [
        'type' => 'varchar_ascii',
        'length' => 36,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Wizard session UUID grouping all files from one import run.',
      ],
      'migration_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The stub migration ID for this file.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The user who ran the import.',
      ],
      'fid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'The source file id, if it still exists.',
      ],
      'filename' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Snapshot of the source filename at import time.',
      ],
      'entity_type_id' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The destination entity type.',
      ],
      'bundle' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'The destination bundle.',
      ],
      'success' => [
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => '1 if the file imported with zero failures, else 0.',
      ],
      'count_processed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Total rows processed.',
      ],
      'count_created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that created a new entity.',
      ],
      'count_updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that updated an existing entity.',
      ],
      'count_failed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that failed to import.',
      ],
      'count_ignored' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that were ignored.',
      ],
      'messages' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Newline-joined error/warning text for this file.',
      ],
      'details' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'JSON-encoded per-row created/updated/failed detail for this file.',
      ],
      'timestamp' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When this file finished processing.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'import_id' => ['import_id'],
      'uid_timestamp' => ['uid', 'timestamp'],
      'timestamp' => ['timestamp'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_import update hook was removed in 4.0.1. 40046 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core does not enforce that on
 * its own, so mukurtu_core_update_requirements() blocks them explicitly.
 */
function mukurtu_import_update_last_removed(): int {
  return 40046;
}
