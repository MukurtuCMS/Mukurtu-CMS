<?php

/**
 * @file
 * Update functions for the Mukurtu Import module.
 */

/**
 * Implements hook_schema().
 */
function mukurtu_import_schema(): array {
  $schema['mukurtu_import_log'] = [
    'description' => 'Persistent record of each file processed by the Mukurtu import wizard.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'import_id' => [
        'type' => 'varchar_ascii',
        'length' => 36,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Wizard session UUID grouping all files from one import run.',
      ],
      'migration_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The stub migration ID for this file.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The user who ran the import.',
      ],
      'fid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'The source file id, if it still exists.',
      ],
      'filename' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Snapshot of the source filename at import time.',
      ],
      'entity_type_id' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The destination entity type.',
      ],
      'bundle' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'The destination bundle.',
      ],
      'success' => [
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => '1 if the file imported with zero failures, else 0.',
      ],
      'count_processed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Total rows processed.',
      ],
      'count_created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that created a new entity.',
      ],
      'count_updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that updated an existing entity.',
      ],
      'count_failed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that failed to import.',
      ],
      'count_ignored' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that were ignored.',
      ],
      'messages' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Newline-joined error/warning text for this file.',
      ],
      'details' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'JSON-encoded per-row created/updated/failed detail for this file.',
      ],
      'timestamp' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When this file finished processing.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'import_id' => ['import_id'],
      'uid_timestamp' => ['uid', 'timestamp'],
      'timestamp' => ['timestamp'],
    ],
  ];
  return $schema;
}

/**
 * Add granular import template permissions to roles with administer permission.
 */
function mukurtu_import_update_40001(): void {
  $new_permissions = [
    'create mukurtu_import_strategy',
    'edit own mukurtu_import_strategy',
    'delete own mukurtu_import_strategy',
  ];

  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  /** @var \Drupal\user\RoleInterface[] $roles */
  $roles = $role_storage->loadMultiple();
  foreach ($roles as $role) {
    if ($role->hasPermission('administer mukurtu_import_strategy')) {
      foreach ($new_permissions as $permission) {
        $role->grantPermission($permission);
      }
      $role->save();
    }
  }
}

/**
 * Create the 'Digital heritage item - all fields' import strategy.
 */
function mukurtu_import_update_40002(): void {
  $config_name = 'mukurtu_import.mukurtu_import_strategy.digital_heritage_item_all_fields';
  $config = \Drupal::configFactory()->getEditable($config_name);

  // Only create if it doesn't already exist.
  if ($config->isNew()) {
    $path = \Drupal::service('extension.list.module')->getPath('mukurtu_import');
    $yaml = file_get_contents($path . '/config/install/' . $config_name . '.yml');
    $data = \Drupal\Core\Serialization\Yaml::decode($yaml);
    $config->setData($data)->save();
  }
}

/**
 * Drop the unused mukurtu_import_example table.
 */
function mukurtu_import_update_40003(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('mukurtu_import_example')) {
    $schema->dropTable('mukurtu_import_example');
  }
}

