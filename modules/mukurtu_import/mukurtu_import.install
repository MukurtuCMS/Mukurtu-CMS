/**
 * Create the mukurtu_import_log table.
 */
function mukurtu_import_update_40038(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('mukurtu_import_log')) {
    return;
  }
  $table = [
    'description' => 'Persistent record of each file processed by the Mukurtu import wizard.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'import_id' => [
        'type' => 'varchar_ascii',
        'length' => 36,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Wizard session UUID grouping all files from one import run.',
      ],
      'migration_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The stub migration ID for this file.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The user who ran the import.',
      ],
      'fid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'The source file id, if it still exists.',
      ],
      'filename' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Snapshot of the source filename at import time.',
      ],
      'entity_type_id' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The destination entity type.',
      ],
      'bundle' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'The destination bundle.',
      ],
      'success' => [
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => '1 if the file imported with zero failures, else 0.',
      ],
      'count_processed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Total rows processed.',
      ],
      'count_created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that created a new entity.',
      ],
      'count_updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that updated an existing entity.',
      ],
      'count_failed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that failed to import.',
      ],
      'count_ignored' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Rows that were ignored.',
      ],
      'messages' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Newline-joined error/warning text for this file.',
      ],
      'timestamp' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When this file finished processing.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'import_id' => ['import_id'],
      'uid_timestamp' => ['uid', 'timestamp'],
      'timestamp' => ['timestamp'],
    ],
  ];
  $schema->createTable('mukurtu_import_log', $table);
}

/**
 * Grant 'view any mukurtu_import_log' to the mukurtu_manager role.
 */
function mukurtu_import_update_40039(): void {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('mukurtu_manager');
  if ($role) {
    $role->grantPermission('view any mukurtu_import_log');
    $role->save();
  }
}

/**
 * Grant 'administer mukurtu_import_strategy' to the mukurtu_manager role.
 */
function mukurtu_import_update_40040(): void {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('mukurtu_manager');
  if ($role) {
    $role->grantPermission('administer mukurtu_import_strategy');
    $role->save();
  }
}

/**
 * Add the 'details' column to mukurtu_import_log.
 *
 * Stores JSON-encoded per-row detail (created/updated entity label + link,
 * or failed row messages) so the log detail page can show a structured
 * Created/Updated/Failed breakdown instead of just counts.
 */
function mukurtu_import_update_40041(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('mukurtu_import_log', 'details')) {
    return;
  }
  $schema->addField('mukurtu_import_log', 'details', [
    'type' => 'text',
    'size' => 'big',
    'not null' => FALSE,
    'description' => 'JSON-encoded per-row created/updated/failed detail for this file.',
  ]);
}

/**
 * Create the 'User - all fields' import strategy.
 */
function mukurtu_import_update_40042(): void {
  $config_name = 'mukurtu_import.mukurtu_import_strategy.user_all_fields';
  $config = \Drupal::configFactory()->getEditable($config_name);

  // Only create if it doesn't already exist.
  if ($config->isNew()) {
    $path = \Drupal::service('extension.list.module')->getPath('mukurtu_import');
    $yaml = file_get_contents($path . '/config/install/' . $config_name . '.yml');
    $data = \Drupal\Core\Serialization\Yaml::decode($yaml);
    $config->setData($data)->save();
  }
}

/**
 * Add Communities/Protocols columns to the 'User - all fields' strategy.
 *
 * Adds the two new mapping entries to sites that already ran update_40042,
 * without disturbing any other customizations the site may have made to
 * this strategy (no unconditional overwrite).
 */
function mukurtu_import_update_40043(): void {
  $config_name = 'mukurtu_import.mukurtu_import_strategy.user_all_fields';
  $config = \Drupal::configFactory()->getEditable($config_name);

  // Sites that haven't created this strategy yet will get the new mapping
  // entries via update_40042's YAML, which already includes them.
  if ($config->isNew()) {
    return;
  }

  $mapping = $config->get('mapping') ?? [];
  $existing_targets = array_column($mapping, 'target');
  $new_entries = [
    'communities' => 'Communities',
    'protocols' => 'Protocols',
  ];
  foreach ($new_entries as $target => $source) {
    if (!in_array($target, $existing_targets, TRUE)) {
      $mapping[] = ['source' => $source, 'target' => $target];
    }
  }
  $config->set('mapping', $mapping)->save();
}

/**
 * Simplify the 'User - all fields' strategy mapping: drop fields hidden
 * from the import target list, and switch Status/Pending to the unified
 * Account Status target.
 *
 * The following targets are no longer offered on the import mapping form
 * (they aren't exposed on the interactive account registration/admin "add
 * user" forms either, so listing them there was more confusing than
 * useful): created, langcode, message_subscribe_email,
 * user_picture/alt, user_picture/target_id, preferred_langcode,
 * preferred_admin_langcode, timezone. Status and Pending are superseded by
 * the single Account Status target (Active/Blocked/Pending). Only touches
 * this specific default strategy, without disturbing any other
 * customizations a site may have made to it (no unconditional overwrite),
 * matching update_40043's precedent.
 */
function mukurtu_import_update_40044(): void {
  $config_name = 'mukurtu_import.mukurtu_import_strategy.user_all_fields';
  $config = \Drupal::configFactory()->getEditable($config_name);

  // Sites that haven't created this strategy yet will get the simplified
  // mapping via update_40042's YAML, which already reflects it.
  if ($config->isNew()) {
    return;
  }

  $mapping = $config->get('mapping') ?? [];
  $removed_targets = [
    'created',
    'langcode',
    'message_subscribe_email',
    'user_picture/alt',
    'user_picture/target_id',
    'preferred_langcode',
    'preferred_admin_langcode',
    'timezone',
    'status',
    'field_pending',
  ];
  $mapping = array_values(array_filter($mapping, fn(array $entry) => !in_array($entry['target'], $removed_targets, TRUE)));

  $existing_targets = array_column($mapping, 'target');
  if (!in_array('account_status', $existing_targets, TRUE)) {
    $mapping[] = ['source' => 'Account Status', 'target' => 'account_status'];
  }

  $config->set('mapping', $mapping)->save();
}

/**
 * Superseded by mukurtu_import_update_40046().
 */
function mukurtu_import_update_40045(): void {
}

/**
 * Ensure the 'User - all fields' strategy's username source is 'Username',
 * matching the label the actual "Add user" admin form uses for this field
 * (the base field's own definition label is the more generic 'Name',
 * which import_update_40045() briefly and mistakenly aligned this preset
 * to before the import UI's displayed/matched label for this field was
 * itself corrected to 'Username' in ImportFormTrait::buildTargetOptions()/
 * getFieldLabelOverrides()). Only touches this specific default strategy's
 * 'name' target entry, without disturbing any other customizations a site
 * may have made to it (no unconditional overwrite), matching
 * update_40043/40044's precedent.
 */
function mukurtu_import_update_40046(): void {
  $config_name = 'mukurtu_import.mukurtu_import_strategy.user_all_fields';
  $config = \Drupal::configFactory()->getEditable($config_name);

  // Sites that haven't created this strategy yet will get the corrected
  // mapping via update_40042's YAML, which already reflects it.
  if ($config->isNew()) {
    return;
  }

  $mapping = $config->get('mapping') ?? [];
  foreach ($mapping as &$entry) {
    if ($entry['target'] === 'name' && $entry['source'] === 'Name') {
      $entry['source'] = 'Username';
    }
  }
  unset($entry);

  $config->set('mapping', $mapping)->save();
}
