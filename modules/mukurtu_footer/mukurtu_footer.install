<?php

/**
 * @file
 * Install, update, and uninstall functions for the Mukurtu Footer module.
 */

use Drupal\block_content\Entity\BlockContent;
use Drupal\paragraphs\Entity\Paragraph;

/**
 * Implements hook_install().
 */
function mukurtu_footer_install() {
  // Create the default footer block_content entity if one doesn't exist.
  $existing = \Drupal::entityTypeManager()
    ->getStorage('block_content')
    ->loadByProperties(['type' => 'mukurtu_footer']);

  if (empty($existing)) {
    $footer = BlockContent::create([
      'type' => 'mukurtu_footer',
      'info' => 'Mukurtu Footer',
      'status' => TRUE,
      'field_footer_contact_email_label' => 'Email us at',
      'field_footer_copyright' => '© [current-date:html_year] Mukurtu CMS',
      // Without this the site-wide contact form at /contact is unreachable by
      // navigation. Core ships a footer menu link for it but disabled, and the
      // block that renders the core footer menu is disabled too, so the form is
      // only findable by typing the URL. Editable and removable like any other
      // footer link.
      'field_footer_other_links' => [
        ['uri' => 'internal:/contact', 'title' => 'Contact'],
      ],
    ]);
    $footer->save();
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_footer update hook was removed in 4.0.1. 40003 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core does not enforce that on
 * its own, so mukurtu_core_update_requirements() blocks them explicitly.
 */
function mukurtu_footer_update_last_removed(): int {
  return 40003;
}
