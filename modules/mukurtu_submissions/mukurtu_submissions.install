<?php

/**
 * @file
 * Install, update, and uninstall functions for the Mukurtu Submissions module.
 */

use Drupal\mukurtu_media\MediaTypeExtensions;
use Drupal\mukurtu_submissions\Entity\SubmissionSettingsInterface;
use Drupal\user\Entity\User;

/**
 * Permissions "administrator" and "mukurtu_manager" need to review pending
 * submissions: the submission entity itself, the digital_heritage node
 * (submissions are created owned by the service account with no cultural
 * protocol assigned yet - MukurtuProtocolNodeAccessControlHandler's
 * "empty protocols" fallback requires "edit/delete any digital_heritage
 * content" to grant access to anyone but the owner), and any media a
 * visitor uploaded via SimpleMediaUploadWidget (same "empty protocols,
 * not owner" situation, via MukurtuProtocolMediaAccessControlHandler's
 * equivalent fallback for "edit/delete any {bundle} media").
 *
 * Shared by hook_install() (fresh installs) and
 * mukurtu_submissions_update_40001() (existing sites), so the two can't
 * drift out of sync.
 */
function mukurtu_submissions_review_permissions(): array {
  $permissions = [
    'administer mukurtu submissions',
    'review mukurtu submissions',
    'edit any digital_heritage content',
    'delete any digital_heritage content',
  ];
  foreach (array_keys(MediaTypeExtensions::SUPPORTED_TYPES) as $bundle) {
    $permissions[] = "edit any $bundle media";
    $permissions[] = "delete any $bundle media";
  }
  return $permissions;
}

/**
 * Implements hook_install().
 */
function mukurtu_submissions_install($is_syncing): void {
  if ($is_syncing) {
    return;
  }

  $config = \Drupal::configFactory()->getEditable('mukurtu_submissions.settings');
  if (!$config->get('service_account_uid')) {
    $account = mukurtu_submissions_create_service_account();
    $config->set('service_account_uid', (int) $account->id())->save();
  }

  foreach (['administrator', 'mukurtu_manager'] as $role_id) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($role_id);
    if (!$role || !$role->id()) {
      continue;
    }
    $changed = FALSE;
    foreach (mukurtu_submissions_review_permissions() as $permission) {
      if (!$role->hasPermission($permission)) {
        $role->grantPermission($permission);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $role->save();
    }
  }

  // Ensure shipped settings entities (e.g. digital_heritage) get their
  // hyphenated public alias and role permissions synced, in case
  // hook_mukurtu_submission_settings_insert() doesn't fire for config
  // installed directly from config/install.
  foreach (\Drupal::entityTypeManager()->getStorage('mukurtu_submission_settings')->loadMultiple() as $settings) {
    if ($settings instanceof SubmissionSettingsInterface) {
      mukurtu_submissions_ensure_path_aliases($settings);
      mukurtu_submissions_sync_submission_permission($settings);
    }
  }
}

/**
 * Creates the blocked "Submission Forms" service account.
 */
function mukurtu_submissions_create_service_account(): User {
  $account = User::create([
    'name' => 'Submission Forms',
    'mail' => 'public-submissions@' . \Drupal::request()->getHost(),
    'status' => 0,
    'pass' => \Drupal::service('password_generator')->generate(32),
  ]);
  $account->save();
  return $account;
}

/**
 * Implements hook_uninstall().
 */
function mukurtu_submissions_uninstall(): void {
  $uid = \Drupal::config('mukurtu_submissions.settings')->get('service_account_uid');
  if ($uid) {
    $account = User::load($uid);
    if ($account) {
      $account->delete();
    }
  }

  // Path aliases are plain content entities, not config, so they aren't
  // cleaned up automatically the way the config this module ships is -
  // remove the ones mukurtu_submissions_ensure_path_aliases() created,
  // mirroring exactly how it computed their source paths.
  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  foreach (\Drupal::entityTypeManager()->getStorage('mukurtu_submission_settings')->loadMultiple() as $settings) {
    if (!$settings instanceof SubmissionSettingsInterface) {
      continue;
    }
    $entity_type_id = $settings->getTargetEntityTypeId();
    $bundle = $settings->getTargetBundle();
    foreach (["/submit/$entity_type_id/$bundle", "/submit/$entity_type_id/$bundle/thank-you"] as $source) {
      $alias_storage->delete($alias_storage->loadByProperties(['path' => $source]));
    }
  }
}

/**
 * Grants "administrator" and "mukurtu_manager" the permissions needed to
 * review a pending submission's node and any visitor-uploaded media - see
 * mukurtu_submissions_review_permissions() for why these are required.
 */
function mukurtu_submissions_update_40001(): void {
  foreach (['administrator', 'mukurtu_manager'] as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if (!$role) {
      continue;
    }
    $changed = FALSE;
    foreach (mukurtu_submissions_review_permissions() as $permission) {
      if (!$role->hasPermission($permission)) {
        $role->grantPermission($permission);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $role->save();
    }
  }
}

/**
 * Renames the service account from "Public Submissions" to "Submission
 * Forms", matching the module's naming cleanup - only if a site hasn't
 * already renamed it to something else.
 */
function mukurtu_submissions_update_40002(): void {
  $uid = \Drupal::config('mukurtu_submissions.settings')->get('service_account_uid');
  if (!$uid) {
    return;
  }
  $account = User::load($uid);
  if ($account && $account->getAccountName() === 'Public Submissions') {
    $account->setUsername('Submission Forms');
    $account->save();
  }
}
