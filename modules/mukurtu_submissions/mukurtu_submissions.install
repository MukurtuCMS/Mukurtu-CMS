<?php

/**
 * @file
 * Install, update, and uninstall functions for the Mukurtu Submissions module.
 */

use Drupal\mukurtu_media\MediaTypeExtensions;
use Drupal\mukurtu_submissions\Entity\SubmissionSettingsInterface;
use Drupal\user\Entity\User;

/**
 * Permissions "administrator" and "mukurtu_manager" need to review pending
 * submissions: the submission entity itself, and any media a visitor
 * uploaded via SimpleMediaUploadWidget (submissions are created owned by
 * the service account with no cultural protocol assigned yet -
 * MukurtuProtocolMediaAccessControlHandler's "empty protocols" fallback
 * requires "edit/delete any {bundle} media" to grant access to anyone but
 * the owner).
 *
 * The equivalent per-node-bundle grants ("edit/delete any {bundle}
 * content", for the same "empty protocols, not owner" reason via
 * MukurtuProtocolNodeAccessControlHandler) are NOT listed here - they
 * depend on which bundles actually have an enabled settings entity, so
 * they're granted dynamically by mukurtu_submissions_sync_review_permissions()
 * instead, called whenever a settings entity is saved (see
 * mukurtu_submissions_mukurtu_submission_settings_insert()/_update() in the
 * .module file) and backfilled for existing entities below.
 *
 * Used by hook_install() so a fresh install and the ongoing dynamic grants
 * cannot drift out of sync.
 */
function mukurtu_submissions_review_permissions(): array {
  $permissions = [
    'administer mukurtu submissions',
    'review mukurtu submissions',
  ];
  foreach (array_keys(MediaTypeExtensions::SUPPORTED_TYPES) as $bundle) {
    $permissions[] = "edit any $bundle media";
    $permissions[] = "delete any $bundle media";
  }
  return $permissions;
}

/**
 * Same set as mukurtu_submissions_review_permissions() minus "administer
 * mukurtu submissions" - that one is settings-page access, not needed to
 * review a submission. Used for the "mukurtu_submission_reviewer" role
 * that notify_uids members are auto-enrolled into (see
 * SubmissionSettingsCollectionForm::syncNotifyReviewerRoles()), so that
 * role and the yml it's shipped as (config/install/
 * user.role.mukurtu_submission_reviewer.yml) can't drift from what
 * administrator/mukurtu_manager already get.
 */
function mukurtu_submissions_reviewer_role_permissions(): array {
  return array_diff(mukurtu_submissions_review_permissions(), ['administer mukurtu submissions']);
}

/**
 * Implements hook_install().
 */
function mukurtu_submissions_install($is_syncing): void {
  if ($is_syncing) {
    return;
  }

  $config = \Drupal::configFactory()->getEditable('mukurtu_submissions.settings');
  if (!$config->get('service_account_uid')) {
    $account = mukurtu_submissions_create_service_account();
    $config->set('service_account_uid', (int) $account->id())->save();
  }

  foreach (['administrator', 'mukurtu_manager'] as $role_id) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($role_id);
    if (!$role || !$role->id()) {
      continue;
    }
    $changed = FALSE;
    foreach (mukurtu_submissions_review_permissions() as $permission) {
      if (!$role->hasPermission($permission)) {
        $role->grantPermission($permission);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $role->save();
    }
  }

  // Provision a disabled default submission form for every content type
  // that doesn't already have one (see
  // SubmissionFormDisplayManager::createDefaultForms()), so a fresh site
  // ends up with every eligible content type ready for a site builder to
  // review and enable, not just the config-shipped digital_heritage form.
  \Drupal::service('mukurtu_submissions.form_display_manager')->createDefaultForms();

  // Ensure shipped and newly-created settings entities (e.g.
  // digital_heritage) get their hyphenated public alias and role
  // permissions synced, in case
  // hook_mukurtu_submission_settings_insert() doesn't fire for config
  // installed directly from config/install.
  foreach (\Drupal::entityTypeManager()->getStorage('mukurtu_submission_settings')->loadMultiple() as $settings) {
    if ($settings instanceof SubmissionSettingsInterface) {
      mukurtu_submissions_ensure_path_aliases($settings);
      mukurtu_submissions_sync_submission_permission($settings);
      mukurtu_submissions_sync_review_permissions($settings);
      mukurtu_submissions_sync_entity_browser_permissions($settings);
    }
  }
}

/**
 * Creates the blocked "Submission Forms" service account.
 */
function mukurtu_submissions_create_service_account(): User {
  $account = User::create([
    'name' => 'Submission Forms',
    'mail' => 'public-submissions@' . \Drupal::request()->getHost(),
    'status' => 0,
    'pass' => \Drupal::service('password_generator')->generate(32),
  ]);
  // field_pending defaults to 1 (mukurtu_core's own approval-workflow
  // field), which would otherwise make this permanently-blocked service
  // account display as "pending" instead of "blocked" anywhere it's
  // rendered via MukurtuUserListBuilder.
  if ($account->hasField('field_pending')) {
    $account->set('field_pending', 0);
  }
  $account->save();
  return $account;
}

/**
 * Implements hook_uninstall().
 */
function mukurtu_submissions_uninstall(): void {
  $uid = \Drupal::config('mukurtu_submissions.settings')->get('service_account_uid');
  if ($uid) {
    $account = User::load($uid);
    if ($account) {
      $account->delete();
    }
  }

  // Path aliases are plain content entities, not config, so they aren't
  // cleaned up automatically the way the config this module ships is -
  // remove the ones mukurtu_submissions_ensure_path_aliases() created,
  // mirroring exactly how it computed their source paths.
  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  foreach (\Drupal::entityTypeManager()->getStorage('mukurtu_submission_settings')->loadMultiple() as $settings) {
    if (!$settings instanceof SubmissionSettingsInterface) {
      continue;
    }
    $entity_type_id = $settings->getTargetEntityTypeId();
    $bundle = $settings->getTargetBundle();
    foreach (["/submit/$entity_type_id/$bundle", "/submit/$entity_type_id/$bundle/thank-you"] as $source) {
      $alias_storage->delete($alias_storage->loadByProperties(['path' => $source]));
    }
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_submissions update hook was removed in 4.0.1. 40014 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_submissions_update_last_removed(): int {
  return 40014;
}

/**
 * Match the submission coverage map to the other content types (#2153).
 */
function mukurtu_submissions_update_40201(): ?string {
  // Keep the docblock above to one line: Drupal renders it verbatim as this
  // update's description on update.php and in `drush updatedb:status`.
  //
  // The submission form's coverage map had drifted from the six other
  // geofield_mukurtu displays: no circle drawing tool, centred on 0,0 in the
  // Gulf of Guinea rather than the shared 20,10 world view, and missing
  // singlePointZoom. The update hooks that set those values only ever touched
  // the bundles that existed when each was written, and every test named the
  // same six, so nothing ever looked at the seventh.
  //
  // 4.0.1 corrected the shipped config, which fixes new installs. This is the
  // other half.
  //
  // Each value is only changed where it still holds the old default, which
  // protects a site that moved its map somewhere meaningful. Be clear about
  // the limit of that, though: it only distinguishes intent where the
  // deliberate value differs from the old default.
  //
  // A centre of 45,-100 is obviously chosen and is left alone. A centre of 0,0
  // is indistinguishable from the old default, and drawCircle is worse still,
  // because FALSE is both the old default and the only way to express a
  // deliberate "off". Those cases are set to the shipped value regardless of
  // intent, on the same reasoning as #2160: converge on the documented default
  // and tell the operator what changed so they can put it back.
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.digital_heritage.submission');
  if (!$display) {
    return NULL;
  }

  $component = $display->getComponent('field_coverage');
  if (!$component || ($component['type'] ?? NULL) !== 'geofield_mukurtu') {
    // A site that swapped the widget has made a deliberate choice about this
    // field; nothing here applies to it.
    return NULL;
  }

  // YAML gives these back as floats, ints or strings depending on how they
  // were written, and the shipped files quote them. Compare loosely so an
  // unquoted 0.0 and a quoted '0' both count as the old default.
  $isOldDefault = static function ($value, $old): bool {
    return $value !== NULL && (string) (float) $value === (string) (float) $old;
  };

  $changed = [];
  $position = &$component['settings']['map']['map_position'];
  $toolbar = &$component['settings']['toolbar'];

  if ($isOldDefault($position['center']['lat'] ?? NULL, 0)) {
    $position['center']['lat'] = '20';
    $changed[] = 'centre latitude';
  }
  if ($isOldDefault($position['center']['lon'] ?? NULL, 0)) {
    $position['center']['lon'] = '10';
    $changed[] = 'centre longitude';
  }
  if (!isset($position['singlePointZoom'])) {
    $position['singlePointZoom'] = '12';
    $changed[] = 'single point zoom';
  }
  if (isset($toolbar['drawCircle']) && !$toolbar['drawCircle']) {
    $toolbar['drawCircle'] = TRUE;
    $changed[] = 'circle drawing tool';
  }
  unset($position, $toolbar);

  if (empty($changed)) {
    return NULL;
  }

  $display->setComponent('field_coverage', $component)->save();

  return (string) t('Updated the submission form coverage map to match the other content types: @changed. Any of these a site had already customised were left alone.', [
    '@changed' => implode(', ', $changed),
  ]);
}
