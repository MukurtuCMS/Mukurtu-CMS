<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_solr module.
 */

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_solr update hook was removed in 4.0.1. 40005 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_solr_update_last_removed(): int {
  return 40005;
}

/**
 * Adds manual ordering to the Solr Collections page.
 *
 * Indexes a display weight for each collection in the default Solr index and
 * sorts the Solr Collections page on it, after search relevance. Collections
 * are queued for reindexing so the weight is filled in.
 */
function mukurtu_solr_update_40006() {
  \Drupal::moduleHandler()->loadInclude('mukurtu_collection', 'install');
  mukurtu_collection_add_display_weight_to_index('mukurtu_default_solr_index');
  mukurtu_collection_add_display_weight_sort('mukurtu_browse_collections_solr', 'search_api_index_mukurtu_default_solr_index', 'node_title');
  \Drupal::service('mukurtu_collection.collection_order')->reindex();
}
