<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Access\AccessResult;

/**
 * Implements hook_entity_access().
 */
function mukurtu_drafts_entity_access(EntityInterface $entity, $operation, AccountInterface $account)
{
  if (!$entity instanceof FieldableEntityInterface || !$entity->hasField('moderation_state')) {
    return AccessResult::neutral();
  }

  $state = $entity->get('moderation_state')->value;
  if ($state !== 'draft') {
    return AccessResult::neutral()->addCacheableDependency($entity);
  }

  // Privileged users bypass draft visibility restrictions.
  if ($account->hasPermission('bypass node access') || $account->hasPermission('administer nodes') || $account->hasPermission('view any unpublished content')) {
    return AccessResult::neutral()
      ->addCacheableDependency($entity)
      ->cachePerPermissions();
  }

  if (method_exists($entity, 'getOwnerId') && $account->id() == $entity->getOwnerId()) {
    return AccessResult::allowed()
      ->addCacheableDependency($entity)
      ->addCacheContexts(['user']);
  }

  // Non-owners are blocked from viewing drafts; edit and delete are governed
  // by workflow transition permissions.
  if ($operation === 'view') {
    return AccessResult::forbidden()
      ->addCacheableDependency($entity)
      ->addCacheContexts(['user']);
  }

  return AccessResult::neutral()
    ->addCacheableDependency($entity)
    ->addCacheContexts(['user']);
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
function mukurtu_drafts_menu_local_tasks_alter(array &$data, string $route_name): void {
  // Remove the "Latest version" tab added by content_moderation when a node
  // has a pending draft revision. Draft state is surfaced via the banner and
  // /user/drafts instead.
  foreach ($data['tabs'] as $level => $tabs) {
    unset($data['tabs'][$level]['node.latest_version_tab']);
  }
}

/**
 * Implements hook_preprocess_node().
 */
function mukurtu_drafts_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  if (!($node instanceof FieldableEntityInterface) || !$node->hasField('moderation_state')) {
    return;
  }

  // Labels for every non-published moderation state that should display a banner.
  $banner_states = [
    'draft' => t('Draft'),
    'needs_review' => t('Awaiting Review'),
    'revision_requested' => t('Edits Needed'),
    'archived' => t('Archived'),
  ];

  $state = $node->get('moderation_state')->value;
  if (!isset($banner_states[$state])) {
    return;
  }

  $label = $banner_states[$state];
  $modifier = str_replace('_', '-', $state);

  // Content that arrived through mukurtu_submissions' public submission form
  // starts out with no Cultural Protocol and unverified data - reviewers
  // need that reminder throughout the whole pre-publish review lifecycle,
  // not just at the moment it first arrives, so this overrides the generic
  // state label for as long as an associated submission record exists
  // rather than only for the initial 'draft' state.
  $submission_states = ['draft', 'needs_review', 'revision_requested'];
  if (in_array($state, $submission_states, TRUE)
    && \Drupal::moduleHandler()->moduleExists('mukurtu_submissions')
    && mukurtu_submissions_get_submission_for_entity($node)) {
    $label = t('Submission');
    $modifier = 'submission';
  }

  // Inject a real DOM element so assistive technology announces the state.
  // CSS ::before content is unreliable in screen readers. role="status" causes
  // AT to announce the banner as a status message without moving focus.
  $variables['title_prefix']['status_banner'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#value' => $label,
    '#attributes' => [
      'class' => ['node--status-banner', 'node--status-banner--' . $modifier],
      'role' => 'status',
    ],
    '#weight' => -100,
  ];
}
