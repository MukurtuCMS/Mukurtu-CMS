<?php

use Drupal\Core\Entity\ContentEntityFormInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\mukurtu_core\Entity\FormattedTextWithTitle;
use Drupal\mukurtu_person\Entity\Person;
use Drupal\mukurtu_person\Entity\RelatedPerson;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;

/**
* @file
* Provide Mukurtu Person Type.
*/

/**
 * Implements hook_entity_bundle_info_alter().
 */
function mukurtu_person_entity_bundle_info_alter(array &$bundles)
{
  if (isset($bundles['node']['person'])) {
    $bundles['node']['person']['class'] = Person::class;
  }

  if (isset($bundles['paragraph']['formatted_text_with_title'])) {
    $bundles['paragraph']['formatted_text_with_title']['class'] = FormattedTextWithTitle::class;
  }

  if (isset($bundles['paragraph']['related_person'])) {
    $bundles['paragraph']['related_person']['class'] = RelatedPerson::class;
  }
}

/**
 * Implements hook_node_insert().
 *
 * Stores the new person's nid and title in the session so that
 * hook_page_attachments() can attach the broadcast JS on the next page load.
 * Also checks for missing reciprocal relationships on the new record.
 *
 * Uses the raw session directly, NOT PrivateTempStore, even though this is
 * exactly the kind of session-scoped data PrivateTempStore exists for -
 * PrivateTempStore's own storage key is resolved from the CURRENT USER
 * ACCOUNT, not the session itself, and a save reaching this hook may be
 * happening from inside PublicSubmissionForm::submitForm()'s
 * AccountSwitcher::switchTo(uid 1) wrapper (mukurtu_submissions' public
 * submission form is the route mukurtu_person's own "Create a new person
 * record" link now falls back to for a visitor without admin add-content
 * access - see mukurtu_person_field_widget_single_element_form_alter()).
 * Storing under PrivateTempStore in that situation would write under UID
 * 1's identity instead of the real anonymous visitor's, and the
 * broadcast would never fire - confirmed live, not just a theoretical
 * risk. A plain session is untouched by account switching.
 */
function mukurtu_person_node_insert(NodeInterface $node) {
  if ($node->bundle() !== 'person') {
    return;
  }
  \Drupal::request()->getSession()->set('mukurtu_person.new_person_broadcast', [
    'nid' => $node->id(),
    'title' => $node->label(),
  ]);
  // Lets a later submission in this same session reference this node even
  // before it's independently viewable (a fresh submission has no cultural
  // protocol assigned yet) - see PublicSubmissionForm::
  // isReferenceToSessionCreatedEntity(). Optional: mukurtu_submissions
  // isn't a hard dependency of this module.
  if (\Drupal::moduleHandler()->moduleExists('mukurtu_submissions')) {
    \Drupal::service('mukurtu_submissions.session_created_entities')
      ->record('node', (string) $node->id());
  }
  _mukurtu_person_warn_missing_reciprocals($node);
}

/**
 * Implements hook_node_update().
 *
 * Warns when a related person does not have a reciprocal relationship back.
 */
function mukurtu_person_node_update(NodeInterface $node): void {
  _mukurtu_person_warn_missing_reciprocals($node);
}

/**
 * Warns when a related person does not have a reciprocal link back.
 *
 * Fires on every save (insert and update) until the reciprocal is in place.
 *
 * Note: for each related person this loads their paragraph entities and
 * referenced nodes to check the reverse direction. Drupal's entity storage
 * caches within the request, but consider a direct entity query approach if
 * person records with large relationship graphs cause noticeably slow saves.
 */
function _mukurtu_person_warn_missing_reciprocals(NodeInterface $node): void {
  if ($node->bundle() !== 'person') {
    return;
  }

  // This is a reviewer-facing prompt (it links to the related person's own
  // edit form), meaningless - and inappropriate to show at all - for a
  // pending submission nobody has reviewed yet. \Drupal::currentUser() is
  // not a reliable "is this a real visitor" check here: a submission's
  // save happens inside PublicSubmissionForm::submitForm()'s
  // AccountSwitcher::switchTo(uid 1) wrapper, which hook_node_insert()
  // fires during, so currentUser() would report the switched-to account,
  // not the actual visitor. The node's own owner (set by
  // PublicSubmissionForm::setPendingSubmissionState() to the submissions
  // service account, regardless of account-switching state) is the
  // reliable signal - same pattern mukurtu_submissions_node_insert() uses
  // for its own equivalent check. Confirmed live: without this, the
  // warning (with the related person's real title and an edit-form link
  // the visitor can't use) appeared on the public "thank you" page.
  if (\Drupal::moduleHandler()->moduleExists('mukurtu_submissions')) {
    $service_account_uid = (int) \Drupal::config('mukurtu_submissions.settings')->get('service_account_uid');
    if ($service_account_uid && (int) $node->getOwnerId() === $service_account_uid) {
      return;
    }
  }

  foreach ($node->get('field_related_people') as $item) {
    $paragraph = $item->entity;
    if (!$paragraph) {
      continue;
    }

    /** @var \Drupal\node\NodeInterface|null $related */
    $related = $paragraph->get('field_related_person')->entity;
    if (!$related || $related->bundle() !== 'person') {
      continue;
    }

    // Check whether the related person already links back to this person.
    $has_reciprocal = FALSE;
    foreach ($related->get('field_related_people') as $back_item) {
      $back_paragraph = $back_item->entity;
      if (!$back_paragraph) {
        continue;
      }
      $back_ref = $back_paragraph->get('field_related_person')->entity;
      if ($back_ref && $back_ref->id() === $node->id()) {
        $has_reciprocal = TRUE;
        break;
      }
    }

    if (!$has_reciprocal) {
      $edit_url = Url::fromRoute('entity.node.edit_form', ['node' => $related->id()])
        ->toString();
      \Drupal::messenger()->addWarning(t(
        'Note: Relationships are created on person records separately. Do you need to add a paired relationship to: <a href=":url">@name</a>?',
        [':url' => $edit_url, '@name' => $related->label()]
      ));
    }
  }
}

/**
 * Implements hook_page_attachments().
 *
 * If a person was just created (flag set by hook_node_insert), attach the
 * broadcast JS library with the person data in drupalSettings. The library
 * fires a BroadcastChannel message that mukurtu-person-listener.js picks up
 * in any other tab currently editing a related_person paragraph.
 */
function mukurtu_person_page_attachments(array &$attachments) {
  // Raw session, not PrivateTempStore - see mukurtu_person_node_insert()'s
  // own docblock for why: this has to be readable by the visitor's own,
  // genuinely-anonymous session, matching exactly how it was written.
  $session = \Drupal::request()->getSession();
  $data = $session->get('mukurtu_person.new_person_broadcast');
  if (!$data) {
    return;
  }
  $session->remove('mukurtu_person.new_person_broadcast');

  // This attachment is entirely session-specific - safe to rely on
  // hook_page_attachments() actually running for every visitor here
  // because ThankYouController::view() (the only page this fires on with
  // anything to attach) marks its own response uncacheable, so Drupal's
  // anonymous page cache never short-circuits this hook with a stale
  // response from an earlier, unrelated visitor.
  $attachments['#attached']['library'][] = 'mukurtu_person/person_broadcast';
  $attachments['#attached']['drupalSettings']['mukurtuPerson']['newPerson'] = [
    'nid' => $data['nid'],
    'title' => $data['title'],
  ];
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * Replaces the generic entity browser cardinality message on the related person
 * field with a clearer prompt.
 */
function mukurtu_person_field_widget_single_element_form_alter(&$element, FormStateInterface $form_state, array $context) {
  $field_definition = $context['items']->getFieldDefinition();
  if ($field_definition->getName() !== 'field_related_person' || $field_definition->getTargetBundle() !== 'related_person') {
    return;
  }
  $existing_prefix = $element['entity_browser']['#prefix'] ?? '';
  $element['entity_browser']['#prefix'] = '<p>' . t('Select a related person record.') . '</p>' . $existing_prefix;

  if (isset($element['current']['#prefix'])) {
    $element['current']['#prefix'] = '';
  }

  // Pass the host node ID to hook_views_query_alter so the entity browser can
  // exclude it (preventing a person from selecting itself as a related person).
  //
  // Why TempStore: the entity browser fires on its own AJAX route
  // (/entity-browser/modal/mukurtu_content_browser), so \Drupal::routeMatch()
  // inside hook_views_query_alter reflects that route, not the person edit
  // page. TempStore is the only reliable way to carry data across that
  // request boundary.
  //
  // Known limitation: the stored value applies to ALL mukurtu_content_browser
  // entity browser opens by this user within the TTL window, not only the one
  // on this person form. Two guards limit the blast radius:
  //   1. bundle='person' check in hook_views_query_alter — only person nodes
  //      are ever excluded, never other content types.
  //   2. 1-hour TTL — the value expires well before TempStore's 7-day default,
  //      so a stale entry from an earlier edit session cannot persist.
  // A fully scoped fix (per-form-build-ID key) is tracked in the backlog.
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof ContentEntityFormInterface) {
    $host = $form_object->getEntity();
    if ($host->getEntityTypeId() === 'node' && !$host->isNew()) {
      \Drupal::service('tempstore.private')
        ->get('mukurtu_person')
        ->set('related_person_exclude', [
          'nid' => $host->id(),
          'bundle' => $host->bundle(),
          'time' => \Drupal::time()->getRequestTime(),
        ]);
    }
  }

  // Prefer the full admin add-content form for anyone who actually has
  // access to it (staff/reviewers - unchanged from before), falling back to
  // the public submission form for anyone who only has submission access
  // (e.g. an anonymous visitor, or an authenticated user on a site where
  // "person" submissions are open to any logged-in account) - without this
  // fallback, node.add's own "create person content" permission check
  // means this link (and the entire quick-create flow) never appears for
  // that entire audience, even though mukurtu_submissions/mukurtu_person's
  // per-session tempstore-backed broadcast mechanism (mukurtu_person_node_
  // insert()/_page_attachments(), mukurtu-person-listener.js) works
  // identically regardless of which form actually created the node.
  $create_url = Url::fromRoute('node.add', ['node_type' => 'person']);
  if (!$create_url->access() && \Drupal::moduleHandler()->moduleExists('mukurtu_submissions')) {
    $submission_url = Url::fromRoute('mukurtu_submissions.submit', ['entity_type_id' => 'node', 'bundle' => 'person']);
    if ($submission_url->access()) {
      $create_url = $submission_url;
    }
  }
  if ($create_url->access()) {
    $element['create_person_link'] = [
      '#type' => 'link',
      '#title' => Markup::create(
        (string) t("Can't find the person? Create a new person record.") .
        '<span class="visually-hidden"> ' . (string) t('(opens in new tab)') . '</span>'
      ),
      '#url' => $create_url,
      '#attributes' => [
        // mukurtu-person-create-link is the JS hook for the listener behavior.
        'class' => ['button', 'button--small', 'button--extrasmall', 'mukurtu-person-create-link'],
        'target' => '_blank',
        'rel' => 'noopener noreferrer',
      ],
      '#weight' => 10,
      '#attached' => [
        'library' => ['mukurtu_person/person_listener'],
      ],
    ];
    $element['create_person_help'] = [
      '#markup' => '<div class="form-item__description">' . t('A new person record form will open in a new tab. When you save that person record the tab will close and you will be redirected back here so that you can reference that new person record. Note that you will still need to add the relationship to THIS person record after saving here.') . '</div>',
      '#weight' => 11,
    ];
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Excludes the person node currently being edited from the mukurtu_content_browser
 * view so a person record cannot select itself as a related person.
 */
function mukurtu_person_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() !== 'mukurtu_content_browser' || $view->current_display !== 'entity_browser') {
    return;
  }

  // Read the exclusion written by hook_field_widget_single_element_form_alter.
  // See that hook for a full explanation of why TempStore is used here and
  // what the known limitations are.
  $data = \Drupal::service('tempstore.private')
    ->get('mukurtu_person')
    ->get('related_person_exclude');

  if (!$data || empty($data['nid']) || empty($data['bundle']) || empty($data['time'])) {
    return;
  }
  // Guard 1: only suppress person nodes, never other content types.
  if ($data['bundle'] !== 'person') {
    return;
  }
  // Guard 2: ignore values older than 1 hour (TempStore default TTL is 7 days).
  if (\Drupal::time()->getRequestTime() - $data['time'] > 3600) {
    return;
  }

  $query->addWhere('', 'node_field_data.nid', $data['nid'], '<>');
}

/**
 * Implements hook_entity_field_storage_info().
 */
function mukurtu_person_entity_field_storage_info(EntityTypeInterface $entity_type){
  if ($entity_type->id() == 'paragraph') {
    $fields = FormattedTextWithTitle::bundleFieldDefinitions($entity_type, 'formatted_text_with_title', []);
    $fields += RelatedPerson::bundleFieldDefinitions($entity_type, 'related_person', []);
    return $fields;
  }

  if ($entity_type->id() == 'node') {
    return Person::bundleFieldDefinitions($entity_type, 'person', []);
  }
}
