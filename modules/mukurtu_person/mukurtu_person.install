<?php
/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_person update hook was removed in 4.0.1. 40009 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_person_update_last_removed(): int {
  return 40009;
}

/**
 * Combines identical names in the Other Names field on Person records.
 */
function mukurtu_person_update_40201(): string {
  // Keep the docblock above to one line; see mukurtu_core_update_40201().
  // Sites that already chose their own formatter for the field are left
  // alone; only the shipped default is swapped (#2290).
  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface|null $display */
  $display = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load('node.person.full');
  $component = $display?->getComponent('field_other_names');
  if (!$component) {
    return t('The Person full display does not show Other Names, so nothing was changed.');
  }
  if ($component['type'] !== 'entity_reference_label') {
    return t('The Person full display uses a different formatter for Other Names, so it was left unchanged.');
  }
  $component['type'] = 'mukurtu_combined_term_label';
  $component['settings'] = ['link' => $component['settings']['link'] ?? TRUE];
  $display->setComponent('field_other_names', $component)->save();
  return t('Person records now show identical Other Names once.');
}
