<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_workflows module.
 */

/**
 * Implements hook_schema().
 */
function mukurtu_workflows_schema(): array {
  $schema['mukurtu_review_note'] = [
    'description' => 'Stores review notes and state-change records for nodes.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'The {node}.nid this note belongs to.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid who created this note.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the note was created.',
      ],
      'from_state' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The moderation state before the transition.',
      ],
      'to_state' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The moderation state after the transition.',
      ],
      'note' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
        'description' => 'Optional text note left by the reviewer.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'nid' => ['nid'],
    ],
  ];
  return $schema;
}

/**
 * De-link content type labels in workflow views and restrict review queue to
 * protocol/language stewards.
 */
function mukurtu_workflows_update_40001(): void {
  $config = \Drupal::configFactory()->getEditable('views.view.mukurtu_workflow_overview');
  if ($config->isNew()) {
    return;
  }

  // Disable the entity link on the Type field in all three displays.
  foreach (['my_content_in_progress', 'my_content_published', 'review_queue'] as $display_id) {
    $config->set("display.$display_id.display_options.fields.type.type", 'entity_reference_label');
    $config->set("display.$display_id.display_options.fields.type.settings", ['link' => FALSE]);
  }

  // Override access on the review_queue display with the custom plugin.
  $config->set('display.review_queue.display_options.defaults.access', FALSE);
  $config->set('display.review_queue.display_options.access', [
    'type' => 'review_queue_access',
    'options' => [],
  ]);

  $config->save();
}

/**
 * Allow contributors to re-save content as "Awaiting Review" from needs_review.
 */
function mukurtu_workflows_update_40003(): void {
  $config = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_editorial_workflow');
  if ($config->isNew()) {
    return;
  }
  $from = $config->get('type_settings.transitions.submit_for_review.from') ?? ['draft'];
  if (!in_array('needs_review', $from, TRUE)) {
    $from[] = 'needs_review';
    $config->set('type_settings.transitions.submit_for_review.from', $from);
    $config->save();
  }
}

/**
 * Make needs_review and revision_requested default revisions so content is
 * unpublished (removed from browse pages) when moved out of published state.
 */
function mukurtu_workflows_update_40004(): void {
  $config = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_editorial_workflow');
  if ($config->isNew()) {
    return;
  }
  $config->set('type_settings.states.needs_review.default_revision', TRUE);
  $config->set('type_settings.states.revision_requested.default_revision', TRUE);
  $config->save();
}

/**
 * Rename the "Revision Requested" workflow state label to "Edits Needed".
 */
function mukurtu_workflows_update_40002(): void {
  $config = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_editorial_workflow');
  if ($config->isNew()) {
    return;
  }
  $config->set('type_settings.states.revision_requested.label', 'Edits Needed');
  $config->save();
}

/**
 * Add an "archived" state to the basic content workflow, matching the
 * editorial workflow's existing archived state.
 */
function mukurtu_workflows_update_40005(): void {
  $config = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_default_content_workflow');
  if ($config->isNew()) {
    return;
  }
  $config->set('type_settings.states.archived', [
    'label' => 'Archived',
    'weight' => 2,
    'published' => FALSE,
    'default_revision' => TRUE,
  ]);
  $config->set('type_settings.transitions.archive', [
    'label' => 'Archive',
    'from' => ['published'],
    'to' => 'archived',
    'weight' => 2,
  ]);
  $config->set('type_settings.transitions.restore', [
    'label' => 'Restore to Draft',
    'from' => ['archived'],
    'to' => 'draft',
    'weight' => 3,
  ]);
  $config->save();
}

/**
 * Allow archived content to be restored directly to published (and, for the
 * editorial workflow, back to review) instead of only to draft.
 */
function mukurtu_workflows_update_40006(): void {
  $editorial = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_editorial_workflow');
  if (!$editorial->isNew()) {
    $publish_from = $editorial->get('type_settings.transitions.publish.from') ?? [];
    if (!in_array('archived', $publish_from, TRUE)) {
      $publish_from[] = 'archived';
      $editorial->set('type_settings.transitions.publish.from', $publish_from);
    }
    $return_to_review_from = $editorial->get('type_settings.transitions.return_to_review.from') ?? [];
    if (!in_array('archived', $return_to_review_from, TRUE)) {
      $return_to_review_from[] = 'archived';
      $editorial->set('type_settings.transitions.return_to_review.from', $return_to_review_from);
    }
    $editorial->save();
  }

  $default = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_default_content_workflow');
  if (!$default->isNew()) {
    $publish_from = $default->get('type_settings.transitions.publish.from') ?? [];
    if (!in_array('archived', $publish_from, TRUE)) {
      $publish_from[] = 'archived';
      $default->set('type_settings.transitions.publish.from', $publish_from);
    }
    $default->save();
  }
}

/**
 * Split bundle assignment: structural content always on the Default
 * workflow, protocol-gated content follows the active-workflow selection,
 * and landing_page is excluded from moderation entirely.
 */
function mukurtu_workflows_update_40008(): void {
  $default = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_default_content_workflow');
  $editorial = \Drupal::configFactory()->getEditable('workflows.workflow.mukurtu_editorial_workflow');
  if ($default->isNew() || $editorial->isNew()) {
    return;
  }

  $protocol_gated = ['collection', 'dictionary_word', 'digital_heritage', 'person', 'place', 'word_list'];
  $structural = ['article', 'page'];
  $known = array_merge($structural, $protocol_gated, ['landing_page']);

  $default_bundles = $default->get('type_settings.entity_types.node') ?? [];
  $editorial_bundles = $editorial->get('type_settings.entity_types.node') ?? [];

  $editorial_has_gated = (bool) array_intersect($protocol_gated, $editorial_bundles);
  $default_has_gated = (bool) array_intersect($protocol_gated, $default_bundles);
  $site_manages_gated_bundles = $editorial_has_gated || $default_has_gated;
  $editorial_active_for_gated = $editorial_has_gated && !$default_has_gated;

  \Drupal::configFactory()->getEditable('mukurtu_workflows.settings')
    ->set('active_workflow', $editorial_active_for_gated ? 'mukurtu_editorial_workflow' : 'mukurtu_default_content_workflow')
    ->save();

  $new_default = $structural;
  $new_editorial = [];
  if ($site_manages_gated_bundles) {
    if ($editorial_active_for_gated) {
      $new_editorial = $protocol_gated;
    }
    else {
      $new_default = array_merge($structural, $protocol_gated);
    }
  }

  // Preserve any bundle an admin added manually that isn't one of the
  // bundles this update recognizes, so hand-customized sites aren't
  // clobbered. landing_page is deliberately in $known so it is always
  // dropped, never preserved.
  $default_custom_extra = array_diff($default_bundles, $known);
  $editorial_custom_extra = array_diff($editorial_bundles, $known);

  $new_default = array_values(array_unique(array_merge($new_default, $default_custom_extra)));
  $new_editorial = array_values(array_unique(array_merge($new_editorial, $editorial_custom_extra)));

  $default->set('type_settings.entity_types.node', $new_default)->save();
  $editorial->set('type_settings.entity_types', $new_editorial ? ['node' => $new_editorial] : [])->save();
}

/**
 * Adds the language-fallback default_langcode filter and rendering_language
 * setting to mukurtu_workflow_overview's 3 real displays (each overrides
 * its own filters, none inherit from 'default'), per
 * docs/content-language-policy.md. Additive only.
 */
function mukurtu_workflows_update_40007(): void {
  $config_mukurtu_workflow_overview = \Drupal::configFactory()->getEditable('views.view.mukurtu_workflow_overview');
  if (!$config_mukurtu_workflow_overview->isNew()) {
    $filters_mukurtu_workflow_overview_my_content_in_progress = $config_mukurtu_workflow_overview->get('display.my_content_in_progress.display_options.filters') ?? [];
    if (!isset($filters_mukurtu_workflow_overview_my_content_in_progress['default_langcode'])) {
      $filters_mukurtu_workflow_overview_my_content_in_progress['default_langcode'] = [
        'id' => 'default_langcode',
        'table' => 'node_field_data',
        'field' => 'default_langcode',
        'relationship' => 'none',
        'group_type' => 'group',
        'admin_label' => '',
        'entity_type' => 'node',
        'entity_field' => 'default_langcode',
        'plugin_id' => 'boolean',
        'operator' => '=',
        'value' => '1',
        'group' => 1,
        'exposed' => FALSE,
        'expose' => [
          'operator_id' => '',
          'label' => '',
          'description' => '',
          'use_operator' => FALSE,
          'operator' => '',
          'operator_limit_selection' => FALSE,
          'operator_list' => [],
          'identifier' => '',
          'required' => FALSE,
          'remember' => FALSE,
          'multiple' => FALSE,
          'remember_roles' => ['authenticated' => 'authenticated'],
        ],
        'is_grouped' => FALSE,
        'group_info' => [
          'label' => '',
          'description' => '',
          'identifier' => '',
          'optional' => TRUE,
          'widget' => 'select',
          'multiple' => FALSE,
          'remember' => FALSE,
          'default_group' => 'All',
          'default_group_multiple' => [],
          'group_items' => [],
        ],
      ];
      $config_mukurtu_workflow_overview->set('display.my_content_in_progress.display_options.filters', $filters_mukurtu_workflow_overview_my_content_in_progress);
      $config_mukurtu_workflow_overview->save();
    }
    $filters_mukurtu_workflow_overview_my_content_published = $config_mukurtu_workflow_overview->get('display.my_content_published.display_options.filters') ?? [];
    if (!isset($filters_mukurtu_workflow_overview_my_content_published['default_langcode'])) {
      $filters_mukurtu_workflow_overview_my_content_published['default_langcode'] = [
        'id' => 'default_langcode',
        'table' => 'node_field_data',
        'field' => 'default_langcode',
        'relationship' => 'none',
        'group_type' => 'group',
        'admin_label' => '',
        'entity_type' => 'node',
        'entity_field' => 'default_langcode',
        'plugin_id' => 'boolean',
        'operator' => '=',
        'value' => '1',
        'group' => 1,
        'exposed' => FALSE,
        'expose' => [
          'operator_id' => '',
          'label' => '',
          'description' => '',
          'use_operator' => FALSE,
          'operator' => '',
          'operator_limit_selection' => FALSE,
          'operator_list' => [],
          'identifier' => '',
          'required' => FALSE,
          'remember' => FALSE,
          'multiple' => FALSE,
          'remember_roles' => ['authenticated' => 'authenticated'],
        ],
        'is_grouped' => FALSE,
        'group_info' => [
          'label' => '',
          'description' => '',
          'identifier' => '',
          'optional' => TRUE,
          'widget' => 'select',
          'multiple' => FALSE,
          'remember' => FALSE,
          'default_group' => 'All',
          'default_group_multiple' => [],
          'group_items' => [],
        ],
      ];
      $config_mukurtu_workflow_overview->set('display.my_content_published.display_options.filters', $filters_mukurtu_workflow_overview_my_content_published);
      $config_mukurtu_workflow_overview->save();
    }
    $filters_mukurtu_workflow_overview_review_queue = $config_mukurtu_workflow_overview->get('display.review_queue.display_options.filters') ?? [];
    if (!isset($filters_mukurtu_workflow_overview_review_queue['default_langcode'])) {
      $filters_mukurtu_workflow_overview_review_queue['default_langcode'] = [
        'id' => 'default_langcode',
        'table' => 'node_field_data',
        'field' => 'default_langcode',
        'relationship' => 'none',
        'group_type' => 'group',
        'admin_label' => '',
        'entity_type' => 'node',
        'entity_field' => 'default_langcode',
        'plugin_id' => 'boolean',
        'operator' => '=',
        'value' => '1',
        'group' => 1,
        'exposed' => FALSE,
        'expose' => [
          'operator_id' => '',
          'label' => '',
          'description' => '',
          'use_operator' => FALSE,
          'operator' => '',
          'operator_limit_selection' => FALSE,
          'operator_list' => [],
          'identifier' => '',
          'required' => FALSE,
          'remember' => FALSE,
          'multiple' => FALSE,
          'remember_roles' => ['authenticated' => 'authenticated'],
        ],
        'is_grouped' => FALSE,
        'group_info' => [
          'label' => '',
          'description' => '',
          'identifier' => '',
          'optional' => TRUE,
          'widget' => 'select',
          'multiple' => FALSE,
          'remember' => FALSE,
          'default_group' => 'All',
          'default_group_multiple' => [],
          'group_items' => [],
        ],
      ];
      $config_mukurtu_workflow_overview->set('display.review_queue.display_options.filters', $filters_mukurtu_workflow_overview_review_queue);
      $config_mukurtu_workflow_overview->save();
    }
    if (!$config_mukurtu_workflow_overview->get('display.my_content_in_progress.display_options.rendering_language')) {
      $config_mukurtu_workflow_overview->set('display.my_content_in_progress.display_options.rendering_language', '***LANGUAGE_language_content***');
      $config_mukurtu_workflow_overview->save();
    }
    if (!$config_mukurtu_workflow_overview->get('display.my_content_published.display_options.rendering_language')) {
      $config_mukurtu_workflow_overview->set('display.my_content_published.display_options.rendering_language', '***LANGUAGE_language_content***');
      $config_mukurtu_workflow_overview->save();
    }
    if (!$config_mukurtu_workflow_overview->get('display.review_queue.display_options.rendering_language')) {
      $config_mukurtu_workflow_overview->set('display.review_queue.display_options.rendering_language', '***LANGUAGE_language_content***');
      $config_mukurtu_workflow_overview->save();
    }
  }
}
