<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_protocol module.
 */

use Drupal\Core\Cache\Cache;
use Drupal\og\Og;
use Drupal\og\Entity\OgRole;

/**
 * Implements hook_schema().
 */
function mukurtu_protocol_schema() {
  $schema['mukurtu_protocol_map'] = [
    'description' => 'Mukurtu Protocol Map',
    'fields' => [
      'protocol_set_id' => [
        'description' => 'The ID of the protocol set.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'protocol_set' => [
        'description' => 'The set of protocols',
        'type' => 'text',
        'not null' => TRUE,
        'size' => 'big',
      ],
    ],
    'primary key' => [
      'protocol_set_id',
    ],
  ];

  $schema['mukurtu_protocol_access'] = [
    'description' => 'Mukurtu Protocol Access System',
    'fields' => [
      'id' => [
        'description' => 'The ID of the entity.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'entity_type_id' => [
        'description' => 'The entity type ID.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => 'en',
      ],
      'langcode' => [
        'description' => 'The language.langcode of this entity.',
        'type' => 'varchar_ascii',
        'length' => 12,
        'not null' => TRUE,
        'default' => 'en',
      ],
      'protocol_set_id' => [
        'description' => 'The ID of the protocol set',
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'grant_view' => [
        'description' => 'Boolean indicating whether a user with the protocol set can view this entity.',
        'type' => 'int',
        'size' => 'tiny',
        'default' => 0,
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'grant_update' => [
        'description' => 'Boolean indicating whether a user with the protocol set can update this entity.',
        'type' => 'int',
        'size' => 'tiny',
        'default' => 0,
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'grant_delete' => [
        'description' => 'Boolean indicating whether a user with the protocol set can delete this entity.',
        'type' => 'int',
        'size' => 'tiny',
        'default' => 0,
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
    ],
    'primary key' => ['id', 'entity_type_id', 'protocol_set_id', 'langcode'],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function mukurtu_protocol_install() {
  $groupTypes = ['community', 'protocol'];

  foreach ($groupTypes as $groupType) {
    Og::addGroup($groupType, $groupType);

    // Delete the default 'administrator' role.
    $role = OgRole::getRole($groupType, $groupType, 'administrator');
    if ($role) {
      $role->delete();
    }
  }

  // Enable community/protocol types for pathauto.
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('pathauto.settings');
  $types = $config->get('enabled_entity_types');
  $types[] = 'community';
  $types[] = 'protocol';
  $config->set('enabled_entity_types', $types);
  $config->save();
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_protocol update hook was removed in 4.0.1. 40045 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_protocol_update_last_removed(): int {
  return 40045;
}

/**
 * Set the page visibility of communities with an invalid value to Community only.
 */
function mukurtu_protocol_update_40201(): ?string {
  // Older Mukurtu 3 migrations wrote "open" or "strict", which are protocol
  // values. CommunityAccessControlHandler then hid those communities from
  // everyone. Update every revision so a revert can't bring the value back.
  $database = \Drupal::database();
  $valid = ['public', 'community-only'];
  $ids = $database->select('community_field_data', 'c')
    ->fields('c', ['id'])
    ->condition('field_access_mode', $valid, 'NOT IN')
    ->distinct()
    ->execute()
    ->fetchCol();
  foreach (['community_field_data', 'community_field_revision'] as $table) {
    $database->update($table)
      ->fields(['field_access_mode' => 'community-only'])
      ->condition('field_access_mode', $valid, 'NOT IN')
      ->execute();
  }
  if (!$ids) {
    return NULL;
  }

  \Drupal::entityTypeManager()->getStorage('community')->resetCache($ids);
  $tags = ['community_list'];
  foreach ($ids as $id) {
    $tags[] = 'community:' . $id;
  }
  Cache::invalidateTags($tags);

  return (string) t('Set @count communities to Community only.', ['@count' => count($ids)]);
}

/**
 * Delete memberships in communities and protocols that no longer exist.
 */
function mukurtu_protocol_update_40202(): ?string {
  // Deleting a community or protocol used to leave its memberships behind.
  $database = \Drupal::database();
  $ids = [];
  foreach (['community', 'protocol'] as $group_type) {
    // og_membership.entity_id is a string, so compare in PHP rather than
    // joining it to the integer group ID.
    $existing = array_flip($database->select($group_type, 'g')
      ->fields('g', ['id'])
      ->execute()
      ->fetchCol());
    $memberships = $database->select('og_membership', 'm')
      ->fields('m', ['id', 'entity_id'])
      ->condition('entity_type', $group_type)
      ->execute()
      ->fetchAllKeyed();
    foreach ($memberships as $membership_id => $group_id) {
      if (!isset($existing[$group_id])) {
        $ids[] = $membership_id;
      }
    }
  }
  if (!$ids) {
    return NULL;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('og_membership');
  foreach (array_chunk($ids, 50) as $chunk) {
    $storage->delete($storage->loadMultiple($chunk));
  }

  return (string) t('Deleted @count memberships.', ['@count' => count($ids)]);
}
