<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_dictionary module.
 */

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function mukurtu_dictionary_install() {
  // Grant dictionary glossary order permission to mukurtu_manager role.
  $role = Role::load('mukurtu_manager');
  if ($role) {
    $role->grantPermission('administer dictionary glossary order');
    $role->save();
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_dictionary update hook was removed in 4.0.1. 40044 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_dictionary_update_last_removed(): int {
  return 40044;
}

/**
 * Stop exposing the duplicate, unlabeled Glossary Entry facet as a filter.
 */
function mukurtu_dictionary_update_40045() {
  // facets_field_glossary_entry must stay in the view: for a views_block
  // facet source, Facets only computes a field's aggregation when some
  // filter's query() runs the matching query type plugin
  // (FacetsFilter::query(), in facets_exposed_filters) - a facet_block
  // placement alone, like the standalone glossary_entry facet the Dictionary
  // controller renders separately, never triggers that. Unsetting the filter
  // entirely (as an earlier version of this hook did) silently broke that
  // standalone facet along with the stray exposed widget. Setting exposed to
  // FALSE keeps the query registration alive while rendering no filter of
  // its own.
  $config = \Drupal::configFactory()->getEditable('views.view.mukurtu_dictionary');
  if ($config->isNew()) {
    return;
  }

  $changed = FALSE;

  $filters = $config->get('display.default.display_options.filters');
  if (is_array($filters) && !empty($filters['facets_field_glossary_entry']['exposed'])) {
    $filters['facets_field_glossary_entry']['exposed'] = FALSE;
    $config->set('display.default.display_options.filters', $filters);
    $changed = TRUE;
  }

  $bef_filters = $config->get('display.default.display_options.exposed_form.options.bef.filter');
  if (is_array($bef_filters) && isset($bef_filters['facets_field_glossary_entry'])) {
    unset($bef_filters['facets_field_glossary_entry']);
    $config->set('display.default.display_options.exposed_form.options.bef.filter', $bef_filters);
    $changed = TRUE;
  }

  if ($changed) {
    $config->save(TRUE);
  }
}
