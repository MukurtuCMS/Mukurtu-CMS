<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_dictionary module.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function mukurtu_dictionary_install() {
  // Grant dictionary glossary order permission to mukurtu_manager role.
  $role = Role::load('mukurtu_manager');
  if ($role) {
    $role->grantPermission('administer dictionary glossary order');
    $role->save();
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_dictionary update hook was removed in 4.0.1. 40044 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_dictionary_update_last_removed(): int {
  return 40044;
}

/**
 * Stop exposing the duplicate, unlabeled Glossary Entry facet as a filter.
 */
function mukurtu_dictionary_update_40045() {
  // facets_field_glossary_entry must stay in the view: for a views_block
  // facet source, Facets only computes a field's aggregation when some
  // filter's query() runs the matching query type plugin
  // (FacetsFilter::query(), in facets_exposed_filters) - a facet_block
  // placement alone, like the standalone glossary_entry facet the Dictionary
  // controller renders separately, never triggers that. Unsetting the filter
  // entirely (as an earlier version of this hook did) silently broke that
  // standalone facet along with the stray exposed widget. Setting exposed to
  // FALSE keeps the query registration alive while rendering no filter of
  // its own.
  $config = \Drupal::configFactory()->getEditable('views.view.mukurtu_dictionary');
  if ($config->isNew()) {
    return;
  }

  $changed = FALSE;

  $filters = $config->get('display.default.display_options.filters');
  if (is_array($filters) && !empty($filters['facets_field_glossary_entry']['exposed'])) {
    $filters['facets_field_glossary_entry']['exposed'] = FALSE;
    $config->set('display.default.display_options.filters', $filters);
    $changed = TRUE;
  }

  $bef_filters = $config->get('display.default.display_options.exposed_form.options.bef.filter');
  if (is_array($bef_filters) && isset($bef_filters['facets_field_glossary_entry'])) {
    unset($bef_filters['facets_field_glossary_entry']);
    $config->set('display.default.display_options.exposed_form.options.bef.filter', $bef_filters);
    $changed = TRUE;
  }

  if ($changed) {
    $config->save(TRUE);
  }
}

/**
 * Ignore apostrophes and similar marks inside words when searching.
 */
function mukurtu_dictionary_update_40046() {
  mukurtu_search_enable_ignore_character_processor('mukurtu_dictionary_index');
}

/**
 * Grant Mukurtu managers permission to set the dictionary glossary order.
 */
function mukurtu_dictionary_update_40047() {
  // mukurtu_dictionary_install() grants this too, but during a profile
  // install the module installs before the profile's mukurtu_manager role
  // config exists, so that grant was silently skipped.
  $role = Role::load('mukurtu_manager');
  if (!$role) {
    return;
  }
  $role->grantPermission('administer dictionary glossary order');
  $role->save();
}

/**
 * Make sample sentences collapsible on the dictionary word edit form.
 */
function mukurtu_dictionary_update_40048() {
  // Only displays still on the legacy widget are switched, so a site that
  // already picked a different widget keeps it.
  foreach (['node.dictionary_word.default', 'paragraph.dictionary_word_entry.default'] as $display_id) {
    $display = EntityFormDisplay::load($display_id);
    $component = $display?->getComponent('field_sample_sentences');
    if (($component['type'] ?? NULL) !== 'entity_reference_paragraphs') {
      continue;
    }
    $display->setComponent('field_sample_sentences', [
      'type' => 'paragraphs',
      'weight' => $component['weight'] ?? 0,
      'region' => $component['region'] ?? 'content',
      'settings' => [
        'title' => 'Sample Sentence',
        'title_plural' => 'Sample Sentences',
        'edit_mode' => 'open',
        'closed_mode' => 'summary',
        'autocollapse' => 'none',
        'closed_mode_threshold' => 0,
        'add_mode' => 'dropdown',
        'form_display_mode' => 'default',
        'default_paragraph_type' => '',
        'features' => [
          'collapse_edit_all' => 'collapse_edit_all',
          'duplicate' => 'duplicate',
        ],
      ],
      'third_party_settings' => [],
    ])->save();
  }
}

/**
 * Let the dictionary's Keywords, Language and Word type facets show nesting.
 */
function mukurtu_dictionary_update_40049(array &$sandbox): ?string {
  // Keep the docblock above to one line: Drupal renders it verbatim as this
  // update's description on update.php and in `drush updatedb:status`.
  //
  // As in mukurtu_browse_update_40024(), the facets move from term names to
  // term ID fields so they can nest (#2522), and words are reindexed here.
  // Numbered 40049 because 40048 is the paragraph summaries update (#2590).
  $indexed = \Drupal::service('mukurtu_search.nested_term_facets')->updateShippedFacets(
    $sandbox,
    \Drupal::service('extension.list.module')->getPath('mukurtu_dictionary') . '/config/install',
    'mukurtu_dictionary_index',
    ['keyword_tid', 'language_tid', 'word_type_tid'],
    [
      'mukurtu_dictionary' => [
        'facets_keyword' => ['facets_keyword', 'facets_keyword_tid'],
        'facets_language' => ['facets_language', 'facets_language_tid'],
        'facets_word_type' => ['facets_word_type', 'facets_word_type_tid'],
      ],
    ],
  );
  if ($indexed === NULL) {
    return NULL;
  }
  return (string) \Drupal::translation()->formatPlural($indexed,
    'The dictionary Keywords, Language and Word type facets now show nested terms. Reindexed 1 item.',
    'The dictionary Keywords, Language and Word type facets now show nested terms. Reindexed @count items.'
  );
}
