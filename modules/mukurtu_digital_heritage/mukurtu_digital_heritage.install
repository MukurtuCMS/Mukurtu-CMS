<?php
/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_digital_heritage update hook was removed in 4.0.1. 40009 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_digital_heritage_update_last_removed(): int {
  return 40009;
}

/**
 * Remove the title from the digital heritage sidebar, since it repeats the page title (#598).
 */
function mukurtu_digital_heritage_update_40010(): void {
  // Keep the docblock above to one line; see mukurtu_core_update_40201().
  // Only the shipped placement is removed. A site that moved Title out of
  // the sidebar group chose to show it somewhere, so it is left alone.
  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface|null $display */
  $display = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load('node.digital_heritage.full');
  $group = $display?->getThirdPartySetting('field_group', 'group_sidebar_mukurtu_fields');
  if (!$group || !in_array('field_title', $group['children'] ?? [], TRUE)) {
    return;
  }
  $group['children'] = array_values(array_diff($group['children'], ['field_title']));
  $display->setThirdPartySetting('field_group', 'group_sidebar_mukurtu_fields', $group);
  $display->removeComponent('field_title')->save();
}
