<?php

use Drupal\Core\Config\FileStorage;

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_landing_page update hook was removed in 4.0.1. 40006 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_landing_page_update_last_removed(): int {
  return 40006;
}

/**
 * Ships translatable landing page block headings; existing homepages keep their current layout until reverted to defaults.
 */
function mukurtu_landing_page_update_40201(): string {
  $config_factory = \Drupal::configFactory();
  $display_config = $config_factory->getEditable('core.entity_view_display.' . \Drupal\mukurtu_landing_page\DefaultLandingPage::DISPLAY_ID);
  if ($display_config->isNew()) {
    return t('No landing_page default display found; nothing to update.');
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('mukurtu_landing_page');
  $shipped = (new FileStorage($module_path . '/config/install'))
    ->read('core.entity_view_display.node.landing_page.default');
  $sections = $shipped['third_party_settings']['layout_builder']['sections'] ?? [];
  if (empty($sections[0]['components'])) {
    return t('Shipped landing_page display config has no Layout Builder sections; nothing to update.');
  }

  // Point the shipped hero/featured components at this site's own blocks
  // (tracked since the original install), not the fresh-install placeholders.
  $state_uuids = \Drupal::state()->get('mukurtu_landing_page.default_blocks', []);
  $block_storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $unresolved = [];

  $hero_uuid = $state_uuids['hero'] ?? NULL;
  $hero_block = $hero_uuid ? current($block_storage->loadByProperties(['uuid' => $hero_uuid])) : NULL;
  if ($hero_block) {
    $sections[0]['components'][\Drupal\mukurtu_landing_page\DefaultLandingPage::HERO_COMPONENT_UUID]['configuration']['id'] = 'block_content:' . $hero_block->uuid();
  }
  else {
    $unresolved[] = 'hero';
  }

  $featured_uuid = $state_uuids['featured'] ?? NULL;
  $featured_block = $featured_uuid ? current($block_storage->loadByProperties(['uuid' => $featured_uuid])) : NULL;
  if ($featured_block) {
    $sections[0]['components'][\Drupal\mukurtu_landing_page\DefaultLandingPage::FEATURED_COMPONENT_UUID]['configuration']['block_id'] = (int) $featured_block->id();
    $sections[0]['components'][\Drupal\mukurtu_landing_page\DefaultLandingPage::FEATURED_COMPONENT_UUID]['configuration']['block_revision_id'] = (int) $featured_block->getRevisionId();
  }
  else {
    $unresolved[] = 'featured';
  }

  $display_config
    ->set('third_party_settings.layout_builder.sections', $sections)
    ->save();

  if ($unresolved) {
    return t('Landing page display defaults updated, but could not resolve this site\'s own %blocks block(s) - check core.entity_view_display.node.landing_page.default manually. Existing homepage nodes are unaffected; use "Revert to defaults" on a node\'s Layout tab to pick up the new translatable headings.', ['%blocks' => implode(', ', $unresolved)]);
  }

  return t('Landing page display defaults updated with translatable block headings. Existing homepage nodes keep their current layout; use "Revert to defaults" on a node\'s Layout tab to pick up the change.');
}

/**
 * Points the Landing Pages URL alias pattern at the landing_page content type instead of page; existing landing pages get an alias on their next save.
 */
function mukurtu_landing_page_update_40202(): string {
  /** @var \Drupal\pathauto\PathautoPatternInterface|null $pattern */
  $pattern = \Drupal::entityTypeManager()->getStorage('pathauto_pattern')->load('landing_pages');
  if (!$pattern) {
    return t('No Landing Pages URL alias pattern found; nothing to update.');
  }

  // The shipped pattern was copied from the Basic Pages one and never had its
  // bundle changed (#2208). Only rewrite that exact shipped value, so a site
  // that has since customised the pattern's conditions is left alone.
  $criteria = $pattern->get('selection_criteria') ?? [];
  $changed = FALSE;
  foreach ($criteria as $uuid => $criterion) {
    if (($criterion['id'] ?? '') === 'entity_bundle:node' && ($criterion['bundles'] ?? []) === ['page' => 'page']) {
      $criteria[$uuid]['bundles'] = ['landing_page' => 'landing_page'];
      $changed = TRUE;
    }
  }
  if (!$changed) {
    return t('Landing Pages URL alias pattern does not have the shipped "page" bundle condition; nothing to update.');
  }

  $pattern->set('selection_criteria', $criteria)->save();
  return t('Landing Pages URL alias pattern now targets the landing_page content type. Existing landing pages keep their current URLs until they are next saved.');
}

/**
 * Correct which blocks landing pages offer in Layout Builder.
 */
function mukurtu_landing_page_update_40203(): string {
  $config = \Drupal::configFactory()
    ->getEditable('core.entity_view_display.node.landing_page.default');
  $settings = $config->get('third_party_settings.layout_builder_restrictions.entity_view_mode_restriction');

  // Nothing to widen if this site never had the restrictions in the first
  // place: with no settings at all, Layout Builder Restrictions bails out and
  // every block is already available.
  if (empty($settings)) {
    return (string) t('Landing page block restrictions are not configured on this site; nothing to change.');
  }

  $changes = [];

  // The three image-with-description bundles were missing from the "Inline
  // blocks" allowlist, so a site builder could place the pre-created hero
  // blocks but never build a new one. Only extend an allowlist that already
  // exists - if the key is absent the category is unrestricted, and adding it
  // would take availability away instead of granting it.
  $inline = $settings['allowlisted_blocks']['Inline blocks'] ?? NULL;
  if (is_array($inline)) {
    $heroes = [
      'inline_block:full_image_with_description',
      'inline_block:image_with_description',
      'inline_block:vertical_image_with_description',
    ];
    $added = array_diff($heroes, $inline);
    if ($added) {
      $inline = array_merge($inline, $added);
      sort($inline);
      $settings['allowlisted_blocks']['Inline blocks'] = array_values($inline);
      $changes[] = (string) t('Added the hero blocks to the landing page inline block allowlist.');
    }
  }

  // "Mukurtu" is absent from allowed_block_categories, which Layout Builder
  // Restrictions enforces as a fallback, so every block in that category was
  // stripped from the Layout UI - including Browse by Community, which ships
  // on the default homepage and could not be re-added once removed. Allowlist
  // that one block rather than opening the whole category: the others are a
  // node-context sidebar block, a search-page toggle, and the dashboard setup
  // checklist, none of which belong on a landing page.
  $categories = $config->get('third_party_settings.layout_builder_restrictions.allowed_block_categories') ?? [];
  if (!isset($settings['allowlisted_blocks']['Mukurtu']) && !in_array('Mukurtu', $categories, TRUE)) {
    $settings['allowlisted_blocks']['Mukurtu'] = ['mukurtu_browse_by_community'];
    $changes[] = (string) t('Restored the Browse by Community block for landing pages.');
  }

  // The legacy browse_by_community view filters on published status and
  // langcode only - it has no visibility filter, so it lists communities whose
  // sharing setting is "community-only" to everyone. The
  // mukurtu_browse_by_community block plugin allowlisted above is the fixed
  // implementation (see issue #1005) and is what the default homepage places.
  // Stop offering the view so authors cannot build that disclosure path.
  //
  // This only changes what the Layout UI offers. Restrictions are not applied
  // retroactively, so a landing page that already has the view block keeps
  // rendering it.
  $views = $settings['allowlisted_blocks']['Lists (Views)'] ?? NULL;
  $legacy = 'views_block:browse_by_community-community_browse_block';
  if (is_array($views) && in_array($legacy, $views, TRUE)) {
    $settings['allowlisted_blocks']['Lists (Views)'] = array_values(array_diff($views, [$legacy]));
    $changes[] = (string) t('Stopped offering the legacy Browse by Community view, which ignored community visibility.');
  }

  if (!$changes) {
    return (string) t('Landing page block restrictions were already up to date.');
  }

  $config
    ->set('third_party_settings.layout_builder_restrictions.entity_view_mode_restriction', $settings)
    ->save();

  return implode(' ', $changes);
}

/**
 * Offer the names-only Browse by Category block on landing pages.
 */
function mukurtu_landing_page_update_40204(): string {
  $config = \Drupal::configFactory()
    ->getEditable('core.entity_view_display.node.landing_page.default');
  $views = $config->get('third_party_settings.layout_builder_restrictions.entity_view_mode_restriction.allowlisted_blocks.Lists (Views)');

  // Only extend an allowlist that already exists. If the key is absent the
  // category is unrestricted, and adding it would take the other view blocks
  // away instead of offering a new one. See
  // mukurtu_landing_page_update_40203().
  $block = 'views_block:mukurtu_categories-browse_by_category_names_block';
  if (!is_array($views) || in_array($block, $views, TRUE)) {
    return (string) t('Landing page block restrictions were already up to date.');
  }

  $views[] = $block;
  sort($views);
  $config
    ->set('third_party_settings.layout_builder_restrictions.entity_view_mode_restriction.allowlisted_blocks.Lists (Views)', $views)
    ->save();

  return (string) t('Landing pages now offer the Browse by Category (names only) block.');
}

/**
 * Hides the Custom block category and the Mukurtu Footer block from the landing page block chooser.
 */
function mukurtu_landing_page_update_40205(): string {
  $config = \Drupal::configFactory()
    ->getEditable('core.entity_view_display.node.landing_page.default');
  $settings = $config->get('third_party_settings.layout_builder_restrictions.entity_view_mode_restriction');

  // With no settings at all, Layout Builder Restrictions bails out and every
  // block is offered. Restricting two of them here would be the first
  // restriction this site has, so leave that decision to the site builder.
  if (empty($settings)) {
    return (string) t('Landing page block restrictions are not configured on this site; nothing to change.');
  }

  $changes = [];

  // Layout Builder Restrictions renames the "Custom" category to "Custom
  // blocks" before comparing it against restricted_categories, so a
  // restriction stored as "Custom" never matched. That let the Consent Popup
  // and Mukurtu Footer plugin blocks through to the landing page chooser.
  //
  // Skip sites with per-block "Custom blocks" rules: the module then files
  // every reusable content block under "Custom blocks" too, and restricting
  // that category would hide all of them.
  $restricted = $settings['restricted_categories'] ?? [];
  $per_block_rules = isset($settings['allowlisted_blocks']['Custom blocks']) || isset($settings['denylisted_blocks']['Custom blocks']);
  if (in_array('Custom', $restricted, TRUE) && !$per_block_rules) {
    $restricted = array_values(array_diff($restricted, ['Custom']));
    if (!in_array('Custom blocks', $restricted, TRUE)) {
      $restricted[] = 'Custom blocks';
    }
    $settings['restricted_categories'] = $restricted;
    $changes[] = (string) t('Hid the Custom block category from landing pages.');
  }

  // The footer is a reusable content block, so it was offered in the "Content
  // block" category alongside the homepage hero blocks. It belongs in the
  // footer region only, which the mukurtu_footer plugin block already handles.
  // Reusable content blocks are checked by bundle under "Custom block types".
  $denied = $settings['denylisted_blocks']['Custom block types'] ?? [];
  if (!in_array('mukurtu_footer', $denied, TRUE)) {
    $denied[] = 'mukurtu_footer';
    $settings['denylisted_blocks']['Custom block types'] = $denied;
    $changes[] = (string) t('Hid the Mukurtu Footer content block from landing pages.');
  }

  if (!$changes) {
    return (string) t('Landing page block restrictions were already up to date.');
  }

  $config
    ->set('third_party_settings.layout_builder_restrictions.entity_view_mode_restriction', $settings)
    ->save();

  return implode(' ', $changes);
}
