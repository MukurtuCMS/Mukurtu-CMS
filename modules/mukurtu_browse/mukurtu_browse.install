/**
 * Add multipage page delta and community record flag fields to the content index.
 */
function mukurtu_browse_update_40009() {
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if (!$index) {
    return;
  }

  // Add processors first via the entity so they are saved together with fields.
  $processors = $index->getProcessors();
  foreach (['mukurtu_multipage_page_index', 'mukurtu_community_record_flag'] as $processor_id) {
    if (!isset($processors[$processor_id])) {
      $processor_manager = \Drupal::service('plugin.manager.search_api.processor');
      $processor = $processor_manager->createInstance($processor_id, ['#index' => $index]);
      $processors[$processor_id] = $processor;
    }
  }
  $index->setProcessors($processors);

  $new_fields = [
    'multipage_page_delta' => [
      'type' => 'integer',
      'property_path' => 'multipage_page_delta',
      'datasource_id' => 'entity:node',
      'label' => 'Multipage page delta',
    ],
    'is_community_record' => [
      'type' => 'boolean',
      'property_path' => 'is_community_record',
      'datasource_id' => 'entity:node',
      'label' => 'Is community record',
    ],
  ];

  foreach ($new_fields as $field_id => $field_config) {
    if (!$index->getField($field_id)) {
      $field = new \Drupal\search_api\Item\Field($index, $field_id);
      $field->setType($field_config['type']);
      $field->setPropertyPath($field_config['property_path']);
      $field->setDatasourceId($field_config['datasource_id']);
      $field->setLabel($field_config['label']);
      $index->addField($field);
    }
  }

  $index->save();
  $index->reindex();
}

/**
 * Replace multipage_page_delta (integer) with is_additional_mpi_page (boolean).
 *
 * The original integer field used a < 1 comparison which silently passed all
 * items when the processor query found no rows. The boolean field mirrors the
 * community record pattern and is unambiguous.
 */
function mukurtu_browse_update_40010() {
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if (!$index) {
    return;
  }

  // Remove the old integer field if present.
  if ($index->getField('multipage_page_delta')) {
    $index->removeField('multipage_page_delta');
  }

  // Add the replacement boolean field.
  if (!$index->getField('is_additional_mpi_page')) {
    $field = new \Drupal\search_api\Item\Field($index, 'is_additional_mpi_page');
    $field->setType('boolean');
    $field->setPropertyPath('is_additional_mpi_page');
    $field->setDatasourceId('entity:node');
    $field->setLabel('Is additional multipage item page');
    $index->addField($field);
  }

  $index->save();
  $index->reindex();
}

/**
 * Add sections body text field to the default content index.
 */
function mukurtu_browse_update_40011(): void {
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if (!$index) {
    return;
  }

  if (!$index->getField('field_sections_body')) {
    $field = new \Drupal\search_api\Item\Field($index, 'field_sections_body');
    $field->setType('text');
    $field->setPropertyPath('aggregated_field');
    $field->setLabel('Sections Body Text');
    $field->setConfiguration([
      'type' => 'union',
      'fields' => ['entity:node/field_sections:entity:field_body'],
    ]);
    $index->addField($field);
  }

  // Register with ignorecase, which has all_fields: false and requires explicit registration.
  $processors = $index->getProcessors();
  if (isset($processors['ignorecase'])) {
    $config = $processors['ignorecase']->getConfiguration();
    if (!in_array('field_sections_body', $config['fields'])) {
      $config['fields'][] = 'field_sections_body';
      $processors['ignorecase']->setConfiguration($config);
      $index->setProcessors($processors);
    }
  }

  $index->save();
  $index->reindex();
}

/**
 * Show the representative media field in Map mode for dictionary_word and
 * word_list, which was hidden and left their map_browse Twig templates
 * unable to display it, show field_summary and field_in_collection in
 * digital_heritage's List mode -- field_summary's own field description
 * says it should appear in previews -- and show field_summary in
 * digital_heritage's Map mode too (#1624).
 */
function mukurtu_browse_update_40012(): void {
  $config_source = new \Drupal\Core\Config\FileStorage(
    \Drupal::service('extension.list.module')->getPath('mukurtu_browse') . '/config/install'
  );
  $config_factory = \Drupal::configFactory();

  foreach ([
    'node.dictionary_word.map_browse',
    'node.word_list.map_browse',
    'node.digital_heritage.browse',
    'node.digital_heritage.map_browse',
  ] as $name) {
    $config_name = 'core.entity_view_display.' . $name;
    $data = $config_source->read($config_name);
    if ($data) {
      $config_factory->getEditable($config_name)->setData($data)->save(TRUE);
    }
  }
}

/**
 * Enable the Leaflet "Reset View" recenter control on the Map mode of
 * /browse, /digital-heritage, and the homepage map browse block, so users
 * who pan/zoom away from the initial extent have a way back (#1624).
 */
function mukurtu_browse_update_40013(): void {
  $displays = [
    'views.view.mukurtu_browse' => 'mukurtu_browse_block_map',
    'views.view.mukurtu_digital_heritage_browse' => 'mukurtu_digital_heritage_browse_block_map',
    'views.view.mukurtu_browse_by_map' => 'map_block',
  ];

  foreach ($displays as $config_name => $display_id) {
    $config = \Drupal::configFactory()->getEditable($config_name);
    if ($config->isNew()) {
      continue;
    }
    $key = "display.$display_id.display_options.style.options.reset_map.control";
    if ($config->get($key) !== NULL) {
      $config->set($key, TRUE)->save();
    }
  }
}

/**
 * Fix /browse's Map mode popups, which rendered every named content type
 * using Drupal's ":default" view mode instead of the dedicated map_browse
 * teaser mode -- the view_modes mapping had the two inverted (#1624).
 */
function mukurtu_browse_update_40014(): void {
  $config = \Drupal::configFactory()->getEditable('views.view.mukurtu_browse');
  if ($config->isNew()) {
    return;
  }
  $prefix = 'display.mukurtu_browse_block_map.display_options.row.options.view_modes.entity:node.';
  if ($config->get($prefix . ':default') === NULL) {
    return;
  }
  $config->set($prefix . ':default', 'default');
  foreach (['article', 'collection', 'dictionary_word', 'digital_heritage', 'page', 'person', 'place', 'word_list'] as $bundle) {
    $config->set($prefix . $bundle, 'map_browse');
  }
  $config->save();
}

/**
 * Make the homepage "Browse by Map" block render its popups the same way
 * as /browse's Map mode, instead of its own diverging popup size, zoom
 * limit, and rendering path (#1624).
 */
function mukurtu_browse_update_40015(): void {
  $config_source = new \Drupal\Core\Config\FileStorage(
    \Drupal::service('extension.list.module')->getPath('mukurtu_browse') . '/config/install'
  );
  $config_name = 'views.view.mukurtu_browse_by_map';
  $data = $config_source->read($config_name);
  if ($data) {
    \Drupal::configFactory()->getEditable($config_name)->setData($data)->save(TRUE);
  }
}

/**
 * NOTE on installDefaultConfig('module', 'mukurtu_browse') below:
 *
 * config/install/search_api.index.mukurtu_default_content_index.yml
 * intentionally omits the mukurtu_multipage_page_index /
 * mukurtu_community_record_flag processors and their is_additional_mpi_page /
 * is_community_record fields (they cause an UnmetDependenciesException on
 * fresh installs, since mukurtu_multipage_items/mukurtu_community_records
 * install after mukurtu_browse). Existing sites instead get them via
 * mukurtu_browse_update_40009()/_40010(), _mukurtu_browse_ensure_processor_on_index(),
 * or mukurtu_install().
 *
 * installDefaultConfig() does not merge into the live index config, it
 * overwrites it wholesale from that YAML (see
 * ConfigInstaller::createConfiguration()). update_40016-_40018 below did
 * exactly that and silently stripped both fields/processors back off
 * mukurtu_default_content_index on every already-updated site, which is what
 * broke the MPI/CR browse toggles (issue #2022, fixed forward in
 * update_40019). Any *new* update hook that reinstalls this module's default
 * config must re-apply both via _mukurtu_browse_ensure_processor_on_index()
 * afterward, the same way update_40019 does.
 */

/**
 * Add LC Project and LC Label facets to /browse and /digital-heritage.
 */
function mukurtu_browse_update_40016(): void {
  // Import updated Search API index and Views configurations.
  $config_installer = \Drupal::service('config.installer');
  $config_installer->installDefaultConfig('module', 'mukurtu_browse');

  // Reindex the affected Search API index.
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if ($index) {
    $index->reindex();
  }
}

/**
 * Make the LC Label facet also match content via an applied LC Project.
 */
function mukurtu_browse_update_40017(): void {
  // Import the updated Search API index configuration (repoints the Local
  // Contexts Label field at the new effective-labels processor property).
  $config_installer = \Drupal::service('config.installer');
  $config_installer->installDefaultConfig('module', 'mukurtu_browse');

  // Reindex so existing content picks up project-inherited labels/notices.
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if ($index) {
    $index->reindex();
  }
}

/**
 * Make the LC Project facet also match content via an individually-applied
 * LC label/notice belonging to that project.
 */
function mukurtu_browse_update_40018(): void {
  // Import the updated Search API index configuration (repoints the Local
  // Contexts Project field at the new effective-projects processor
  // property).
  $config_installer = \Drupal::service('config.installer');
  $config_installer->installDefaultConfig('module', 'mukurtu_browse');

  // Reindex so existing content picks up label-inherited projects.
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if ($index) {
    $index->reindex();
  }
}

/**
 * Restore the MPI/CR search index fields stripped by update_40016-_40018.
 *
 * Those hooks each called installDefaultConfig('module', 'mukurtu_browse'),
 * which overwrites mukurtu_default_content_index wholesale from
 * config/install and silently removed the mukurtu_multipage_page_index /
 * mukurtu_community_record_flag processors and their is_additional_mpi_page /
 * is_community_record fields, breaking the "Show all pages" and community
 * record browse toggles (issue #2022). Re-applies both via the same helper
 * the CR/MPI settings forms already use; a no-op on sites where they're
 * already present.
 */
function mukurtu_browse_update_40019(): void {
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if (!$index) {
    return;
  }

  _mukurtu_browse_ensure_processor_on_index(
    $index,
    'mukurtu_multipage_page_index',
    'is_additional_mpi_page',
    'Is additional multipage item page',
    'boolean'
  );

  _mukurtu_browse_ensure_processor_on_index(
    $index,
    'mukurtu_community_record_flag',
    'is_community_record',
    'Is community record',
    'boolean'
  );
}

/**
 * Adds the language-fallback default_langcode... language_with_fallback filter
 * to the 5 mukurtu_browse-owned Search API views, per
 * docs/content-language-policy.md, and defensively removes the old
 * search_api_language filter from the 4 that had one - only if it still
 * matches the exact shape originally shipped, so a site's own
 * customization of that filter is never clobbered. Additive/defensive
 * only, never forces a change a site doesn't already match.
 */
function mukurtu_browse_update_40020(): void {
  $config_mukurtu_browse = \Drupal::configFactory()->getEditable('views.view.mukurtu_browse');
  if (!$config_mukurtu_browse->isNew()) {
