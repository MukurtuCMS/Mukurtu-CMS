<?php

/**
 * @file
 * Install, update and uninstall functions for the Mukurtu Browse module.
 */

use Drupal\search_api\Entity\Index;

/**
 * Implements hook_install().
 */
function mukurtu_browse_install() {
  mukurtu_search_rebuild_index();
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_browse update hook was removed in 4.0.1. 40021 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_browse_update_last_removed(): int {
  return 40021;
}

/**
 * Ignore apostrophes and similar marks inside words when searching.
 */
function mukurtu_browse_update_40022() {
  mukurtu_search_enable_ignore_character_processor('mukurtu_default_content_index');
}

/**
 * Reindex search so SoundCloud and remote video count as Audio and Video.
 */
function mukurtu_browse_update_40023() {
  foreach (Index::loadMultiple() as $index) {
    if (!$index->status()) {
      continue;
    }
    foreach ($index->getFields() as $field) {
      if ($field->getDatasourceId() === 'entity:node' && $field->getPropertyPath() === 'field_media_assets:entity:bundle') {
        $index->reindex();
        break;
      }
    }
  }
}

/**
 * Let the Category and Keywords browse facets show nested terms.
 */
function mukurtu_browse_update_40024(array &$sandbox): ?string {
  // Keep the docblock above to one line: Drupal renders it verbatim as this
  // update's description on update.php and in `drush updatedb:status`.
  //
  // The facets used term names, which can't nest and merge terms that share a
  // name (#2522). They now use term ID fields, and the hierarchy processor
  // indexes each term's ancestors, so choosing a parent finds content tagged
  // with terms nested under it. Content is reindexed here, so the facets work
  // as soon as the update finishes. A facet a site changed is left alone.
  $indexed = \Drupal::service('mukurtu_search.nested_term_facets')->updateShippedFacets(
    $sandbox,
    \Drupal::service('extension.list.module')->getPath('mukurtu_browse') . '/config/install',
    'mukurtu_default_content_index',
    ['category_tid', 'keywords_tid'],
    [
      'mukurtu_browse' => [
        'facets_name' => ['facets_name', 'facets_category_tid'],
        'facets_name_1' => ['facets_name_1', 'facets_keywords_tid'],
      ],
      'mukurtu_digital_heritage_browse' => [
        'facets_name' => ['facets_name', 'facets_category_tid'],
        'facets_name_1' => ['facets_name_1', 'facets_keywords_tid'],
      ],
    ],
  );
  if ($indexed === NULL) {
    return NULL;
  }
  return (string) \Drupal::translation()->formatPlural($indexed,
    'The Category and Keywords facets now show nested terms. Reindexed 1 item.',
    'The Category and Keywords facets now show nested terms. Reindexed @count items.'
  );
}
