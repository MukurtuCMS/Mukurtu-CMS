<?php

/**
 * @file
 * Install, update and uninstall functions for the Mukurtu Browse module.
 */

use Drupal\search_api\Entity\Index;

/**
 * Implements hook_install().
 */
function mukurtu_browse_install() {
  mukurtu_search_rebuild_index();
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_browse update hook was removed in 4.0.1. 40021 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_browse_update_last_removed(): int {
  return 40021;
}

/**
 * Ignore apostrophes and similar marks inside words when searching.
 */
function mukurtu_browse_update_40022() {
  mukurtu_search_enable_ignore_character_processor('mukurtu_default_content_index');
}

/**
 * Reindex search so SoundCloud and remote video show as Audio and Video in the Media type filter.
 */
function mukurtu_browse_update_40023() {
  foreach (Index::loadMultiple() as $index) {
    if (!$index->status()) {
      continue;
    }
    foreach ($index->getFields() as $field) {
      if ($field->getDatasourceId() === 'entity:node' && $field->getPropertyPath() === 'field_media_assets:entity:bundle') {
        $index->reindex();
        break;
      }
    }
  }
}
