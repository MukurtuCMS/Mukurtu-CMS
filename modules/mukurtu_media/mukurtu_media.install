<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_media module.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\Core\File\FileSystemInterface;
use Drupal\file\Entity\File;
use Drupal\mukurtu_media\Entity\Video;

/**
 * Copies a module-bundled image to public files and returns a new File entity ID.
 */
function _mukurtu_media_create_bundled_thumbnail(string $filename): ?int {
  $module_path = \Drupal::service('extension.list.module')->getPath('mukurtu_media');
  $source = $module_path . '/images/' . $filename;
  if (!file_exists($source)) {
    return NULL;
  }
  $destination_dir = 'public://mukurtu_media';
  \Drupal::service('file_system')->prepareDirectory($destination_dir, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  $uri = \Drupal::service('file_system')->copy($source, $destination_dir . '/' . $filename, FileSystemInterface::EXISTS_REPLACE);
  if (!$uri) {
    return NULL;
  }
  $file = File::create(['uri' => $uri, 'status' => 1]);
  $file->save();
  return $file->id();
}

/**
 * Sets default video and audio thumbnails from bundled images if not already configured.
 */
function _mukurtu_media_set_default_thumbnails(): void {
  $config = \Drupal::configFactory()->getEditable('mukurtu_thumbnail.settings');
  $defaults = [
    'video_default_thumbnail' => 'video.png',
    'audio_default_thumbnail' => 'audio.png',
  ];
  foreach ($defaults as $key => $filename) {
    if (!$config->get($key)) {
      $fid = _mukurtu_media_create_bundled_thumbnail($filename);
      if ($fid) {
        $config->set($key, [$fid]);
      }
    }
  }
  $config->save();
}

/**
 * Implements hook_install().
 */
function mukurtu_media_install(): void {
  _mukurtu_media_set_default_thumbnails();
  $config = \Drupal::configFactory()->getEditable('views.view.media');
  if (!$config->isNew()) {
    $config->set('status', FALSE)->save();
  }
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_media update hook was removed in 4.0.1. 40023 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_media_update_last_removed(): int {
  return 40023;
}

/**
 * Add caption and subtitle tracks to uploaded video.
 */
function mukurtu_media_update_40024(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getFieldStorageDefinition('field_media_video_tracks', 'media')) {
    $entity_type = $manager->getEntityType('media');
    $definition = Video::bundleFieldDefinitions($entity_type, 'video', [])['field_media_video_tracks'];
    $manager->installFieldStorageDefinition('field_media_video_tracks', 'media', 'mukurtu_media', $definition);
  }

  $form_display = EntityFormDisplay::load('media.video.default');
  if ($form_display && !$form_display->getComponent('field_media_video_tracks')) {
    $form_display->setComponent('field_media_video_tracks', [
      'type' => 'mukurtu_video_track',
      'weight' => 1,
      'region' => 'content',
      'settings' => ['progress_indicator' => 'throbber'],
      'third_party_settings' => [],
    ])->save();
  }

  // Switch displays still using core's video formatter. A display an admin
  // moved to another formatter is left alone.
  $ids = \Drupal::entityTypeManager()->getStorage('entity_view_display')->getQuery()
    ->condition('targetEntityType', 'media')
    ->condition('bundle', 'video')
    ->execute();
  foreach (EntityViewDisplay::loadMultiple($ids) as $display) {
    $component = $display->getComponent('field_media_video_file');
    if ($component && ($component['type'] ?? NULL) === 'file_video') {
      $component['type'] = 'mukurtu_video_with_tracks';
      $display->setComponent('field_media_video_file', $component);
    }
    $display->removeComponent('field_media_video_tracks')->save();
  }
}
