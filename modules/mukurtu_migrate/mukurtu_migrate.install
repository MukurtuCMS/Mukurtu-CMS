<?php

/**
 * @file
 * Install, update and uninstall functions for the Mukurtu Migrate module.
 */

use Drupal\Component\Plugin\Exception\PluginException;
use Drupal\Core\Config\FileStorage;
use Drupal\migrate\Plugin\migrate\id_map\Sql;
use Drupal\mukurtu_migrate\Batch\MukurtuMigrateImportBatch;

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_migrate update hook was removed in 4.0.1. 40002 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_migrate_update_last_removed(): int {
  return 40002;
}

/**
 * Stop the user migration from overwriting the submission service account.
 */
function mukurtu_migrate_update_40201(): ?string {
  // Only touch the config if it still holds the old plain "uid: uid"
  // pipeline; a site that has already customized this migration's process
  // pipeline is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users');
  if ($config->isNew() || $config->get('process.uid') !== 'uid') {
    return NULL;
  }

  $config->set('process.uid', [
    'plugin' => 'skip_service_account_uid',
    'source' => 'uid',
  ]);
  $config->save();

  return (string) t('Updated the mukurtu_cms_v3_users migration so it can no longer merge a legacy user onto the Submission Forms service account when their uids collide.');
}

/**
 * Stop the user migrations from skipping users who had several unmapped roles.
 */
function mukurtu_migrate_update_40202(): ?string {
  $updated = [];
  foreach (['mukurtu_cms_v3_users', 'mukurtu_cms_v3_users_uid1'] as $id) {
    $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.' . $id);
    if ($config->isNew()) {
      continue;
    }
    // Only touch the config if it still holds the shipped single static_map
    // pipeline; a site that has already customized this migration's roles
    // pipeline is left alone.
    $roles = $config->get('process.roles');
    if (!is_array($roles) || count($roles) !== 1 || ($roles[0]['plugin'] ?? NULL) !== 'static_map') {
      continue;
    }

    $roles[] = ['plugin' => 'array_unique'];
    $config->set('process.roles', $roles)->save();
    $updated[] = $id;
  }

  if (!$updated) {
    return NULL;
  }
  return (string) t('Updated the @migrations migration(s) so a legacy user with several roles the migration does not map no longer fails with "Unable to remove item at non-existing index" and gets skipped.', [
    '@migrations' => implode(', ', $updated),
  ]);
}

/**
 * Stop the user migration from merging legacy users onto pre-existing accounts.
 */
function mukurtu_migrate_update_40203(): ?string {
  // Only touch the config if it still holds the plugin 40201 put there; a
  // site that has customized this migration's uid pipeline is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users');
  if ($config->isNew() || $config->get('process.uid.plugin') !== 'skip_service_account_uid') {
    return NULL;
  }

  $config->set('process.uid.plugin', 'avoid_uid_collision')->save();

  return (string) t('Updated the mukurtu_cms_v3_users migration so a legacy user whose uid is already taken by any account on this site (not only the Submission Forms service account) is given a new uid that no later legacy user can claim, instead of being merged onto that account.');
}

/**
 * Stop the admin migration overwriting this site's user 1 roles and status.
 */
function mukurtu_migrate_update_40204(): ?string {
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users_uid1');
  if ($config->isNew()) {
    return NULL;
  }

  $process = $config->get('process');
  $removed = [];
  // Only remove the shipped mappings. A site that has customized either one
  // is left alone.
  if (($process['status'] ?? NULL) === 'status') {
    unset($process['status']);
    $removed[] = 'status';
  }
  if (($process['roles'][0]['plugin'] ?? NULL) === 'static_map') {
    unset($process['roles']);
    $removed[] = 'roles';
  }

  if (!$removed) {
    return NULL;
  }
  $config->set('process', $process)->save();

  return (string) t('Updated the mukurtu_cms_v3_users_uid1 migration so it no longer overwrites the @removed of this site\'s administrator account (user 1) with the Mukurtu 3 site\'s values. Migrating a Mukurtu 3 site whose user 1 had different roles used to leave this site\'s administrator with none.', [
    '@removed' => implode(' and ', array_reverse($removed)),
  ]);
}

/**
 * Stop migrated users being dropped when their username is already taken.
 */
function mukurtu_migrate_update_40205(): ?string {
  // Only touch the config if it still holds the shipped plain "name: name"
  // mapping; a site that has customized it is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users');
  if ($config->isNew() || $config->get('process.name') !== 'name') {
    return NULL;
  }

  $config->set('process.name', [
    'plugin' => 'avoid_username_collision',
    'source' => 'name',
  ])->save();

  return (string) t('Updated the mukurtu_cms_v3_users migration so a Mukurtu 3 user whose username is already taken by an account on this site is migrated under a numbered name instead of being dropped with a duplicate-username error.');
}

/**
 * Repair migrated group memberships so their edit forms load.
 */
function mukurtu_migrate_update_40206(): ?string {
  // The Mukurtu 3 membership migrations shipped with the group's bundle as
  // the og_membership bundle. OG only provides the 'default' membership type,
  // so OgMembershipForm fatals reading the missing type's label.
  $migrations = [
    'mukurtu_cms_v3_community_memberships' => 'community',
    'mukurtu_cms_v3_language_community_community_memberships' => 'community',
    'mukurtu_cms_v3_protocol_memberships' => 'protocol',
    'mukurtu_cms_v3_language_community_protocol_memberships' => 'protocol',
  ];
  foreach ($migrations as $id => $shipped_bundle) {
    // Leave a migration alone if a site has customized its bundle.
    $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.' . $id);
    if (!$config->isNew() && $config->get('destination.default_bundle') === $shipped_bundle) {
      $config->set('destination.default_bundle', 'default')->save();
    }
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('og_membership') || !\Drupal::database()->schema()->tableExists('og_membership')) {
    return NULL;
  }

  $types = array_keys($entity_type_manager->getStorage('og_membership_type')->loadMultiple());
  if (!in_array('default', $types, TRUE)) {
    return NULL;
  }

  $count = (int) \Drupal::database()->update('og_membership')
    ->fields(['type' => 'default'])
    ->condition('type', $types, 'NOT IN')
    ->execute();
  if ($count === 0) {
    return NULL;
  }

  $entity_type_manager->getStorage('og_membership')->resetCache();

  return (string) t('Fixed @count migrated group memberships that used a membership type that does not exist, which made their edit forms fail.', [
    '@count' => $count,
  ]);
}

/**
 * Map Mukurtu 3 community and language community visibility to valid values.
 */
function mukurtu_migrate_update_40207(): ?string {
  // Both migrations could write "open" or "strict", which are protocol
  // values, so migrated communities were hidden from everyone. Only replace
  // the shipped values; a site that has customized them is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_language_communities');
  if (!$config->isNew() && $config->get('process.field_access_mode') === [
    [
      'plugin' => 'static_map',
      'map' => [0 => 'open', 2 => 'strict'],
      'default_value' => 'open',
    ],
  ]) {
    $config->set('process.field_access_mode', [
      'plugin' => 'default_value',
      'default_value' => 'community-only',
    ])->save();
  }

  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_communities');
  if (!$config->isNew() && $config->get('process.field_access_mode.0.default_value') === 'strict') {
    $config->set('process.field_access_mode.0.default_value', 'community-only')->save();
  }

  return NULL;
}

/**
 * Give Mukurtu 3 language stewards the Community Manager role in their migrated language communities.
 */
function mukurtu_migrate_update_40208(): ?string {
  // In Mukurtu 3, "language steward" administers a language community, and
  // "administrator member" has no permissions. The migration only mapped
  // "administrator member", so stewards arrived as plain community members
  // and couldn't manage the community or its protocol. Only replace the
  // shipped mapping; a site that has customized it is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_language_community_community_memberships');
  if (!$config->isNew() && $config->get('process.roles') === [
    [
      'plugin' => 'static_map',
      'source' => 'roles',
      'map' => ['administrator member' => 'community-community-community_manager'],
      'default_value' => 'community-community-member',
    ],
  ]) {
    $config->set('process.roles', [
      [
        'plugin' => 'static_map',
        'source' => 'roles',
        'map' => [
          'administrator member' => 'community-community-community_manager',
          'language steward' => 'community-community-community_manager',
        ],
        'default_value' => 'community-community-member',
      ],
      ['plugin' => 'array_unique'],
    ])->save();
  }

  // Repair language communities that were already migrated. Each one is
  // paired with the protocol migrated from the same Mukurtu 3 node.
  $database = \Drupal::database();
  $schema = $database->schema();
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('og_membership') || !$schema->tableExists('og_membership')) {
    return NULL;
  }

  // Core shortens long map table names on prefixed databases, so ask each
  // migration's id map for its table instead of building the name. Loading
  // a migration discovers every migration on the site, so one broken
  // migration elsewhere would throw; fall back to core's default name then.
  $migration_manager = \Drupal::service('plugin.manager.migration');
  $map_tables = [];
  foreach (['mukurtu_cms_v3_language_communities', 'mukurtu_cms_v3_language_community_protocols'] as $id) {
    try {
      if (!$migration_manager->hasDefinition($id)) {
        return NULL;
      }
      $id_map = $migration_manager->createInstance($id)->getIdMap();
      $map_table = $id_map instanceof Sql ? $id_map->mapTableName() : NULL;
    }
    catch (PluginException) {
      $map_table = mb_substr('migrate_map_' . $id, 0, 63 - strlen($database->getPrefix()));
    }
    if (!$map_table || !$schema->tableExists($map_table)) {
      return NULL;
    }
    $map_tables[] = $map_table;
  }

  $manager_role = $entity_type_manager->getStorage('og_role')->load('community-community-community_manager');
  if (!$manager_role) {
    return NULL;
  }

  $query = $database->select($map_tables[0], 'c');
  $query->innerJoin($map_tables[1], 'p', '[p].[sourceid1] = [c].[sourceid1]');
  $query->addField('p', 'destid1', 'protocol_id');
  $query->addField('c', 'destid1', 'community_id');
  $query->isNotNull('c.destid1');
  $query->isNotNull('p.destid1');
  $communities_by_protocol = $query->execute()->fetchAllKeyed();
  if (!$communities_by_protocol) {
    return NULL;
  }

  $storage = $entity_type_manager->getStorage('og_membership');
  $steward_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('entity_type', 'protocol')
    ->condition('entity_id', array_keys($communities_by_protocol), 'IN')
    ->condition('roles', 'protocol-protocol-language_steward')
    ->execute();

  $count = 0;
  foreach ($storage->loadMultiple($steward_ids) as $steward) {
    // Stewards removed from the community since the migration stay removed.
    $community_ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('entity_type', 'community')
      ->condition('entity_id', $communities_by_protocol[$steward->getGroupId()])
      ->condition('uid', $steward->getOwnerId())
      ->execute();
    foreach ($storage->loadMultiple($community_ids) as $membership) {
      if (!$membership->hasRole($manager_role->id())) {
        $membership->addRole($manager_role)->save();
        $count++;
      }
    }
  }
  if ($count === 0) {
    return NULL;
  }

  return (string) t('Gave the Community Manager role to @count Mukurtu 3 language stewards in their migrated language communities, so they can manage the community and its protocol.', [
    '@count' => $count,
  ]);
}

/**
 * Remove the saved Mukurtu 3 database credentials.
 */
function mukurtu_migrate_update_40209(): ?string {
  // The credential step saved the source database credentials, including the
  // password, to state, and nothing removed them after the migration.
  if (!MukurtuMigrateImportBatch::deleteSourceCredentials()) {
    return NULL;
  }

  return (string) t('Removed the saved Mukurtu CMS v3 database credentials, which were no longer needed after the migration.');
}

/**
 * Map Mukurtu 3 article categories and tags into the Article Tags field.
 */
function mukurtu_migrate_update_40212(): ?string {
  // Keep the docblock above to one line; see mukurtu_core_update_40201() for
  // why.
  //
  // mukurtu_core_update_40229() replaces the article Category and Keywords
  // fields with Article Tags, so the shipped article migration would
  // otherwise write to fields that no longer exist. Only the shipped mappings
  // are replaced; a site that customized either one is left alone.
  //
  // The shipped Image mapping is dropped too, as it is on new sites:
  // mukurtu_core_update_40229() deletes an unused Image field, and Mukurtu 3
  // article images aren't migrated (an image media item needs a cultural
  // protocol articles can't give it).
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_article');
  if ($config->isNew()) {
    return NULL;
  }
  $process = $config->get('process');
  $shipped = [
    'field_article_category' => 'mukurtu_cms_v3_terms_category',
    'field_article_keywords' => 'mukurtu_cms_v3_terms_keywords',
  ];
  // Both mappings have to be the shipped ones. Replacing only one would leave
  // a site's own mapping writing to a field that no longer exists.
  foreach ($shipped as $field_name => $migration) {
    if (($process[$field_name]['plugin'] ?? NULL) !== 'migration_lookup' || ($process[$field_name]['migration'] ?? NULL) !== $migration) {
      return NULL;
    }
  }
  foreach (array_keys($shipped) as $field_name) {
    unset($process[$field_name]);
  }
  $image = $process['field_article_image'] ?? NULL;
  if (($image['plugin'] ?? NULL) === 'migration_lookup' && ($image['source'] ?? NULL) === 'field_image/0/fid') {
    unset($process['field_article_image']);
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('mukurtu_migrate');
  $record = (new FileStorage($module_path . '/config/install'))->read('migrate_plus.migration.mukurtu_cms_v3_article');
  foreach (['_article_category_tags', '_article_keyword_tags', 'field_article_tags'] as $key) {
    $process[$key] = $record['process'][$key];
  }
  $config->set('process', $process)->save();

  return (string) t('Updated the Mukurtu 3 article migration so article categories and tags are migrated into the Article Tags field. Article images are no longer migrated.');
}

/**
 * Migrate Mukurtu 3 protocols before protocol memberships, and skip memberships whose group is missing.
 */
function mukurtu_migrate_update_40213(): ?string {
  // Keep the docblock above to one line; see mukurtu_core_update_40201() for
  // why.
  //
  // Protocol memberships didn't depend on the protocols migration, so they
  // could run first. Each membership's group lookup then found nothing, tried
  // to create an empty placeholder group, and failed with "A group entity is
  // required for creating a membership." Only the shipped lookups are
  // replaced; a site that customized one is left alone.
  $module_path = \Drupal::service('extension.list.module')->getPath('mukurtu_migrate');
  $storage = new FileStorage($module_path . '/config/install');
  $group_migrations = [
    'mukurtu_cms_v3_community_memberships' => 'mukurtu_cms_v3_communities',
    'mukurtu_cms_v3_language_community_community_memberships' => 'mukurtu_cms_v3_language_communities',
    'mukurtu_cms_v3_protocol_memberships' => 'mukurtu_cms_v3_cultural_protocols',
    'mukurtu_cms_v3_language_community_protocol_memberships' => 'mukurtu_cms_v3_language_communities',
  ];
  $changed = FALSE;
  foreach ($group_migrations as $id => $group_migration) {
    $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.' . $id);
    if ($config->isNew()) {
      continue;
    }
    $save = FALSE;
    if ($config->get('process.entity_id') === [
      'plugin' => 'migration_lookup',
      'migration' => [$group_migration],
      'source' => 'gid',
    ]) {
      $record = $storage->read('migrate_plus.migration.' . $id);
      $config->set('process.entity_id', $record['process']['entity_id']);
      $save = TRUE;
    }
    if ($id === 'mukurtu_cms_v3_protocol_memberships') {
      $required = $config->get('migration_dependencies.required') ?? [];
      if (!in_array($group_migration, $required, TRUE)) {
        $required[] = $group_migration;
        $config->set('migration_dependencies.required', $required);
        $save = TRUE;
      }
    }
    if ($save) {
      $config->save();
      $changed = TRUE;
    }
  }

  // Digital Heritage items with no map location passed NULL to ucfirst(),
  // which logs a deprecation.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_digital_heritage');
  if (!$config->isNew() && $config->get('process.field_coverage/geo_type') === [
    [
      'plugin' => 'callback',
      'source' => 'field_coverage/0/geo_type',
      'callable' => 'ucfirst',
    ],
  ]) {
    $record = $storage->read('migrate_plus.migration.mukurtu_cms_v3_digital_heritage');
    $config->set('process.field_coverage/geo_type', $record['process']['field_coverage/geo_type'])->save();
  }

  if (!$changed) {
    return NULL;
  }
  return (string) t('Updated the Mukurtu 3 membership migrations so protocols always migrate before protocol memberships, and a membership whose community or protocol is missing is skipped and logged instead of failing.');
}

/**
 * Migrate unpublished Mukurtu 3 content as drafts instead of publishing it.
 */
function mukurtu_migrate_update_40214(): ?string {
  // Keep the docblock above to one line; see mukurtu_core_update_40201() for
  // why.
  //
  // These content types use mukurtu_default_content_workflow, whose default
  // moderation state is "published". The migrations mapped status but not
  // moderation_state, so content moderation published every migrated node,
  // including ones that were unpublished in Mukurtu 3. The dictionary word
  // migration didn't map status at all. Only missing keys are added, so a
  // site's own status or moderation_state mapping is left alone.
  $module_path = \Drupal::service('extension.list.module')->getPath('mukurtu_migrate');
  $storage = new FileStorage($module_path . '/config/install');
  $migrations = [
    'mukurtu_cms_v3_article',
    'mukurtu_cms_v3_collection',
    'mukurtu_cms_v3_dictionary_word',
    'mukurtu_cms_v3_digital_heritage',
    'mukurtu_cms_v3_page',
    'mukurtu_cms_v3_person',
    'mukurtu_cms_v3_word_list',
  ];
  $changed = FALSE;
  foreach ($migrations as $id) {
    $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.' . $id);
    if ($config->isNew()) {
      continue;
    }
    $process = $config->get('process') ?? [];
    $record = $storage->read('migrate_plus.migration.' . $id);
    $save = FALSE;
    foreach (['status', 'moderation_state'] as $key) {
      if (!array_key_exists($key, $process)) {
        $config->set('process.' . $key, $record['process'][$key]);
        $save = TRUE;
      }
    }
    if ($save) {
      $config->save();
      $changed = TRUE;
    }
  }

  if (!$changed) {
    return NULL;
  }
  return (string) t('Updated the Mukurtu 3 content migrations so content that was unpublished in Mukurtu 3 is migrated as a draft instead of being published.');
}

/**
 * Keep each term's parent in the Mukurtu CMS v3 term migrations.
 */
function mukurtu_migrate_update_40215(): ?string {
  // Every term landed at the top level, because the parent lookup used a
  // migration Mukurtu never runs. Only the shipped lookup is replaced, so a site
  // that has customized a migration's parent mapping is left alone.
  $config_factory = \Drupal::configFactory();
  $updated = FALSE;
  foreach ($config_factory->listAll('migrate_plus.migration.mukurtu_cms_v3_terms_') as $name) {
    $config = $config_factory->getEditable($name);
    $process = $config->get('process');
    if (($process['parent_id'][1]['migration'] ?? NULL) !== 'd7_taxonomy_term') {
      continue;
    }
    unset($process['parent_id']);
    $process['parent'] = ['plugin' => 'mukurtu_v3_term_parent', 'source' => 'parent'];
    $config->set('process', $process)->save();
    $updated = TRUE;
  }
  if (!$updated) {
    return NULL;
  }

  \Drupal::service('plugin.manager.migration')->clearCachedDefinitions();
  return (string) t("Updated the Mukurtu CMS v3 term migrations to keep each term's parent.");
}
