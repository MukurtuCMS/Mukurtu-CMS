<?php

/**
 * @file
 * Install, update and uninstall functions for the Mukurtu Migrate module.
 */

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_migrate update hook was removed in 4.0.1. 40002 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_migrate_update_last_removed(): int {
  return 40002;
}

/**
 * Stop the user migration from overwriting the submission service account.
 */
function mukurtu_migrate_update_40201(): ?string {
  // Only touch the config if it still holds the old plain "uid: uid"
  // pipeline; a site that has already customized this migration's process
  // pipeline is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users');
  if ($config->isNew() || $config->get('process.uid') !== 'uid') {
    return NULL;
  }

  $config->set('process.uid', [
    'plugin' => 'skip_service_account_uid',
    'source' => 'uid',
  ]);
  $config->save();

  return (string) t('Updated the mukurtu_cms_v3_users migration so it can no longer merge a legacy user onto the Submission Forms service account when their uids collide.');
}

/**
 * Stop the user migrations from skipping users who had several unmapped roles.
 */
function mukurtu_migrate_update_40202(): ?string {
  $updated = [];
  foreach (['mukurtu_cms_v3_users', 'mukurtu_cms_v3_users_uid1'] as $id) {
    $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.' . $id);
    if ($config->isNew()) {
      continue;
    }
    // Only touch the config if it still holds the shipped single static_map
    // pipeline; a site that has already customized this migration's roles
    // pipeline is left alone.
    $roles = $config->get('process.roles');
    if (!is_array($roles) || count($roles) !== 1 || ($roles[0]['plugin'] ?? NULL) !== 'static_map') {
      continue;
    }

    $roles[] = ['plugin' => 'array_unique'];
    $config->set('process.roles', $roles)->save();
    $updated[] = $id;
  }

  if (!$updated) {
    return NULL;
  }
  return (string) t('Updated the @migrations migration(s) so a legacy user with several roles the migration does not map no longer fails with "Unable to remove item at non-existing index" and gets skipped.', [
    '@migrations' => implode(', ', $updated),
  ]);
}

/**
 * Stop the user migration from merging legacy users onto pre-existing accounts.
 */
function mukurtu_migrate_update_40203(): ?string {
  // Only touch the config if it still holds the plugin 40201 put there; a
  // site that has customized this migration's uid pipeline is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users');
  if ($config->isNew() || $config->get('process.uid.plugin') !== 'skip_service_account_uid') {
    return NULL;
  }

  $config->set('process.uid.plugin', 'avoid_uid_collision')->save();

  return (string) t('Updated the mukurtu_cms_v3_users migration so a legacy user whose uid is already taken by any account on this site (not only the Submission Forms service account) is given a new uid that no later legacy user can claim, instead of being merged onto that account.');
}

/**
 * Stop the admin migration overwriting this site's user 1 roles and status.
 */
function mukurtu_migrate_update_40204(): ?string {
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users_uid1');
  if ($config->isNew()) {
    return NULL;
  }

  $process = $config->get('process');
  $removed = [];
  // Only remove the shipped mappings. A site that has customized either one
  // is left alone.
  if (($process['status'] ?? NULL) === 'status') {
    unset($process['status']);
    $removed[] = 'status';
  }
  if (($process['roles'][0]['plugin'] ?? NULL) === 'static_map') {
    unset($process['roles']);
    $removed[] = 'roles';
  }

  if (!$removed) {
    return NULL;
  }
  $config->set('process', $process)->save();

  return (string) t('Updated the mukurtu_cms_v3_users_uid1 migration so it no longer overwrites the @removed of this site\'s administrator account (user 1) with the Mukurtu 3 site\'s values. Migrating a Mukurtu 3 site whose user 1 had different roles used to leave this site\'s administrator with none.', [
    '@removed' => implode(' and ', array_reverse($removed)),
  ]);
}

/**
 * Stop migrated users being dropped when their username is already taken.
 */
function mukurtu_migrate_update_40205(): ?string {
  // Only touch the config if it still holds the shipped plain "name: name"
  // mapping; a site that has customized it is left alone.
  $config = \Drupal::configFactory()->getEditable('migrate_plus.migration.mukurtu_cms_v3_users');
  if ($config->isNew() || $config->get('process.name') !== 'name') {
    return NULL;
  }

  $config->set('process.name', [
    'plugin' => 'avoid_username_collision',
    'source' => 'name',
  ])->save();

  return (string) t('Updated the mukurtu_cms_v3_users migration so a Mukurtu 3 user whose username is already taken by an account on this site is migrated under a numbered name instead of being dropped with a duplicate-username error.');
}
