<?php

/**
 * @file
 * Install, update and uninstall functions for the Mukurtu Design module.
 */

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_design update hook was removed in 4.0.1. 40004 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_design_update_last_removed(): int {
  return 40004;
}

/**
 * Add the page and header background settings, off until images are chosen.
 */
function mukurtu_design_update_40005(): string {
  $config = \Drupal::configFactory()
    ->getEditable(\Drupal\mukurtu_design\DesignPalette::SETTINGS);

  $background = (array) $config->get('background');
  $header = (array) $config->get('header');

  // Seed only the keys that are genuinely absent, so re-running cannot reset a
  // site that has since configured a background, and a partially seeded site is
  // completed rather than overwritten. Checking the sub-array by key matters:
  // $config->get('background.image') returns NULL both when the key is missing
  // and when it is set to NULL, which is the shipped default.
  $defaults = [
    'image' => NULL,
    'text_treatment' => 'light',
  ];

  $added = [];
  foreach ($defaults as $key => $value) {
    if (!array_key_exists($key, $background)) {
      $background[$key] = $value;
      $added[] = $key;
    }
    if (!array_key_exists($key, $header)) {
      $header[$key] = $value;
      $added[] = $key;
    }
  }

  if (!$added) {
    return (string) t('The background settings are already present.');
  }

  $config->set('background', $background)->set('header', $header)->save();

  return (string) t('Added the page and header background settings. No images are set, so the site is unchanged until one is uploaded.');
}

/**
 * Regenerate the custom palette stylesheet with the breadcrumb and panel colours.
 */
function mukurtu_design_update_40006(): string {
  // The stylesheet is only written when the form is saved or the file is
  // missing, so an existing one never picks up CUSTOM_DERIVED_VARS on its own.
  $config = \Drupal::config(\Drupal\mukurtu_design\DesignPalette::SETTINGS);
  if ($config->get('palette') !== 'custom') {
    return (string) t('This site does not use the custom palette, so there was nothing to regenerate.');
  }

  \Drupal::classResolver(\Drupal\mukurtu_design\DesignPalette::class)
    ->generateCustomCss($config->get('colors') ?? []);

  return (string) t('Regenerated the custom palette stylesheet.');
}
