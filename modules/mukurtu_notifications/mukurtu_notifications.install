/**
 * Creates a flag from $values, or updates it in place if it already exists.
 *
 * Flag::create() with an id that already exists in config storage throws
 * EntityStorageException, so an existing flag must be loaded and have its
 * properties set individually instead of being recreated.
 */
function _mukurtu_notifications_save_flag(array $values): void {
  $flag = Flag::load($values['id']);
  if ($flag) {
    foreach ($values as $property => $value) {
      $flag->set($property, $value);
    }
  }
  else {
    $flag = Flag::create($values);
  }
  $flag->save();
}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu_notifications update hook was removed in 4.0.1. 40057 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core does not enforce that on
 * its own, so mukurtu_core_update_requirements() blocks them explicitly.
 */
function mukurtu_notifications_update_last_removed(): int {
  return 40057;
}
