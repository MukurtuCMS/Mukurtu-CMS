<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu_multipage_items module.
 */

/**
 * Implements hook_install().
 *
 * Adds the is_additional_mpi_page field and mukurtu_multipage_page_index
 * processor to the default content index. mukurtu_browse installs before this
 * module, so these items cannot be declared in mukurtu_browse's config/install;
 * they are added here so fresh installs match sites that ran
 * mukurtu_browse_update_40009() and mukurtu_browse_update_40010().
 */
function mukurtu_multipage_items_install(): void {
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if (!$index) {
    return;
  }

  $changed = FALSE;

  $processors = $index->getProcessors();
  if (!isset($processors['mukurtu_multipage_page_index'])) {
    $processor = \Drupal::service('plugin.manager.search_api.processor')
      ->createInstance('mukurtu_multipage_page_index', ['#index' => $index]);
    $processors['mukurtu_multipage_page_index'] = $processor;
    $index->setProcessors($processors);
    $changed = TRUE;
  }

  if (!$index->getField('is_additional_mpi_page')) {
    $field = new \Drupal\search_api\Item\Field($index, 'is_additional_mpi_page');
    $field->setType('boolean');
    $field->setPropertyPath('is_additional_mpi_page');
    $field->setDatasourceId('entity:node');
    $field->setLabel('Is additional multipage item page');
    $index->addField($field);
    $changed = TRUE;
  }

  if ($changed) {
    $index->save();
    $index->reindex();
  }
}

/**
 * Reset MPI _controller config cleared by Drupal 11.3.x RouteSubscriber.
 *
 * In Drupal 11.3.x, entity.node.canonical uses _entity_view instead of
 * _controller. The RouteSubscriber read null from that route and wrote it
 * to config, leaving _controller null. Reset it to the NodeViewController
 * fallback so viewRedirect() works correctly.
 */
function mukurtu_multipage_items_update_40002(): void {
  $config = \Drupal::configFactory()->getEditable('mukurtu_multipage_items.settings');
  if (empty($config->get('_controller'))) {
    $config->set('_controller', '\Drupal\node\Controller\NodeViewController::view')->save();
  }
}

/**
 * Switch field_pages on Multipage Item to rendered_entity (form_selection view mode).
 */
function mukurtu_multipage_items_update_40001(): void {
  $config = \Drupal::configFactory()->getEditable('core.entity_form_display.multipage_item.multipage_item.default');
  if ($config->isNew()) {
    return;
  }
  $config->set('content.field_pages.settings.field_widget_display', 'rendered_entity');
  $config->set('content.field_pages.settings.field_widget_display_settings', ['view_mode' => 'form_selection']);
  $config->save();
}

/**
 * Switch field_pages entity browser from mukurtu_content_browser to
 * multipage_item_entity_browser to apply MPI-specific content filters.
 */
function mukurtu_multipage_items_update_40003(): void {
  $config = \Drupal::configFactory()->getEditable(
    'core.entity_form_display.multipage_item.multipage_item.default'
  );
  if ($config->isNew()) {
    return;
  }
  $config->set('content.field_pages.settings.entity_browser', 'multipage_item_entity_browser')->save();
}


/**
 * Adds the language-fallback default_langcode filter and rendering_language
 * setting to multipage_item_browser, per docs/content-language-policy.md.
 * Additive only.
 */
function mukurtu_multipage_items_update_40011(): void {
  $config_multipage_item_browser = \Drupal::configFactory()->getEditable('views.view.multipage_item_browser');
  if (!$config_multipage_item_browser->isNew()) {
    $filters_multipage_item_browser_default = $config_multipage_item_browser->get('display.default.display_options.filters') ?? [];
    if (!isset($filters_multipage_item_browser_default['default_langcode'])) {
      $filters_multipage_item_browser_default['default_langcode'] = [
        'id' => 'default_langcode',
        'table' => 'node_field_data',
        'field' => 'default_langcode',
        'relationship' => 'none',
        'group_type' => 'group',
        'admin_label' => '',
        'entity_type' => 'node',
        'entity_field' => 'default_langcode',
        'plugin_id' => 'boolean',
        'operator' => '=',
        'value' => '1',
        'group' => 1,
        'exposed' => FALSE,
        'expose' => [
          'operator_id' => '',
          'label' => '',
          'description' => '',
          'use_operator' => FALSE,
          'operator' => '',
          'operator_limit_selection' => FALSE,
          'operator_list' => [],
          'identifier' => '',
          'required' => FALSE,
          'remember' => FALSE,
          'multiple' => FALSE,
          'remember_roles' => ['authenticated' => 'authenticated'],
        ],
        'is_grouped' => FALSE,
        'group_info' => [
          'label' => '',
          'description' => '',
          'identifier' => '',
          'optional' => TRUE,
          'widget' => 'select',
          'multiple' => FALSE,
          'remember' => FALSE,
          'default_group' => 'All',
          'default_group_multiple' => [],
          'group_items' => [],
        ],
      ];
      $config_multipage_item_browser->set('display.default.display_options.filters', $filters_multipage_item_browser_default);
      $config_multipage_item_browser->save();
    }
    if (!$config_multipage_item_browser->get('display.entity_browser.display_options.rendering_language')) {
      $config_multipage_item_browser->set('display.entity_browser.display_options.rendering_language', '***LANGUAGE_language_content***');
      $config_multipage_item_browser->save();
    }
  }
}
