<?php

/**
 * @file
 * Install, update and uninstall functions for the mukurtu install profile.
 */

use Drupal\block\Entity\Block;
use Drupal\Core\Config\FileStorage;
use Drupal\block_content\Entity\BlockContent;
use Drupal\user\Entity\Role;
use Drupal\menu_link_content\Entity\MenuLinkContent;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\shortcut\Entity\Shortcut;
use Drupal\captcha\Entity\CaptchaPoint;
use Drupal\node\Entity\NodeType;
use Drupal\node\NodeAccessRebuild;

/**
 * Implements hook_install().
 *
 * Perform actions to set up the site for this profile.
 *
 * @see system_install()
 */
function mukurtu_install() {
  // Populate the default shortcut set (inlined from standard_install(), which
  // is absent in some Drupal 11.3.x environments).
  Shortcut::create([
    'shortcut_set' => 'default',
    'title' => t('Add content'),
    'weight' => -20,
    'link' => ['uri' => 'internal:/node/add'],
  ])->save();
  Shortcut::create([
    'shortcut_set' => 'default',
    'title' => t('All content'),
    'weight' => -19,
    'link' => ['uri' => 'internal:/admin/content'],
  ])->save();

  // Remove article content permissions granted by standard_install().
  $article_permissions = [
    'create article content',
    'delete article revisions',
    'delete own article content',
    'edit own article content',
  ];
  $content_editor = Role::load('content_editor');
  if ($content_editor) {
    foreach ($article_permissions as $permission) {
      $content_editor->revokePermission($permission);
    }
    $content_editor->save();
  }

  // Uninstall search.
  \Drupal::service('module_installer')->uninstall(['search']);

  // @todo: Make an installation option to enable this module.
  // \Drupal::service('module_installer')->install(['mukurtu_solr']);

  // Rebuild node access permissions.
  \Drupal::service(NodeAccessRebuild::class)->rebuild();

  // Install default themes (system.theme.yml is not owned by Mukurtu).
  //
  // Gin isn't listed under this profile's `themes:` key, so it's installed
  // here explicitly rather than by the normal install batch. The profile's
  // gin.settings.yml lives in config/optional so it isn't written before
  // Gin and its schema are installed (#2386); ConfigInstaller still
  // substitutes it for Gin's own copy when the theme installs. Deleting any
  // pre-existing copy first still guards against a
  // PreExistingConfigException.
  if (!\Drupal::configFactory()->get('gin.settings')->isNew()) {
    \Drupal::configFactory()->getEditable('gin.settings')->delete();
  }
  \Drupal::service('theme_installer')->install(['mukurtu_v4', 'gin']);
  \Drupal::configFactory()
    ->getEditable('system.theme')
    ->set('default', 'mukurtu_v4')
    ->set('admin', 'gin')
    ->save();

  \Drupal::service('module_installer')->install(['gin_toolbar']);

  // Homepage will be set to the landing page node created below.

  // Set the homepage (system.site.yml is not owned by Mukurtu).
  \Drupal::configFactory()
    ->getEditable('node.settings')
    ->set('use_admin_theme', TRUE)
    ->save();

  // Set the custom 403 (access denied) and 404 (not found) pages
  // (system.site.yml is not owned by Mukurtu).
  \Drupal::configFactory()
    ->getEditable('system.site')
    ->set('page.403', '/mukurtu/access-denied')
    ->set('page.404', '/mukurtu/not-found')
    ->save();

  // Create the default landing page using the service.
  \Drupal::service('mukurtu_landing_page.default_landing_page')->createDefaultLandingPage();

  // Create Communities menu item.
  MenuLinkContent::create([
    'title' => 'Communities',
    'link' => ['uri' => 'internal:' . '/communities'],
    'menu_name' => 'main',
    'description' => 'Browse the site communities',
    'expanded' => FALSE,
    'weight' => 1,
  ])->save();

  // Create Categories menu item.
  MenuLinkContent::create([
    'title' => 'Categories',
    'link' => ['uri' => 'internal:' . '/categories'],
    'menu_name' => 'main',
    'description' => 'Browse the site categories',
    'expanded' => FALSE,
    'weight' => 2,
  ])->save();

  // Create Browse Digital Heritage menu item.
  MenuLinkContent::create([
    'title' => 'Browse Digital Heritage',
    'link' => ['uri' => 'internal:' . '/digital-heritage'],
    'menu_name' => 'main',
    'description' => 'Browse Digital Heritage Content',
    'expanded' => FALSE,
    'weight' => 3,
  ])->save();

  // Create Browse menu item.
  MenuLinkContent::create([
    'title' => 'Browse',
    'link' => ['uri' => 'internal:' . '/browse'],
    'menu_name' => 'main',
    'description' => 'Browse Site Content',
    'expanded' => FALSE,
    'weight' => 4,
  ])->save();

  // Create Collections menu item.
  MenuLinkContent::create([
    'title' => 'Collections',
    'link' => ['uri' => 'internal:' . '/collections'],
    'menu_name' => 'main',
    'description' => 'Browse Site Collections',
    'expanded' => FALSE,
    'weight' => 5,
  ])->save();

  // Create Dictionary menu item.
  MenuLinkContent::create([
    'title' => 'Dictionary',
    'link' => ['uri' => 'internal:' . '/dictionary'],
    'menu_name' => 'main',
    'description' => 'Browse the dictionary',
    'expanded' => FALSE,
    'weight' => 6,
  ])->save();

  // Create account menu items.
  // These are created through MenuLinkContent so they can be edited on the UI.
  // Dashboard
  MenuLinkContent::create([
    'title' => 'Dashboard',
    'link' => ['uri' => 'internal:' . "/dashboard/mukurtu_dashboard"],
    'menu_name' => 'account',
    'description' => 'Dashboard',
    'expanded' => FALSE,
    'weight' => -100,
  ])->save();

  // Create Content (parent)
  $create_content_menu = MenuLinkContent::create([
    'title' => 'Create Content',
    'link' => ['uri' => 'internal:' . '/node/add'],
    'menu_name' => 'account',
    'description' => 'Create content',
    'expanded' => TRUE,
    'weight' => -1000,
  ]);
  $create_content_menu->save();

  // Digital Heritage (under Create Content)
  MenuLinkContent::create([
    'title' => 'Digital Heritage',
    'link' => ['uri' => 'internal:' . '/node/add/digital_heritage'],
    'menu_name' => 'account',
    'description' => 'Create digital heritage item',
    'parent' => 'menu_link_content:' . $create_content_menu->uuid(),
    'expanded' => FALSE,
    'weight' => 0,
  ])->save();

  // Collection (under Create Content)
  MenuLinkContent::create([
    'title' => 'Collection',
    'link' => ['uri' => 'internal:' . '/node/add/collection'],
    'menu_name' => 'account',
    'description' => 'Create collection',
    'parent' => 'menu_link_content:' . $create_content_menu->uuid(),
    'expanded' => FALSE,
    'weight' => 10,
  ])->save();

  // Dictionary word (under Create Content)
  MenuLinkContent::create([
    'title' => 'Dictionary word',
    'link' => ['uri' => 'internal:' . '/node/add/dictionary_word'],
    'menu_name' => 'account',
    'description' => 'Create dictionary word',
    'parent' => 'menu_link_content:' . $create_content_menu->uuid(),
    'expanded' => FALSE,
    'weight' => 20,
  ])->save();

  // Word list (under Create Content)
  MenuLinkContent::create([
    'title' => 'Word list',
    'link' => ['uri' => 'internal:' . '/node/add/word_list'],
    'menu_name' => 'account',
    'description' => 'Create word list',
    'parent' => 'menu_link_content:' . $create_content_menu->uuid(),
    'expanded' => FALSE,
    'weight' => 30,
  ])->save();

  // Person record (under Create Content)
  MenuLinkContent::create([
    'title' => 'Person record',
    'link' => ['uri' => 'internal:' . '/node/add/person'],
    'menu_name' => 'account',
    'description' => 'Create person record',
    'parent' => 'menu_link_content:' . $create_content_menu->uuid(),
    'expanded' => FALSE,
    'weight' => 40,
  ])->save();

  // Place record (under Create Content)
  MenuLinkContent::create([
    'title' => 'Place record',
    'link' => ['uri' => 'internal:' . '/node/add/place'],
    'menu_name' => 'account',
    'description' => 'Create place record',
    'parent' => 'menu_link_content:' . $create_content_menu->uuid(),
    'expanded' => FALSE,
    'weight' => 35,
  ])->save();

  // Media (under Create Content)
  MenuLinkContent::create([
    'title' => 'Media',
    'link' => ['uri' => 'internal:' . '/admin/media/add'],
    'menu_name' => 'account',
    'description' => 'Add media',
    'parent' => 'menu_link_content:' . $create_content_menu->uuid(),
    'expanded' => FALSE,
    'weight' => 50,
  ])->save();

  // Delete unused user flags that crash user registration page.
  $flagStorage = \Drupal::entityTypeManager()->getStorage('flag');
  foreach (['email_user', 'subscribe_user'] as $userFlagID) {
    $flag = $flagStorage->load($userFlagID);
    if ($flag) {
      $flag->delete();
    }
  }

  // Create the community records field on digital heritage by default.
  FieldConfig::create([
    'entity_type' => 'node',
    'bundle' => 'digital_heritage',
    'field_name' => 'field_mukurtu_original_record',
    'label' => 'Original Record',
    'translatable' => FALSE,
    'settings' => [
      'handler' => 'default:node',
      'handler_settings' => [
        'target_bundles' => ['digital_heritage'],
        'auto_create' => FALSE,
      ],
    ],
  ])->save();

  // Configure user roles. These are not managed by Mukurtu because any change
  // in permissions would cause an override. Instead these are provided as
  // defaults that can be changed per-site.
  $roles = [];
  $roles['anonymous'] = [
    'access comments',
    'access content',
    'access site-wide contact form',
    'view media',
    'view published community entities',
  ];
  $roles['authenticated'] = [
    'access comments',
    'post comments',
    'access content',
    'access mukurtu_collection_browser entity browser pages',
    'access mukurtu_community_and_protocol_user_browser entity browser pages',
    'access mukurtu_community_select entity browser pages',
    'access mukurtu_content_browser entity browser pages',
    'access mukurtu_taxonomy_record_term_browser entity browser pages',
    'access mukurtu_taxonomy_record_place_term_browser entity browser pages',
    'access multipage_item_entity_browser entity browser pages',
    'access mukurtu_dictionary_word_browser entity browser pages',
    'access mukurtu_person_browser entity browser pages',
    'add personal collection entities',
    'add protocol control entities',
    'delete personal collection entities',
    'edit personal collection entities',
    'edit protocol control entities',
    'flag mukurtu_email_collection',
    'flag mukurtu_email_community',
    'flag mukurtu_email_content',
    'flag mukurtu_email_node',
    'flag mukurtu_email_og',
    'flag mukurtu_email_term',
    'flag mukurtu_follow_collection',
    'flag mukurtu_follow_community',
    'flag mukurtu_follow_content',
    'unflag mukurtu_email_collection',
    'unflag mukurtu_email_community',
    'unflag mukurtu_email_content',
    'unflag mukurtu_email_node',
    'unflag mukurtu_email_og',
    'unflag mukurtu_email_term',
    'unflag mukurtu_follow_collection',
    'unflag mukurtu_follow_community',
    'unflag mukurtu_follow_content',
    'use text format basic_html',
    // Full HTML is deliberately not granted here. It adds object, embed and
    // video tags over Basic HTML, which already covers the iframe and media
    // embedding an ordinary logged-in user needs. mukurtu_core_update_40118()
    // revoked this from existing sites in 4.0.0 on exactly that reasoning, but
    // its docblock assumed "the shipped authenticated role has never granted
    // it", which was true of user.role.authenticated.yml and untrue here.
    // Fresh installs therefore kept getting it. See ShippedRolePermissionsTest.
    'view the administration theme',
    'view media',
    'view all revisions',
    'view published community entities',
    'view published personal collection entities',
    'view published protocol control entities',
  ];
  $roles['mukurtu_manager'] = [
    'access administration pages',
    'access block library',
    'access content overview',
    'access contextual links',
    'access files overview',
    'access media overview',
    'access mukurtu export',
    'access mukurtu import',
    'access shortcuts',
    'access site in maintenance mode',
    'access site-wide contact form',
    'access taxonomy overview',
    'access toolbar',
    'access user contact forms',
    'access user profiles',
    'add community entities',
    'administer account settings',
    'administer block content',
    'administer block_content display',
    'administer block_content fields',
    'administer block_content form display',
    'administer blocks',
    'administer comment display',
    'administer comment fields',
    'administer comment form display',
    'administer comments',
    'administer community display',
    'administer community entities',
    'administer community fields',
    'administer community form display',
    'administer contact forms',
    'administer contact_message display',
    'administer contact_message fields',
    'administer contact_message form display',
    'administer dictionary glossary order',
    'administer display modes',
    'administer embed buttons',
    'administer facets',
    'administer filters',
    'administer flagging display',
    'administer flagging fields',
    'administer flagging form display',
    'administer flaggings',
    'administer flags',
    'administer image styles',
    'administer media display',
    'administer media fields',
    'administer media form display',
    'administer menu',
    'administer message display',
    'administer message fields',
    'administer message form display',
    'administer message templates',
    'administer messages',
    'administer modules',
    'administer mukurtu design settings',
    'administer mukurtu_import_strategy',
    'administer multipage item',
    'administer node display',
    'administer node fields',
    'administer node form display',
    'administer og_membership display',
    'administer og_membership fields',
    'administer og_membership form display',
    'administer paragraph display',
    'administer paragraph fields',
    'administer paragraph form display',
    'administer paragraphs settings',
    'administer paragraphs types',
    'administer pathauto',
    'administer permissions',
    'administer personal_collection display',
    'administer personal_collection fields',
    'administer personal_collection form display',
    'administer protocol display',
    'administer protocol fields',
    'administer protocol form display',
    'administer redirect settings',
    'administer redirects',
    'administer rest resources',
    'administer search_api',
    'administer shortcuts',
    'administer site configuration',
    'administer taxonomy',
    'administer taxonomy_term display',
    'administer taxonomy_term fields',
    'administer taxonomy_term form display',
    'administer term merge from entities',
    'administer term merge into entities',
    'administer themes',
    'administer url aliases',
    'administer user display',
    'administer user fields',
    'administer user form display',
    'administer users',
    'configure leaflet',
    'create any message template',
    'create landing_page content',
    'create media content warnings',
    'create mukurtu_batch_import_report message',
    'create mukurtu_new_user_registration message',
    'create mukurtu_single_node_delete message',
    'create mukurtu_single_node_insert message',
    'create mukurtu_single_node_update message',
    'create article content',
    'create page content',
    'create terms in category',
    'create terms in community_type',
    'create terms in contributor',
    'create terms in creator',
    'create terms in format',
    'create terms in interpersonal_relationship',
    'create terms in keywords',
    'create terms in language',
    'create terms in people',
    'create terms in publisher',
    'create terms in subject',
    'create terms in type',
    'create terms in word_type',
    'create url aliases',
    'customize shortcut links',
    'delete any landing_page content',
    'delete any message template',
    'delete any page content',
    'delete community entities',
    'delete mukurtu_batch_import_report message',
    'delete mukurtu_new_user_registration message',
    'delete mukurtu_single_node_delete message',
    'delete mukurtu_single_node_insert message',
    'delete mukurtu_single_node_update message',
    'delete multiple messages',
    'delete orphan revisions',
    'delete own landing_page content',
    'delete any article content',
    'delete own article content',
    'delete own page content',
    'delete terms in category',
    'delete terms in community_type',
    'delete terms in contributor',
    'delete terms in creator',
    'delete terms in format',
    'delete terms in interpersonal_relationship',
    'delete terms in keywords',
    'delete terms in language',
    'delete terms in people',
    'delete terms in publisher',
    'delete terms in subject',
    'delete terms in type',
    'delete terms in word_type',
    'edit any landing_page content',
    'edit any message template',
    'edit any page content',
    'edit behavior plugin settings',
    'edit own comments',
    'edit own landing_page content',
    'edit any article content',
    'edit own article content',
    'edit own page content',
    'edit terms in category',
    'edit terms in community_type',
    'edit terms in contributor',
    'edit terms in creator',
    'edit terms in format',
    'edit terms in interpersonal_relationship',
    'edit terms in keywords',
    'edit terms in language',
    'edit terms in people',
    'edit terms in publisher',
    'edit terms in subject',
    'edit terms in type',
    'edit terms in word_type',
    'flag export_content',
    'flag export_media',
    'merge taxonomy terms',
    'notify of path changes',
    'overview messages',
    'post comments',
    'revert all community revisions',
    'send message through the ui',
    'switch shortcut sets',
    'unflag export_content',
    'unflag export_media',
    'update mukurtu_batch_import_report message',
    'update mukurtu_new_user_registration message',
    'update mukurtu_single_node_delete message',
    'update mukurtu_single_node_insert message',
    'update mukurtu_single_node_update message',
    'update tokens',
    'use mukurtu bulk edit',
    'use text format full_html',
    'view all community revisions',
    'view any message template',
    'view mukurtu_batch_import_report message',
    'view mukurtu_new_user_registration message',
    'view mukurtu_single_node_delete message',
    'view mukurtu_single_node_insert message',
    'view mukurtu_single_node_update message',
    'view own unpublished content',
    'view own unpublished media',
    'view the administration theme',
    'view unpublished community entities',
    'view unpublished paragraphs',
    'view user email addresses',
    'rebuild cache access',
  ];

  // The administrator role is deliberately absent from $roles. It ships with
  // is_admin: true in config/install/user.role.administrator.yml, which grants
  // every permission on the site, including permissions added by modules in
  // later releases. Core's Role::grantPermission() returns early for admin
  // roles, so listing permissions for it here stored nothing and made edits to
  // that list silently ineffective. The list this replaces is in git history
  // (removed in the commit that added this comment) should anyone ever want to
  // switch the role to is_admin: false and grant permissions explicitly.
  $roles['mukurtu_roundtrip_manager'] = [
    'access content overview',
    'access media overview',
    'access mukurtu import',
    'create mukurtu_import_strategy',
    'edit own mukurtu_import_strategy',
    'delete own mukurtu_import_strategy',
  ];
  $roles['mukurtu_bulk_editor'] = [
    'use mukurtu bulk edit',
  ];
  foreach ($roles as $role_name => $permissions) {
    $role = Role::load($role_name);
    // ConfigInstaller silently drops config whose dependencies are unmet, so a
    // role this profile ships can go missing without any error being raised.
    // Skip rather than fataling the install on a method call against NULL.
    if (!$role) {
      continue;
    }
    foreach ($permissions as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }

  // Add community record and multipage item fields to the default content
  // index. These cannot be declared in mukurtu_browse's index YAML because
  // they depend on modules that install after browse, and their hook_install
  // implementations fire before the index is created (the index has its own
  // cross-module config dependencies). By this point all modules are installed
  // and the index exists.
  $index = \Drupal\search_api\Entity\Index::load('mukurtu_default_content_index');
  if ($index) {
    $index_changed = FALSE;
    $processors = $index->getProcessors();

    if (!isset($processors['mukurtu_community_record_flag'])) {
      $processor = \Drupal::service('plugin.manager.search_api.processor')
        ->createInstance('mukurtu_community_record_flag', ['#index' => $index]);
      $processors['mukurtu_community_record_flag'] = $processor;
      $index->setProcessors($processors);
      $index_changed = TRUE;
    }

    if (!$index->getField('is_community_record')) {
      $field = new \Drupal\search_api\Item\Field($index, 'is_community_record');
      $field->setType('boolean');
      $field->setPropertyPath('is_community_record');
      $field->setDatasourceId('entity:node');
      $field->setLabel('Is community record');
      $index->addField($field);
      $index_changed = TRUE;
    }

    $processors = $index->getProcessors();
    if (!isset($processors['mukurtu_multipage_page_index'])) {
      $processor = \Drupal::service('plugin.manager.search_api.processor')
        ->createInstance('mukurtu_multipage_page_index', ['#index' => $index]);
      $processors['mukurtu_multipage_page_index'] = $processor;
      $index->setProcessors($processors);
      $index_changed = TRUE;
    }

    if (!$index->getField('is_additional_mpi_page')) {
      $field = new \Drupal\search_api\Item\Field($index, 'is_additional_mpi_page');
      $field->setType('boolean');
      $field->setPropertyPath('is_additional_mpi_page');
      $field->setDatasourceId('entity:node');
      $field->setLabel('Is additional multipage item page');
      $index->addField($field);
      $index_changed = TRUE;
    }

    if ($index_changed) {
      $index->save();
      $index->reindex();
    }
  }

  // function mukurtu_create_default_blocks() {
  //   $block_content = BlockContent::create([
  //     'type' => 'image_with_description',
  //     'info' => t('Hero Image and Site Description'),
  //     'region' => 'content',
  //     'weight' => 2,
  //     'theme' => 'mukurtu_v4',
  //   ]);
  //   $block_content->save();
  //   $block = Block::create([
  //     'id' => 'heroimageandsitedescription',
  //     'settings' => [
  //       'id' => 'block_content:' . $block_content->uuid(),
  //       'label' => t('Hero Image and Site Description'),
  //       'label_display' => 0,
  //       'provider' => 'block_content',
  //       'status' => 1,
  //     ],
  //     'region' => 'content',
  //     'plugin' => 'block_content:' . $block_content->uuid(),
  //     'theme' => 'mukurtu_v4',
  //     'weight' => 4,
  //   ]);
  //   $block->setRegion('content');
  //   $visibility = $block->getVisibility();
  //   $visibility['request_path']['pages'] = '<front>';
  //   $block->setVisibilityConfig('request_path', $visibility['request_path']);
  //   $block = Block::load('heroimageandsitedescription');
  //   $block->setRegion('content');
  //   $block->setStatus(TRUE);
  //   $block->setWeight(4);
  //   $block->save();
  // }

  // Disable the core media view so Mukurtu's view is the sole handler at
  // /admin/content/media.
  $config = \Drupal::configFactory()->getEditable('views.view.media');
  if (!$config->isNew()) {
    $config->set('status', FALSE)->save();
  }

  // Enable "Open external links in a new window or tab" by default.
  // extlink ships this disabled; the profile's hook_install() is guaranteed
  // to run after extlink is installed, so this reliably overrides its
  // default for new installs.
  \Drupal::configFactory()->getEditable('extlink.settings')
    ->set('extlink_target', TRUE)
    ->save();

  // Serve Chart.js from the copy the profile ships in libraries/ rather than
  // unpkg.com. charts ships with its CDN option on, which rewrites the
  // library paths to unpkg.com and makes the status report warn about it.
  // @see \Drupal\mukurtu_core\Hook\ChartsLibraryHooks
  \Drupal::configFactory()->getEditable('charts.settings')
    ->set('advanced.requirements.cdn', FALSE)
    ->save();

  // Protect the feedback contact form and comment form with a CAPTCHA point.
  // Created here (rather than in mukurtu_bot_protection's own config/install)
  // because contact.form.feedback and comment.type.comment are not owned by
  // mukurtu_bot_protection, and the profile's own hook_install() is
  // guaranteed to run after every module (and the profile's own config) is
  // fully installed.
  foreach (['contact_message_feedback_form', 'comment_comment_form'] as $form_id) {
    if (!CaptchaPoint::load($form_id)) {
      CaptchaPoint::create([
        'formId' => $form_id,
        'captchaType' => 'default',
        'label' => $form_id,
        'status' => TRUE,
      ])->save();
    }
  }

}

/**
 * Implements hook_update_last_removed().
 *
 * Every mukurtu update hook was removed in 4.0.1. 40029 is the
 * highest number 4.0.0 shipped, so a fresh install is seeded there and a site
 * that already ran the 4.0.0 updates has nothing left to do.
 *
 * Sites below 4.0.0 must update to 4.0.0 first. Core reports that as an error
 * during the update, and mukurtu_core_update_requirements() adds a message
 * naming 4.0.0 specifically. Note that neither actually halts `drush updb -y`,
 * which prompts and proceeds; see docs/update-hooks.md.
 */
function mukurtu_update_last_removed(): int {
  return 40029;
}

/**
 * Default new full-background hero blocks to dark text so they stay legible.
 */
function mukurtu_update_40030(): string {
  $name = 'field.field.block_content.full_image_with_description.field_text_color';
  $config = \Drupal::configFactory()->getEditable($name);

  if ($config->isNew()) {
    return (string) t('The full-background hero block is not installed on this site; nothing to change.');
  }

  // The image on this bundle is optional, so a block created with only a title
  // rendered white text on the white page background - 1:1 contrast, a WCAG
  // 1.4.3 failure produced by the shipped default rather than by anything the
  // author did. Dark is legible on the bare background and remains a sensible
  // starting point over a light image.
  //
  // Only rewrite the value this profile shipped. A site that deliberately set
  // its own default keeps it, and existing blocks are never touched - their
  // stored value is the author's choice.
  if ($config->get('default_value') !== [['value' => 'light']]) {
    return (string) t('The full-background hero text colour default has already been changed; leaving it alone.');
  }

  $config->set('default_value', [['value' => 'dark']])->save();

  return (string) t('New full-background hero blocks now default to dark text.');
}

/**
 * Remove an obsolete performance setting that Drupal core no longer uses.
 */
function mukurtu_update_40031(): string {
  $config = \Drupal::configFactory()->getEditable('system.performance');

  // The profile shipped stale_file_threshold after Drupal 11.4 core dropped it
  // from the system.performance schema, so every site installed since 4.0.0
  // carries a key with no schema. Strict schema checking rejects it.
  if ($config->get('stale_file_threshold') === NULL) {
    return (string) t('The obsolete stale_file_threshold performance setting is not present; nothing to change.');
  }

  $config->clear('stale_file_threshold')->save();

  return (string) t('Removed the obsolete stale_file_threshold performance setting.');
}

/**
 * Add the Background option for hero blocks that have no image.
 */
function mukurtu_update_40032(): string {
  $storage_name = 'field.storage.block_content.field_hero_background';
  $field_name = 'field.field.block_content.full_image_with_description.field_hero_background';

  if (\Drupal::configFactory()->get('block_content.type.full_image_with_description')->isNew()) {
    return (string) t('The full-background hero block is not installed on this site; nothing to change.');
  }

  if (\Drupal::entityTypeManager()->getStorage('field_config')->load('block_content.full_image_with_description.field_hero_background')) {
    return (string) t('The hero Background option is already present.');
  }

  // Import the shipped definitions rather than rebuilding them here, so the
  // update and a fresh install cannot drift apart.
  $source = new \Drupal\Core\Config\FileStorage(\Drupal::service('extension.list.profile')->getPath('mukurtu') . '/config/install');

  // config/install states allowed_values in the documented [{value, label}]
  // form, but FieldStorageConfig stores the older value-keyed map, and saving
  // an entity casts against the stored shape. Installing config never hits
  // this because the installer writes trusted data and skips the cast. Convert
  // here rather than changing the YAML, so the shipped file stays canonical.
  $storage_data = $source->read($storage_name);
  $storage_data['settings']['allowed_values'] = array_column(
    $storage_data['settings']['allowed_values'], 'label', 'value'
  );

  \Drupal\field\Entity\FieldStorageConfig::create($storage_data)->save();
  \Drupal\field\Entity\FieldConfig::create($source->read($field_name))->save();

  // Surface it on the form, and render it so the template can read it.
  foreach ([
    'core.entity_form_display.block_content.full_image_with_description.default' => ['type' => 'options_select', 'weight' => 30],
    'core.entity_view_display.block_content.full_image_with_description.default' => ['type' => 'list_key', 'label' => 'hidden', 'weight' => 4],
  ] as $display_id => $component) {
    $display = \Drupal::configFactory()->getEditable($display_id);
    if ($display->isNew()) {
      continue;
    }
    $content = $display->get('content') ?? [];
    $content['field_hero_background'] = $component + ['region' => 'content', 'settings' => [], 'third_party_settings' => []];
    $dependencies = $display->get('dependencies.config') ?? [];
    $dependencies[] = $field_name;
    sort($dependencies);
    $display
      ->set('content', $content)
      ->set('dependencies.config', array_values(array_unique($dependencies)))
      ->save();
  }

  return (string) t('Added the Background option to the full-background hero block. Existing blocks keep their current appearance.');
}

/**
 * Add the Display style field to Featured Content blocks.
 */
function mukurtu_update_40033(): string {
  $messages = [];

  // The config/install copy writes allowed_values as a list of value/label
  // pairs, which is what the config schema expects. FieldStorageConfig stores
  // the same data as a value-keyed map and casts on save, so passing the
  // config/install shape here throws. The two are not interchangeable; see
  // docs/update-hooks.md.
  if (!FieldStorageConfig::loadByName('block_content', 'field_display_style')) {
    FieldStorageConfig::create([
      'field_name' => 'field_display_style',
      'entity_type' => 'block_content',
      'type' => 'list_string',
      'cardinality' => 1,
      'translatable' => TRUE,
      'settings' => [
        'allowed_values' => [
          'grid' => 'Grid',
          'carousel' => 'Carousel',
        ],
        'allowed_values_function' => '',
      ],
    ])->save();
    $messages[] = 'created the field_display_style storage';
  }

  if (!FieldConfig::loadByName('block_content', 'featured_content', 'field_display_style')) {
    FieldConfig::create([
      'field_name' => 'field_display_style',
      'entity_type' => 'block_content',
      'bundle' => 'featured_content',
      'label' => 'Display style',
      'description' => 'Choose how featured items are arranged.',
      'required' => TRUE,
      'translatable' => FALSE,
      // Existing blocks keep rendering exactly as they do now. Only a site
      // that deliberately switches a block over gets the carousel.
      'default_value' => [['value' => 'grid']],
    ])->save();
    $messages[] = 'added Display style to Featured Content';
  }

  // Existing blocks have no value for a field that did not exist when they
  // were saved, and an empty required list field renders nothing rather than
  // falling back to the default. Backfill so they stay grids.
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'featured_content')
    ->notExists('field_display_style')
    ->execute();
  if ($ids) {
    foreach ($storage->loadMultiple($ids) as $block) {
      $block->set('field_display_style', 'grid');
      $block->save();
    }
    $messages[] = sprintf('set %d existing block(s) to Grid', count($ids));
  }

  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('block_content.featured_content.default');
  if ($form_display && !$form_display->getComponent('field_display_style')) {
    $form_display->setComponent('field_display_style', [
      'type' => 'options_buttons',
      'weight' => 2,
      'region' => 'content',
    ])->save();
    $messages[] = 'showed the field on the block form';
  }

  // The value drives the wrapper markup, so it must not also render as a
  // field inside the block.
  $view_display = \Drupal::entityTypeManager()
    ->getStorage('entity_view_display')
    ->load('block_content.featured_content.default');
  if ($view_display && $view_display->getComponent('field_display_style')) {
    $view_display->removeComponent('field_display_style')->save();
    $messages[] = 'hid the field from the block display';
  }

  return $messages ? ucfirst(implode('; ', $messages)) . '.' : 'Display style was already present; nothing to do.';
}

/**
 * Add the Bulk Editor role and let Mukurtu Managers use bulk editing.
 */
function mukurtu_update_40035(): string {
  $messages = [];

  if (!Role::load('mukurtu_bulk_editor')) {
    // Import the shipped role rather than rebuilding it here, so the update
    // and a fresh install can't drift apart.
    $source = new FileStorage(\Drupal::service('extension.list.profile')->getPath('mukurtu') . '/config/install');
    Role::create($source->read('user.role.mukurtu_bulk_editor'))->save();
    $messages[] = (string) t('Added the Bulk Editor role.');
  }

  $manager = Role::load('mukurtu_manager');
  if ($manager && !$manager->hasPermission('use mukurtu bulk edit')) {
    $manager->grantPermission('use mukurtu bulk edit')->save();
    $messages[] = (string) t('Mukurtu Managers can now use bulk editing.');
  }

  return $messages ? implode(' ', $messages) : (string) t('The Bulk Editor role and permission are already in place; nothing to change.');
}

/**
 * Add the bulk edit page, one tab per content type.
 */
function mukurtu_update_40036(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('view');
  if ($storage->load('mukurtu_bulk_edit_content')) {
    return (string) t('The bulk edit page is already installed; nothing to change.');
  }

  // Import the shipped view rather than rebuilding it here, so the update
  // and a fresh install can't drift apart.
  $source = new FileStorage(\Drupal::service('extension.list.profile')->getPath('mukurtu') . '/config/install');
  $storage->create($source->read('views.view.mukurtu_bulk_edit_content'))->save();
  return (string) t('Added the bulk edit page.');
}

/**
 * Turn on bulk field editing for the bulk edit page.
 */
function mukurtu_update_40037(): string {
  $messages = [];

  if (!\Drupal::moduleHandler()->moduleExists('views_bulk_edit')) {
    \Drupal::service('module_installer')->install(['views_bulk_edit']);
    $messages[] = (string) t('Enabled Views Bulk Edit.');
  }

  // The form mode, then each content type's bulk_edit form, from the module
  // that ships it. Sites that already have one keep theirs.
  $extensions = \Drupal::service('extension.list.module');
  $displays = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  $modes = \Drupal::entityTypeManager()->getStorage('entity_form_mode');
  if (!$modes->load('node.bulk_edit')) {
    $source = new FileStorage($extensions->getPath('mukurtu_core') . '/config/install');
    $modes->create($source->read('core.entity_form_mode.node.bulk_edit'))->save();
  }
  $added = [];
  foreach ([
    'digital_heritage' => 'mukurtu_digital_heritage',
    'dictionary_word' => 'mukurtu_dictionary',
    'word_list' => 'mukurtu_dictionary',
    'collection' => 'mukurtu_collection',
    'person' => 'mukurtu_person',
    'place' => 'mukurtu_place',
  ] as $type => $module) {
    if ($displays->load("node.$type.bulk_edit") || !\Drupal::moduleHandler()->moduleExists($module) || !NodeType::load($type)) {
      continue;
    }
    $source = new FileStorage($extensions->getPath($module) . '/config/install');
    $displays->create($source->read("core.entity_form_display.node.$type.bulk_edit"))->save();
    $added[] = $type;
  }
  if ($added) {
    $messages[] = (string) t('Added bulk edit forms for @types.', ['@types' => implode(', ', $added)]);
  }

  // Offer the action on the bulk edit page, keeping any site changes.
  $config = \Drupal::configFactory()->getEditable('views.view.mukurtu_bulk_edit_content');
  $path = 'display.default.display_options.fields.views_bulk_operations_bulk_form.selected_actions';
  $actions = $config->get($path);
  if (is_array($actions) && !in_array('views_bulk_edit', array_column($actions, 'action_id'), TRUE)) {
    $actions[$actions ? max(array_keys($actions)) + 1 : 0] = [
      'action_id' => 'views_bulk_edit',
      'preconfiguration' => ['add_confirmation' => TRUE],
    ];
    $config->set($path, $actions)->save();
    $messages[] = (string) t('Added field editing to the bulk edit page.');
  }

  return $messages ? implode(' ', $messages) : (string) t('Bulk field editing is already set up; nothing to change.');
}
