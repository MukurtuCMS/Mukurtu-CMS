{#
/**
 * @file
 * Theme override for status messages.
 *
 * Displays status, error, and warning messages, grouped by type.
 *
 * A heading and an icon identify each message's severity, so it is not
 * carried by colour alone (WCAG 1.4.1). The heading is visible: it used to
 * be .visually-hidden, which left a sighted reader with nothing but the box
 * colour to tell an error from a confirmation.
 *
 * Add an ARIA label to the contentinfo area so that assistive technology
 * user agents will better describe this landmark.
 *
 * Available variables:
 * - message_list: List of messages to be displayed, grouped by type.
 * - status_headings: List of all status types.
 * - attributes: HTML attributes for the element, including:
 *   - class: HTML classes.
 */
#}
{{ attach_library('mukurtu_v4/messages') }}
<div data-drupal-messages class="messages-list">
  <div class="messages__wrapper layout-container">
    {% for type, messages in message_list %}
      {%
        set classes = [
        'messages-list__item',
        'messages',
        'messages--' ~ type,
      ]
      %}

      <div{{ attributes
        .addClass(classes)
        .setAttribute('data-drupal-selector', 'messages')
        .setAttribute('role', 'contentinfo')
        .setAttribute('aria-label', status_headings[type])
        }}>
        <div class="messages__container" data-drupal-selector="messages-container"{% if type == 'error' %} role="alert"{% endif %}>
          {% if status_headings[type] %}
            {#
              Severity is carried by an icon and a visible heading as well as
              by colour, so it does not depend on telling the three hues apart
              (WCAG 1.4.1, issue #2421). The shapes match the ones Claro
              already draws on administrative pages.

              The icon is decorative: the heading beside it says the same
              thing in words, so announcing both would be repetition.

              currentColor rather than a fixed hue, so each icon inherits its
              message type's text colour and survives forced-colors mode. The
              dismiss button below does the same.
            #}
            <div class="messages__header">
              <div class="messages__icon">
                {% if type == 'error' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 11.193L11.45 3" stroke="currentColor" stroke-width="2"/></svg>
                {% elseif type == 'warning' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 4 14" fill="currentColor" aria-hidden="true" focusable="false"><path d="M.5 0h3v9h-3z"/><circle cx="2" cy="12.5" r="1.5"/></svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 13" aria-hidden="true" focusable="false"><path d="M2 6.571L5.6 10 14 2" fill="none" stroke="currentColor" stroke-width="3"/></svg>
                {% endif %}
              </div>
              <h2 class="messages__title">{{ status_headings[type] }}</h2>
            </div>
          {% endif %}
          <div class="messages__content">
            {% if messages|length > 1 %}
              <ul class="messages__list">
                {% for message in messages %}
                  <li class="messages__item">{{ message }}</li>
                {% endfor %}
              </ul>
            {% else %}
              {{ messages|first }}
            {% endif %}
          </div>
        </div>
        <button type="button" class="messages__close" data-drupal-selector="messages-close">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="visually-hidden">{{ 'Dismiss message'|t }}</span>
        </button>
      </div>
      {# Remove type specific classes. #}
      {% set attributes = attributes.removeClass(classes) %}
    {% endfor %}
  </div>
</div>
