{#
/**
 * @file
 * Shared "copy citation" icon button, visual feedback, and status region.
 *
 * Included by field templates that offer copy-to-clipboard for citation
 * text. The including field wrapper must carry data-copy-citation-field and
 * contain a [data-citation-text] element. See js/copy-citation.js.
 *
 * Variables:
 * - button_label: Translated accessible name for the icon-only button.
 * - success_message: Translated message announced after a successful copy.
 */
#}
<span class="citation-copy-controls">
  <span class="citation-copy-feedback" aria-hidden="true">{{ 'Copied!'|t }}</span>
  <button type="button" class="button button--copy-icon" data-copy-citation data-copy-success="{{ success_message }}" aria-label="{{ button_label }}">
    <svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" width="16" height="18" aria-hidden="true"><path d="M11 0H3a1 1 0 0 0-1 1v1H1a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1h1a1 1 0 0 0 1-1V1a1 1 0 0 0-1-1zM10 17H1V3h1v12a1 1 0 0 0 1 1h7v1zm2-2H3V2h8v13z"/></svg>
  </button>
</span>
<div class="visually-hidden" role="status" aria-live="polite" data-copy-citation-status></div>
