{#
/**
 * @file
 * Theme override to display a block.
 *
 * Available variables:
 * - plugin_id: The ID of the block implementation.
 * - label: The configured label of the block if visible.
 * - configuration: A list of the block's configuration values.
 *   - label: The configured label for the block.
 *   - label_display: The display settings for the label.
 *   - provider: The module or other provider that provided this block plugin.
 *   - Block plugin specific settings will also be stored here.
 * - in_preview: Whether the plugin is being rendered in preview mode.
 * - content: The content of this block.
 * - attributes: array of HTML attributes populated by modules, intended to
 *   be added to the main container tag of this template.
 *   - id: A valid HTML ID and guaranteed unique.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 *
 * @see template_preprocess_block()
 */
#}

{# The tint is on unless an editor has explicitly turned it off, so blocks
   saved before field_image_tint existed keep the look they always had. #}
{% set block_content = content['#block_content'] ?? null %}
{% set tint_off = block_content
  and block_content.hasField('field_image_tint')
  and not block_content.field_image_tint.isEmpty()
  and not block_content.field_image_tint.value %}

{#
  Test the rendered field rather than the entity reference. Twig's sandbox
  restricts entity access, and an empty reference list does not report itself
  as empty the way it reads. No striptags here - an image renders as <img>
  with no text content, which striptags would flatten to nothing.
#}
{% set has_image = content.field_image|render|trim is not empty %}

{#
  With an image the image is the background and field_text_color decides the
  text treatment over it. With no image there is nothing to contrast against -
  "Light" would be white on the white page - so field_hero_background picks a
  ground instead and the text colour follows from it in _image-w-description.scss.
  The tint only applies over an image.
#}
{% set attributes = attributes.addClass([
  'block-wrapper',
  'block--image-with-description',
  'block--image-with-description--full',
  has_image
    ? 'text-' ~ content.field_text_color|render|striptags|trim
    : 'block--image-with-description--no-image',
  has_image
    ? ''
    : 'hero-ground-' ~ content.field_hero_background|render|striptags|trim,
  has_image and not tint_off ? 'block--image-with-description--tinted' : null,
]) %}

<div{{ attributes }}>
  <div class="block-wrapper__first">
    {{content.field_image}}
  </div>

  <div class="block-wrapper__second">
    <div class="block-wrapper__second-card">
      {{ title_prefix }}
      {% if label %}
        <h2{{ title_attributes }}>{{ label }}</h2>
      {% endif %}
      {{ title_suffix }}
      {{content.body}}
    </div>
  </div>
</div>
