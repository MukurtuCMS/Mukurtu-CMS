{#
/**
 * @file
 * Theme override for the field_citation field.
 *
 * Adds a "Copy citation" icon button to the label row, plus an aria-live
 * status region, so users can copy the plain-text citation (including the
 * record URL) to the clipboard. See templates/misc/copy-citation-button.html.twig,
 * js/copy-citation.js and mukurtu_v4.libraries.yml (copy-citation library).
 *
 * Available variables: see field.html.twig.
 */
#}
{%
  set classes = [
    'field',
    'field--name-' ~ field_name|clean_class,
    'field--type-' ~ field_type|clean_class,
    'field--label-' ~ label_display,
  ]
%}
{%
  set title_classes = [
    'field__label',
    label_display == 'visually_hidden' ? 'visually-hidden',
  ]
%}

{{ attach_library('mukurtu_v4/copy-citation') }}

<div{{ attributes.addClass(classes).setAttribute('data-copy-citation-field', '') }}>
  <div class="field__label-row">
    {% if not label_hidden %}
      <div{{ title_attributes.addClass(title_classes) }}>{{ label }}</div>
    {% endif %}
    {% include '@mukurtu_v4/templates/misc/copy-citation-button.html.twig' with {
      button_label: 'Copy citation'|t,
      success_message: 'Citation copied to clipboard'|t,
    } only %}
  </div>
  {% for item in items %}
    <div{{ item.attributes.addClass('field__item') }}>
      <div class="citation-text" data-citation-text>{{ item.content }}</div>
    </div>
  {% endfor %}
</div>
