# Settings for docker-compose.yml. ./generate-secrets.sh copies this file to .env and fills
# in the empty passwords with random values; edit the rest. The defaults are for trying it
# on your own machine.

# The published image. 4.0 follows the newest 4.0.x image, which suits a first try. For a
# production site, pin an exact tag (such as 4.0.8-r1) and upgrade on purpose.
MUKURTU_IMAGE=ghcr.io/mukurtucms/mukurtu:4.0

# Where Let's Encrypt can reach you (used when the domains are real).
ACME_EMAIL=ops@example.org

# The host ports Caddy listens on. 8088 and 8443 need no privileges; use 80 and 443 for a
# real deployment.
HTTP_PORT=8088
HTTPS_PORT=8443

# The domains, one per site. a.localhost and b.localhost resolve to your own machine.
SITE_A_HOST=a.localhost
SITE_B_HOST=b.localhost

# Passwords: leave empty, ./generate-secrets.sh fills them in.
DB_ROOT_PASSWORD=
SITE_A_DB_PASSWORD=
SITE_B_DB_PASSWORD=
SITE_A_ADMIN_PASSWORD=
SITE_B_ADMIN_PASSWORD=

# Each site's first administrator (used once, at install).
SITE_A_ADMIN_EMAIL=a@example.org
SITE_B_ADMIN_EMAIL=b@example.org

# The largest upload on each site, and the room it needs. An upload is held in temporary space twice, so
# MUKURTU_TMP_SIZE must be at least double MUKURTU_UPLOAD_MAX, and that space counts against
# MUKURTU_MEM_LIMIT. For 500 MB uploads use 500M, 1g and 2g. Run docker compose up -d to
# apply a change. MUKURTU_MEM_LIMIT applies to each site, so check the host has room.
MUKURTU_UPLOAD_MAX=100M
MUKURTU_TMP_SIZE=256m
MUKURTU_MEM_LIMIT=1g
