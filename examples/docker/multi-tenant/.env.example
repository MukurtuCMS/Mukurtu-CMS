# Settings for docker-compose.yml. ./generate-secrets.sh copies this file to .env and fills
# in the empty passwords with random values; edit the rest. The defaults are for trying it
# on your own machine.

# The published image. Pin an exact version (not "latest") and upgrade on purpose.
MUKURTU_IMAGE=ghcr.io/cbenning/mukurtu:4.0.5-rc3

# Where Let's Encrypt can reach you (used when the domains are real).
ACME_EMAIL=ops@example.org

# The host ports Caddy listens on. 8088 and 8443 need no privileges; use 80 and 443 for a
# real deployment.
HTTP_PORT=8088
HTTPS_PORT=8443

# The domains, one per site. a.localhost and b.localhost resolve to your own machine.
SITE_A_HOST=a.localhost
SITE_B_HOST=b.localhost

# Passwords: leave empty, ./generate-secrets.sh fills them in.
DB_ROOT_PASSWORD=
SITE_A_DB_PASSWORD=
SITE_B_DB_PASSWORD=
SITE_A_ADMIN_PASSWORD=
SITE_B_ADMIN_PASSWORD=

# Each site's first administrator (used once, at install).
SITE_A_ADMIN_EMAIL=a@example.org
SITE_B_ADMIN_EMAIL=b@example.org
