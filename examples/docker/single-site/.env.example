# Settings for docker-compose.yml. ./generate-secrets.sh copies this file to .env; edit
# the copy. The defaults are for trying it on your own machine.

# The published image. 4.0 follows the newest 4.0.x image, which suits a first try. For a
# production site, pin an exact tag (such as 4.0.8-r1) and upgrade on purpose.
MUKURTU_IMAGE=ghcr.io/mukurtucms/mukurtu:4.0

# The name the site is served on. localhost is for a local try (open
# http://localhost:8080). For a real site use its domain, behind a reverse proxy that
# provides HTTPS.
MUKURTU_HOST=localhost

# The first administrator's email address (used once, at install).
MUKURTU_ADMIN_EMAIL=admin@example.org
